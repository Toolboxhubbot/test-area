        local ok = true
        for i = 2, #path do
            cur = cur and cur:FindFirstChild(path[i])
            if not cur then ok = false break end
        end
        if ok and cur and (cur:IsA("RemoteEvent") or cur:IsA("RemoteFunction")) then return cur end
    end
    return nil
end
local function getTargetPart()
    local murd = getMurd()
    if not murd or not murd.Character then return nil end
    return murd.Character:FindFirstChild("Head") or murd.Character:FindFirstChild("HumanoidRootPart")
end
local function hasClearShot(targetPart)
    if not state.silentAimWallCheck then return true end
    if not targetPart then return true end
    local cam = Workspace.CurrentCamera
    if not cam then return true end
    local rp = RaycastParams.new()
    local ignore = {}
    if LP.Character then table.insert(ignore, LP.Character) end
    if targetPart.Parent then table.insert(ignore, targetPart.Parent) end
    rp.FilterDescendantsInstances = ignore
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local res = Workspace:Raycast(cam.CFrame.Position, targetPart.Position - cam.CFrame.Position, rp)
    return res == nil
end

RunService.RenderStepped:Connect(function()
    if not state.silentAimEnabled then silentAimTarget = nil; silentAimHead = nil; return end
    local murd = getMurd()
    if murd and murd.Character then
        local part = murd.Character:FindFirstChild("Head") or murd.Character:FindFirstChild("HumanoidRootPart")
        if part then silentAimTarget = murd; silentAimHead = part.Position; return end
    end
    silentAimTarget = nil; silentAimHead = nil
end)

local function fireSilentAtMurderer()
    if not canFire() then return false end
    local part = getTargetPart()
    if not part then return false end
    if not state.shootThroughWall and not hasClearShot(part) then return false end
    lastShotTime = tick()
    local remote = findShootRemote()
    if not remote then return false end
    local targetCF = part.CFrame
    local aimCF = CFrame.new(part.Position + Vector3.new(0, 1.5, 0))
    local originCF = Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame or targetCF
    pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(originCF, targetCF)
            remote:FireServer(aimCF, targetCF)
            remote:FireServer(targetCF)
        else
            remote:InvokeServer(originCF, targetCF)
        end
    end)
    return true
end
local function fireThroughWall()
    if not canFire() then return false end
    local murd = getMurd()
    if not murd or not murd.Character then return false end
    local root = murd.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local remote = findShootRemote()
    if not remote then return false end
    lastShotTime = tick()
    local targetCF = root.CFrame
    local originCF = CFrame.new(targetCF.Position + Vector3.new(0, 3, 0))
    pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(originCF, targetCF)
            remote:FireServer(targetCF)
        elseif remote:IsA("RemoteFunction") then
            remote:InvokeServer(originCF, targetCF)
        end
    end)
    return true
end
local function tryShootMurderer()
    if state.shootThroughWall then return fireThroughWall() else return fireSilentAtMurderer() end
end
local function fullShootSequence() return tryShootMurderer() end

