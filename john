        local ia = (nm == n)
        local txtCol
        if nm == SECRET_NAME then txtCol = Color3.fromRGB(0,0,0)
        else txtCol = ia and cc3(settingsConfig.tabTextActiveColor) or cc3(settingsConfig.tabTextColor) end
        TweenService:Create(b, TweenInfo.new(0.32, EASE_SMOOTH), {BackgroundTransparency = ia and 0 or 1, BackgroundColor3 = ia and cc3(settingsConfig.cardHoverColor) or cc3(settingsConfig.tabBgColor), TextColor3 = txtCol}):Play()
    end
    if pageGs[o] then
        local op = pages[o]
        TweenService:Create(op, TweenInfo.new(0.24, EASE_BOUNCE, EASE_IN), {Position=UDim2.new(-0.12,0,0,0)}):Play()
        task.delay(0.24, function() if pageGs[o] then pageGs[o].Visible = false op.Position = UDim2.new(0,0,0,0) end end)
    end
    if pageGs[n] then
        pageGs[n].Visible = true
        local np = pages[n]
        np.Position = UDim2.new(0.12,0,0,0)
        TweenService:Create(np, TweenInfo.new(0.45, EASE_BOUNCE, EASE_OUT), {Position=UDim2.new(0,0,0,0)}):Play()
