local function defaultPositionForIndex(i)
    local vpW = (Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize.X) or 1920
    local cell = state.floatButtonSize + 10
    local perRow = math.max(1, math.floor((vpW - 20) / cell))
    local col = (i - 1) % perRow
    local row = math.floor((i - 1) / perRow)
    return {xScale = 0, xOffset = 10 + col * cell, yScale = 0, yOffset = START_Y_OFFSET + row * cell}
end

local function refreshFloatVisual(def)
