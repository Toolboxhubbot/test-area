                            hl.Name = "AW_ESP_HL_" .. p.UserId
                            hl.FillColor = col
                            hl.FillTransparency = 0.5
                            hl.OutlineColor = col
                            hl.OutlineTransparency = 0
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Parent = espF
                            hl.Adornee = ch
                            local bb = Instance.new("BillboardGui")
                            bb.Name = "AW_ESP_BB_" .. p.UserId
                            bb.Size = UDim2.new(0, 220, 0, 44)
                            bb.StudsOffset = Vector3.new(0, 4, 0)
                            bb.AlwaysOnTop = true
                            bb.MaxDistance = 2000
                            bb.Parent = espF
                            bb.Adornee = head
                            local tx = Instance.new("TextLabel")
                            tx.Size = UDim2.new(1, 0, 1, 0)
                            tx.BackgroundTransparency = 1
                            tx.Text = p.Name .. "\n[" .. role .. "]"
                            tx.TextColor3 = col
                            tx.TextStrokeTransparency = 0
                            tx.TextStrokeColor3 = Color3.new(0, 0, 0)
                            tx.Font = Enum.Font.GothamBold
                            tx.TextSize = 14
                            tx.Parent = bb
                            espCache[p] = {hl = hl, bb = bb, tx = tx}
                        else
                            e.hl.FillColor = col
                            e.hl.OutlineColor = col
                            if e.tx then
                                e.tx.Text = p.Name .. "\n[" .. role .. "]"
                                e.tx.TextColor3 = col
                            end
                            e.hl.Adornee = ch
                            e.bb.Adornee = head
                        end
                    else
                        if espCache[p] then clearESP(p) end
                    end
                end
            end
            for p, _ in pairs(espCache) do
                if not p or not p.Parent then clearESP(p) end
            end
        end
        if state.espGunDrop then
            for _, v in pairs(Workspace:GetDescendants()) do
                if v.Name == "GunDrop" and v:IsA("BasePart") and not gunDropCache[v] then
                    local hl = Instance.new("Highlight")
                    hl.FillColor = Color3.fromRGB(255, 255, 0)
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.fromRGB(255, 255, 0)
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = espF
                    hl.Adornee = v
                    gunDropCache[v] = hl
                end
            end
            for k, v in pairs(gunDropCache) do
                if not k.Parent or not v.Parent then
                    pcall(function() v:Destroy() end)
                    gunDropCache[k] = nil
                end
            end
        else
            clearGunDropESP()
        end
    end
end)

