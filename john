    end
    local function switchTab(n)
        if switching or n == currentTabName then return end
        switching = true
        local o = currentTabName; currentTabName = n
        for nm, b in pairs(btns) do
            local ia = (nm == n)
            local iSec = (nm == "Secret")
            local tc
            if iSec then tc = ia and TEXT or SECRET_BLACK else tc = ia and TEXT or TEXT_DIM end
            TweenService:Create(b, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {BackgroundTransparency=ia and 0 or 1, BackgroundColor3=ia and Color3.fromRGB(22,22,22) or Color3.fromRGB(0,0,0), TextColor3=tc}):Play()
            for _, ch in ipairs(b:GetChildren()) do if ch:IsA("Frame") and ch.Name == "Indicator" then ch.Visible = ia end end
        end
        if btns[n] then moveSI(btns[n]) end
        local og = pageGroups[o]; local ng = pageGroups[n]; local op = pages[o]; local np = pages[n]
        if og and op then
            TweenService:Create(op, TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Position=UDim2.new(-0.12,0,0,0)}):Play()
            task.delay(0.24, function() if og and currentTabName ~= o then og.Visible = false; op.Position = UDim2.new(0,0,0,0) end end)
        end
        if ng and np then
            ng.Visible = true
            np.Position = UDim2.new(0.12,0,0,0); np.Size = UDim2.new(0.9,0,1,0)
            TweenService:Create(np, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position=UDim2.new(0,0,0,0), Size=UDim2.new(1,0,1,0)}):Play()
            task.spawn(function() task.wait(0.08); staggerFadeIn(np) end)
        end
        task.delay(0.4, function() switching = false end)
    end
