        fields = fields or {},
        footer = {text = "Appleware • " .. os.date("%H:%M:%S")},
        timestamp = DateTime.now():ToIsoDate()
    }
    local data = {
        content = ping ~= "" and (ping .. " Status:") or nil,
        username = "Appleware",
        embeds = {embed},
        allowed_mentions = {parse = {"users"}}
    }
    pcall(function()
        if httpRequest then
            httpRequest({
                Url = settingsConfig.webhookUrl,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(data)
            })
        end
    end)
