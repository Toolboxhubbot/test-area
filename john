local function isBarrierPart(obj)
    if not obj:IsA("BasePart") then return false end
    if obj == LP.Character then return false end
    if LP.Character and obj:IsDescendantOf(LP.Character) then return false end

    local name = string.lower(obj.Name)

    if string.find(name, "glitchproof", 1, true)
        or string.find(name, "glitch_proof", 1, true)
        or string.find(name, "glitch proof", 1, true) then
        return true
    end

    if string.find(name, "kill", 1, true) then
        return true
    end

    local anc = obj.Parent
    local depth = 0
    while anc and anc ~= Workspace and depth < 4 do
        local an = string.lower(anc.Name)
        if string.find(an, "killbrick", 1, true)
            or string.find(an, "kill_brick", 1, true)
            or string.find(an, "kill brick", 1, true)
            or string.find(an, "killzone", 1, true)
            or string.find(an, "kill_zone", 1, true)
            or string.find(an, "kill zone", 1, true) then
            return true
        end
        anc = anc.Parent
        depth = depth + 1
    end

    return false
end

local function removeGlitchProofParents()
    local count = 0
    local bases = {}
    for _, top in ipairs(Workspace:GetChildren()) do
        local tn = string.lower(top.Name)
        if tn == "map" or tn == "lobby" then
            local base = top:FindFirstChild("Base")
            if base then
                table.insert(bases, base)
            else
                local gp = top:FindFirstChild("GlitchProof")
                if gp then
                    pcall(function() gp:Destroy() end)
                    count = count + 1
                end
            end
        end
    end
    for _, base in ipairs(bases) do
        for _, child in ipairs(base:GetChildren()) do
            local cn = string.lower(child.Name)
            if string.find(cn, "glitchproof", 1, true)
                or string.find(cn, "glitch_proof", 1, true)
                or string.find(cn, "glitch proof", 1, true) then
                pcall(function() child:Destroy() end)
                count = count + 1
            end
        end
    end
    return count
end

local function removeAllBarriers()
    local count = 0
    count = count + removeGlitchProofParents()
    local toRemove = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isBarrierPart(obj) then table.insert(toRemove, obj) end
    end
    for _, obj in ipairs(toRemove) do
        if obj and obj.Parent then
            pcall(function() obj:Destroy() end)
            count = count + 1
        end
    end
    return count
end

