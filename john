_G.setToggleState = function(key, value)
    pcall(function()
        if key == "antiRagdoll" then value = true end
        local prev = state[key]
        state[key] = value
        if prev ~= value then
            local n = toggleDisplayNames[key] or key
            local c = value and "#5aff8c" or "#ff5a5a"
            notify('<font color="' .. c .. '">' .. n .. '</font> ' .. (value and "enabled" or "disabled"))
        end
        if value then
            if key == "aimbotMurderer" then state.aimbotSheriff = false; _G.updateViz("aimbotSheriff")
            elseif key == "aimbotSheriff" then state.aimbotMurderer = false; _G.updateViz("aimbotMurderer")
            elseif key == "farm" then state.xpFarm = false; _G.updateViz("xpFarm")
            elseif key == "xpFarm" then state.farm = false; _G.updateViz("farm") end
        end
        _G.updateViz(key)
        if key == "fullbright" then
            pcall(function()
                if state.fullbright then
                    Lighting.Brightness = 3
                    Lighting.Ambient = Color3.fromRGB(178, 178, 178)
                    Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
                    Lighting.FogEnd = 100000
                else
                    Lighting.Brightness = 1
                    Lighting.Ambient = Color3.fromRGB(70, 70, 70)
                    Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
                end
            end)
        elseif key == "quickTogglesVisible" and quickFrame then
            quickFrame.Visible = state.quickTogglesVisible
        elseif key == "circleButtonsEnabled" then
            _G.updateCircleViz()
        elseif key == "crosshairEnabled" or key == "crosshairHideShiftLock"
            or key == "crosshairDot" or key == "crosshairShiftLockOnly" then
            applyCrosshair()
        elseif key == "showRoundTimerCountdown" and not value then
            roundTimerFrame.Visible = false
        end
        saveSettings()
    end)
end

_G.updateViz = function(key)
    if mainTgls[key] then
        local d = mainTgls[key]
        local on = state[key]
        TweenService:Create(d.pill, TweenInfo.new(0.28, Enum.EasingStyle.Quint),
            {BackgroundColor3 = on and Color3.new(1,1,1) or Color3.fromRGB(32,32,32)}):Play()
        if d.inner then
            TweenService:Create(d.inner, TweenInfo.new(0.28, Enum.EasingStyle.Quint),
                {BackgroundColor3 = on and Color3.new(1,1,1) or Color3.fromRGB(22,22,22)}):Play()
        end
        TweenService:Create(d.dot, TweenInfo.new(0.42, Enum.EasingStyle.Back), {
            Position = on and UDim2.new(1, -20, 0.5, -8) or UDim2.new(0, 4, 0.5, -8),
            BackgroundColor3 = on and Color3.new(0,0,0) or Color3.fromRGB(200,200,200)
        }):Play()
    end
    if quickTgls[key] then
        local d = quickTgls[key]
        local on = state[key]
        TweenService:Create(d.row, TweenInfo.new(0.25, Enum.EasingStyle.Quint),
            {BackgroundColor3 = on and Color3.new(1,1,1) or Color3.fromRGB(18,18,18)}):Play()
        TweenService:Create(d.txt, TweenInfo.new(0.25),
            {TextColor3 = on and Color3.new(0,0,0) or Color3.fromRGB(220,220,220)}):Play()
    end
    if _G.circleButtonsList then
        for _, item in ipairs(_G.circleButtonsList) do
            if item.cfg.id == key then
                local b = item.btn
                if b and b.Parent then
                    local info = circleActionMap[key]
                    if not (info and info.type == "action") then
                        local on = state[key]
                        if on then
                            b.BackgroundColor3 = Color3.new(1,1,1)
                            b.TextColor3 = Color3.new(0,0,0)
                        else
                            b.BackgroundColor3 = Color3.new(0,0,0)
                            b.TextColor3 = Color3.new(1,1,1)
                        end
                        b.TextStrokeTransparency = 1
                    end
                end
            end
        end
    end
end

