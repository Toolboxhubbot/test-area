local flyBV, flyBG = nil, nil
local wasFlying = false
local function cleanupFly()
    if flyBV then pcall(function() flyBV:Destroy() end); flyBV = nil end
    if flyBG then pcall(function() flyBG:Destroy() end); flyBG = nil end
    if wasFlying and LP.Character then
        local h = LP.Character:FindFirstChildOfClass("Humanoid")
        local r = LP.Character:FindFirstChild("HumanoidRootPart")
        if h and h.Health > 0 then
            h.PlatformStand = false
            h.Sit = false
            h.AutoRotate = true
            pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
        if r then
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end
    end
    wasFlying = false
end

task.spawn(function()
    while true do
        task.wait(0.05)
        if state.flyEnabled and LP.Character then
            local r = LP.Character:FindFirstChild("HumanoidRootPart")
            local h = LP.Character:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                wasFlying = true
                h.PlatformStand = true
                pcall(function() h:ChangeState(Enum.HumanoidStateType.Physics) end)
                if not flyBV or flyBV.Parent ~= r then
                    if flyBV then pcall(function() flyBV:Destroy() end) end
                    if flyBG then pcall(function() flyBG:Destroy() end) end
                    flyBV = Instance.new("BodyVelocity")
                    flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    flyBV.Velocity = Vector3.zero
                    flyBV.Parent = r
                    flyBG = Instance.new("BodyGyro")
                    flyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                    flyBG.P = 9e4
                    flyBG.Parent = r
                end
                local md = Vector3.zero
                local cc = Workspace.CurrentCamera.CFrame
                if UIS.KeyboardEnabled then
                    if UIS:IsKeyDown(Enum.KeyCode.W) then md = md + cc.LookVector end
                    if UIS:IsKeyDown(Enum.KeyCode.S) then md = md - cc.LookVector end
                    if UIS:IsKeyDown(Enum.KeyCode.A) then md = md - cc.RightVector end
                    if UIS:IsKeyDown(Enum.KeyCode.D) then md = md + cc.RightVector end
                    if UIS:IsKeyDown(Enum.KeyCode.Space) then md = md + Vector3.new(0, 1, 0) end
                    if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then md = md - Vector3.new(0, 1, 0) end
                end
                if UIS.TouchEnabled then
                    local pm = LP.PlayerScripts:FindFirstChild("PlayerModule")
                    if pm then
                        pcall(function()
                            local c = require(pm):GetControls()
                            local mv = c:GetMoveVector()
                            if mv.Magnitude > 0 then
                                md = md + (cc.LookVector * -mv.Z) + (cc.RightVector * mv.X)
                            end
                        end)
                    end
                end
                if md.Magnitude < 0.05 then
                    local hmv = h.MoveDirection or Vector3.zero
                    if hmv.Magnitude > 0.05 then md = hmv end
                end
                flyBV.Velocity = md * (state.flySpeed or 50)
                flyBG.CFrame = cc
            else
                cleanupFly()
            end
        else
            cleanupFly()
        end
    end
end)

