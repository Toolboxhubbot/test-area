function getPlayerRole(plr)
    if not plr or not plr.Parent then return "Innocent" end
    local ch = plr.Character
    local bp = plr:FindFirstChild("Backpack")
    for _, attrName in ipairs({"Role","role","RoleName","roleName","Murderer","IsMurderer","Sheriff","IsSheriff","Hero","IsHero","Team","team","Class","class"}) do
        local a = plr:GetAttribute(attrName)
        if a ~= nil then
            if type(a) == "boolean" then
                if a then
                    local al = string.lower(attrName)
                    if string.find(al, "murder") then return "Murderer" end
                    if string.find(al, "sheriff") then return "Sheriff" end
                    if string.find(al, "hero") then return "Hero" end
                end
            elseif type(a) == "string" and a ~= "" then
                local sl = string.lower(a)
                if string.find(sl, "murder") then return "Murderer" end
                if string.find(sl, "sheriff") then return "Sheriff" end
                if string.find(sl, "hero") then return "Hero" end
                if string.find(sl, "innocent") then return "Innocent" end
                if sl ~= "none" and sl ~= "default" then return a end
            end
        end
    end
    if ch then
        for _, attrName in ipairs({"Role","role","RoleName","roleName","Team","Class"}) do
            local a = ch:GetAttribute(attrName)
            if type(a) == "string" and a ~= "" then
                local sl = string.lower(a)
                if string.find(sl, "murder") then return "Murderer" end
                if string.find(sl, "sheriff") then return "Sheriff" end
                if string.find(sl, "hero") then return "Hero" end
                if string.find(sl, "innocent") then return "Innocent" end
                return a
            end
        end
    end
    if plr.Team and plr.Team.Name ~= "" then
        local tn = string.lower(plr.Team.Name)
        if string.find(tn, "murder") then return "Murderer" end
        if string.find(tn, "sheriff") then return "Sheriff" end
        if string.find(tn, "hero") then return "Hero" end
    end
    if (ch and ch:FindFirstChild("Knife")) or (bp and bp:FindFirstChild("Knife")) then return "Murderer" end
    if (ch and ch:FindFirstChild("Gun")) or (bp and bp:FindFirstChild("Gun")) then return "Sheriff" end
    local sources = {plr, ch, ch and ch:FindFirstChild("Humanoid")}
    for _, src in ipairs(sources) do
        if src then
            for _, c in ipairs(src:GetChildren()) do
                if c:IsA("StringValue") then
                    local n = string.lower(c.Name)
                    if string.find(n, "role") or string.find(n, "team") or string.find(n, "class") then
                        local v = string.lower(c.Value)
                        if string.find(v, "murder") then return "Murderer" end
                        if string.find(v, "sheriff") then return "Sheriff" end
                        if string.find(v, "hero") then return "Hero" end
                        if string.find(v, "innocent") then return "Innocent" end
                    end
                    if n == "murderer" or n == "ismurderer" then return "Murderer" end
                    if n == "sheriff" or n == "issheriff" then return "Sheriff" end
                    if n == "hero" or n == "ishero" then return "Hero" end
                end
            end
        end
    end
    local ls = plr:FindFirstChild("leaderstats")
    if ls then
        for _, c in ipairs(ls:GetChildren()) do
            local n = string.lower(c.Name)
            if string.find(n, "role") or string.find(n, "team") or string.find(n, "class") then
                local v = string.lower(tostring(c.Value))
                if string.find(v, "murder") then return "Murderer" end
                if string.find(v, "sheriff") then return "Sheriff" end
                if string.find(v, "hero") then return "Hero" end
                if string.find(v, "innocent") then return "Innocent" end
            end
        end
    end
    local rd = getCachedRoleData()
    if rd and type(rd) == "table" then
        local pd = rd[plr.Name] or rd[tostring(plr.UserId)] or rd[plr.UserId]
        if pd then
            if type(pd) == "string" then
                local sl = string.lower(pd)
                if string.find(sl, "murder") then return "Murderer" end
                if string.find(sl, "sheriff") then return "Sheriff" end
                if string.find(sl, "hero") then return "Hero" end
                if string.find(sl, "innocent") then return "Innocent" end
                return pd
            end
            if type(pd) == "table" then
                local r = pd.Role or pd.role or pd.RoleName or pd.roleName or pd.Team or pd[1]
                if r and tostring(r) ~= "" then
                    local sl = string.lower(tostring(r))
                    if string.find(sl, "murder") then return "Murderer" end
                    if string.find(sl, "sheriff") then return "Sheriff" end
                    if string.find(sl, "hero") then return "Hero" end
                    if string.find(sl, "innocent") then return "Innocent" end
                    return tostring(r)
                end
            end
        end
    end
    return "Innocent"
end

