-- ============ ANIMATION HELPERS ============
local ANIM_STYLES = {
    Back    = Enum.EasingStyle.Back,
    Bounce  = Enum.EasingStyle.Bounce,
    Elastic = Enum.EasingStyle.Elastic,
    Quad    = Enum.EasingStyle.Quad,
    Quint   = Enum.EasingStyle.Quint,
    Sine    = Enum.EasingStyle.Sine,
    Linear  = Enum.EasingStyle.Linear,
}

local function getAnimStyle()
    return ANIM_STYLES[state.animationStyle or "Back"] or Enum.EasingStyle.Back
end

local function animTime(baseTime)
    local mult = state.animationSpeed or 1
    if mult <= 0 then mult = 1 end
    return baseTime / mult
end

local function attachBounce(b)
    if state.animationsEnabled == false or state.animBounce == false then return end
    local s = Instance.new("UIScale", b)
    b.MouseButton1Down:Connect(function()
        TweenService:Create(s, TweenInfo.new(animTime(0.08)), {Scale=0.9}):Play()
    end)
    local function r()
        TweenService:Create(s, TweenInfo.new(animTime(0.5), Enum.EasingStyle.Elastic), {Scale=1}):Play()
    end
    b.MouseButton1Up:Connect(r)
    b.MouseLeave:Connect(r)
end

local function attachRipple(b, c)
    if state.animationsEnabled == false or state.animRipple == false then return end
    c = c or Color3.new(1,1,1)
    b.ClipsDescendants = true
    b.MouseButton1Down:Connect(function()
        local pos = b.AbsolutePosition
        local m = UIS:GetMouseLocation()
        local f = Instance.new("Frame", b)
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.Position = UDim2.new(0, m.X - pos.X, 0, m.Y - pos.Y)
        f.Size = UDim2.new(0, 0, 0, 0)
        f.BackgroundColor3 = c
        f.BackgroundTransparency = 0.5
        f.BorderSizePixel = 0
        f.ZIndex = (b.ZIndex or 1) + 5
        f.Active = false
        Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
        local sz = math.max(b.AbsoluteSize.X, b.AbsoluteSize.Y) * 3
        TweenService:Create(f, TweenInfo.new(animTime(0.65), Enum.EasingStyle.Quint), {Size = UDim2.new(0,sz,0,sz), BackgroundTransparency=1}):Play()
        task.delay(animTime(0.7), function() if f and f.Parent then f:Destroy() end end)
    end)
end

local function attachShine(b)
    if state.animationsEnabled == false or state.animShine == false then return end
    b.ClipsDescendants = true
    local s = Instance.new("Frame", b)
    s.Size = UDim2.new(0, 32, 1.8, 0)
    s.Position = UDim2.new(-0.35, 0, -0.4, 0)
    s.BackgroundColor3 = Color3.new(1,1,1)
    s.BackgroundTransparency = 0.85
    s.Rotation = 14
    s.BorderSizePixel = 0
    s.ZIndex = (b.ZIndex or 1) + 2
    s.Active = false
    b.MouseEnter:Connect(function()
        s.Position = UDim2.new(-0.35, 0, -0.4, 0)
        TweenService:Create(s, TweenInfo.new(animTime(0.6), Enum.EasingStyle.Quint), {Position = UDim2.new(1.4, 0, -0.4, 0)}):Play()
    end)
end

local function staggerFade(p)
    if state.animationsEnabled == false or state.animStagger == false then return end
    local ch = {}
    for _, c in ipairs(p:GetChildren()) do
        if c:IsA("GuiObject") and c.Visible ~= false then table.insert(ch, c) end
    end
    for i, c in ipairs(ch) do
        local sb = c.BackgroundTransparency
        local stt = nil
        if c:IsA("TextLabel") or c:IsA("TextButton") then
            stt = c.TextTransparency
            c.TextTransparency = 1
        end
        if c:IsA("Frame") or c:IsA("TextButton") then c.BackgroundTransparency = 1 end
        task.delay(i * 0.02 / math.max(1, state.animationSpeed or 1), function()
            if not c.Parent then return end
            if c:IsA("Frame") or c:IsA("TextButton") then
                TweenService:Create(c, TweenInfo.new(animTime(0.4), getAnimStyle()), {BackgroundTransparency=sb}):Play()
            end
            if stt then TweenService:Create(c, TweenInfo.new(animTime(0.4)), {TextTransparency=stt}):Play() end
        end)
    end
end

