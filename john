local function makeSlider(page, label, order, iv, minV, maxV, sK, onChange)
    local row = Instance.new("Frame", page)
    row.Size = UDim2.new(1,0,0,62)
    row.LayoutOrder = order
    row.BackgroundColor3 = THEME.card
    row.BackgroundTransparency = 0.12
    corner(row, 10)
    glow(row, THEME.border, 0.55, 1)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(0.7,0,0,20)
    lbl.Position = UDim2.new(0,16,0,6)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = THEME.text
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 11.5
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local ib = Instance.new("TextBox", row)
    ib.Size = UDim2.new(0,56,0,24)
    ib.Position = UDim2.new(1,-72,0,4)
    ib.BackgroundColor3 = THEME.bgDeep
    ib.Text = tostring(iv)
    ib.TextColor3 = THEME.accent
    ib.Font = Enum.Font.GothamBold
    ib.TextSize = 11
    ib.ClearTextOnFocus = false
    corner(ib, 6)
    glow(ib, THEME.border, 0.6, 1)

    local tr = Instance.new("Frame", row)
    tr.Size = UDim2.new(1,-32,0,6)
    tr.Position = UDim2.new(0,16,1,-20)
    tr.BackgroundColor3 = Color3.fromRGB(26, 26, 40)
    corner(tr, 9999)

    local fl = Instance.new("Frame", tr)
    fl.Size = UDim2.new((iv-minV)/(maxV-minV),0,1,0)
    fl.BackgroundColor3 = THEME.accent
    fl.BorderSizePixel = 0
    corner(fl, 9999)
    gradient(fl, THEME.accent, THEME.accent2, 0)

    local kn = Instance.new("Frame", tr)
    kn.Size = UDim2.new(0,14,0,14)
    kn.Position = UDim2.new((iv-minV)/(maxV-minV),0,0.5,-7)
    kn.BackgroundColor3 = Color3.new(1,1,1)
    kn.ZIndex = 3
    corner(kn, 9999)
    local knGlow = Instance.new("UIStroke", kn)
    knGlow.Color = THEME.accent
    knGlow.Thickness = 2
    knGlow.Transparency = 0.3

    local drag = false
    local function update(inp)
        local mx = inp.Position.X
        local tp = tr.AbsolutePosition.X
        local ts = tr.AbsoluteSize.X
        if ts == 0 then return end
        local p = math.clamp((mx-tp)/ts, 0, 1)
        local v = math.floor(minV + (maxV-minV)*p + 0.5)
        if sK then state[sK] = v end
        ib.Text = tostring(v)
        fl.Size = UDim2.new(p,0,1,0)
        kn.Position = UDim2.new(p,0,0.5,-7)
        if onChange then onChange(v) end
        if sK then saveSettings() end
    end
    tr.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            drag = true; update(inp)
        end
    end)
    UIS.InputChanged:Connect(function(inp) if drag then update(inp) end end)
    UIS.InputEnded:Connect(function() drag = false end)
    ib.FocusLost:Connect(function()
        local v = tonumber(ib.Text)
        if v then
            v = math.clamp(v, minV, maxV)
            if sK then state[sK] = v end
            ib.Text = tostring(v)
            local p = (v-minV)/(maxV-minV)
            fl.Size = UDim2.new(p,0,1,0)
            kn.Position = UDim2.new(p,0,0.5,-7)
            if onChange then onChange(v) end
            if sK then saveSettings() end
        else
            if sK then ib.Text = tostring(state[sK]) else ib.Text = tostring(iv) end
        end
    end)
end

