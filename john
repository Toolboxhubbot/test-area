function getAimPosAtLevel(char)
    if not char then return nil end
    local level = state.magicBulletYLevel or 0
    local root = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not root then return nil end
    if level >= 1 then
        return (head and head.Position) or (root.Position + Vector3.new(0, 1.5, 0))
    elseif level <= -1 then
        return root.Position - Vector3.new(0, 6, 0)
    else
        return (torso and torso.Position) or root.Position
    end
end

function fireSilentAtMurderer()
    if not canFire() then return false end
    local murd = getMurd()
    if not murd or not murd.Character then return false end
    local char = murd.Character
    local part = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not part then return false end
    if not state.shootThroughWall and not hasClearShot(part) then return false end
    lastShotTime = tick()
    local remote = findShootRemote()
    if not remote then return false end
    local aimPos = getAimPosAtLevel(char)
    if not aimPos then return false end
    local targetCF = CFrame.new(aimPos)
    local originCF = Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame or targetCF
    local yLevel = state.magicBulletYLevel or 0
    local hum = char:FindFirstChildOfClass("Humanoid")
    pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(originCF, targetCF, murd, yLevel)
            remote:FireServer(aimPos, murd, yLevel)
            remote:FireServer(targetCF)
            remote:FireServer(murd)
            remote:FireServer(murd, yLevel)
            if hum then remote:FireServer(hum) end
        else
            remote:InvokeServer(originCF, targetCF, murd, yLevel)
            remote:InvokeServer(aimPos, murd, yLevel)
            remote:InvokeServer(murd, yLevel)
        end
    end)
    return true
end

function fireThroughWall()
    if not canFire() then return false end
    local murd = getMurd()
    if not murd or not murd.Character then return false end
    local char = murd.Character
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local remote = findShootRemote()
    if not remote then return false end
    lastShotTime = tick()
    local aimPos = getAimPosAtLevel(char) or root.Position
    local targetCF = CFrame.new(aimPos)
    local originCF = CFrame.new(aimPos + Vector3.new(0, 3, 0))
    local yLevel = state.magicBulletYLevel or 0
    pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(originCF, targetCF, murd, yLevel)
            remote:FireServer(aimPos, murd, yLevel)
            remote:FireServer(targetCF)
            remote:FireServer(murd, yLevel)
        elseif remote:IsA("RemoteFunction") then
            remote:InvokeServer(originCF, targetCF, murd, yLevel)
            remote:InvokeServer(aimPos, murd, yLevel)
        end
    end)
    return true
end

function tryShootMurderer()
    if state.shootThroughWall then return fireThroughWall() else return fireSilentAtMurderer() end
end
function fullShootSequence() return tryShootMurderer() end

