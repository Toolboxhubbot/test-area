local function DisableWaterPart(part)
    if part and part:IsA("BasePart") then
        if not modifiedParts[part] then
            modifiedParts[part] = { CanTouch = part.CanTouch, CanCollide = part.CanCollide }
        end
        part.CanTouch = false
        part.CanCollide = false
    end
end

