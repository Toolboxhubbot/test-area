                            tx.Text = p.Name .. "\n[" .. role .. "]"
                            tx.TextColor3 = col
                            tx.TextStrokeTransparency = 0
                            tx.TextStrokeColor3 = Color3.new(0, 0, 0)
                            tx.Font = Enum.Font.GothamBold
                            tx.TextSize = 14
                            tx.Parent = bb
                            espCache[p] = {hl = hl, bb = bb, tx = tx}
                        else
                            e.hl.FillColor = col
                            e.hl.OutlineColor = col
                            if e.tx then
                                e.tx.Text = p.Name .. "\n[" .. role .. "]"
                                e.tx.TextColor3 = col
                            end
                            e.hl.Adornee = ch
                            e.bb.Adornee = head
                        end
                    else
                        if espCache[p] then clearESP(p) end
                    end
                end
            end
            for p, _ in pairs(espCache) do
                if not p or not p.Parent then clearESP(p) end
            end
        end
        if state.espGunDrop then
            for _, v in pairs(Workspace:GetDescendants()) do
                if v.Name == "GunDrop" and v:IsA("BasePart") and not gunDropCache[v] then
                    local hl = Instance.new("Highlight")
                    hl.FillColor = Color3.fromRGB(255, 255, 0)
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.fromRGB(255, 255, 0)
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = espF
                    hl.Adornee = v
                    gunDropCache[v] = hl
                end
            end
            for k, v in pairs(gunDropCache) do
                if not k.Parent or not v.Parent then
                    pcall(function() v:Destroy() end)
                    gunDropCache[k] = nil
                end
            end
        else
            clearGunDropESP()
        end
    end
end)

local HIDE_POS = CFrame.new(0,-300,0)
local lastCoinFoundTime = tick()
local NO_COIN_TIMEOUT = 12
local currentFarmTween, currentTargetCoin
local function cancelFarmTween()
    if currentFarmTween then pcall(function() currentFarmTween:Cancel() end); currentFarmTween = nil end
    currentTargetCoin = nil
end
task.spawn(function()
    while true do
        task.wait(0.05)
        if not state.farm and not state.xpFarm then cancelFarmTween()
        elseif not alive() then cancelFarmTween()
        else
            local r = LP.Character:FindFirstChild("HumanoidRootPart")
            local h = LP.Character:FindFirstChildOfClass("Humanoid")
            if r and h then
                if state.xpFarm then
                    cancelFarmTween()
                    h.PlatformStand = true
                    r.Anchored = true
                    r.CFrame = HIDE_POS
                    r.AssemblyLinearVelocity = Vector3.zero
                elseif state.farm then
                    if isLobby() then
                        cancelFarmTween()
                        h.PlatformStand = true
                        r.Anchored = true
                        r.CFrame = HIDE_POS
                        lastCoinFoundTime = tick()
                    else
                        r.Anchored = false
                        h.PlatformStand = true
                        h.AutoRotate = false
                        r.AssemblyLinearVelocity = Vector3.zero
                        local coins = {}
                        for _, m in ipairs(Workspace:GetChildren()) do
                            local cc = m:FindFirstChild("CoinContainer") or (m.Name == "CoinContainer" and m)
                            if cc then
                                for _, d in ipairs(cc:GetDescendants()) do
                                    if d:IsA("BasePart") and d:FindFirstChild("TouchInterest") then
                                        table.insert(coins, d)
                                    end
                                end
                            end
                        end
                        if #coins > 0 then
                            lastCoinFoundTime = tick()
                            local closest, sh = nil, math.huge
                            for _, c in ipairs(coins) do
                                local d = (r.Position - c.Position).Magnitude
                                if d < sh then sh = d; closest = c end
                            end
                            if closest then
                                local d = (r.Position - closest.Position).Magnitude
                                if d <= 7 then
                                    pcall(function()
                                        for _=1,3 do
                                            firetouchinterest(r, closest, 0)
                                            firetouchinterest(r, closest, 1)
                                        end
                                    end)
                                end
                                if currentTargetCoin ~= closest then
                                    cancelFarmTween()
                                    currentTargetCoin = closest
                                    local tp = closest.Position + Vector3.new(0,-4.8,0)
                                    local tc = CFrame.new(tp) * CFrame.Angles(math.rad(90), 0, math.rad(180))
                                    local dur = math.clamp(d / (settingsConfig.tweenSpeed or 25), 0.05, 3.3)
                                    currentFarmTween = TweenService:Create(r, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame=tc})
                                    currentFarmTween:Play()
                                end
                            end
                        elseif tick() - lastCoinFoundTime > NO_COIN_TIMEOUT then
                            lastCoinFoundTime = tick()
                            if not isLobby() then triggerMenuReset() task.wait(1.5) end
                        end
                    end
                end
            end
        end
    end
end)

