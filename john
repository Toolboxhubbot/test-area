-- ============ INVISIBILITY SYSTEM ============
local INVIS_POSITION = Vector3.new(-25.95, 84, 3537.55)
local invisSeat = nil
local invisWeld = nil
local dodgeActive = false

local function setCharInvisTransparency(char, transparency)
    if not char then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Decal") then
            pcall(function() d.Transparency = transparency end)
        end
    end
end

local function cleanupInvisSeat()
    if invisWeld and invisWeld.Parent then pcall(function() invisWeld:Destroy() end) end
    if invisSeat and invisSeat.Parent then pcall(function() invisSeat:Destroy() end) end
    invisWeld = nil
    invisSeat = nil
    local existing = Workspace:FindFirstChild("invischair")
    if existing then pcall(function() existing:Destroy() end) end
end

local function enableInvisibility()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    local savedCF = hrp.CFrame
    hrp.CFrame = CFrame.new(INVIS_POSITION)
    task.wait(0.15)
    cleanupInvisSeat()
    local seat = Instance.new("Seat")
    seat.Name = "invischair"
    seat.Anchored = false
    seat.CanCollide = false
    seat.Transparency = 1
    seat.Size = Vector3.new(2, 1, 1)
    seat.CFrame = CFrame.new(INVIS_POSITION)
    seat.Parent = Workspace
    local weld = Instance.new("Weld")
    weld.Part0 = seat
    weld.Part1 = hrp
    weld.Parent = seat
    invisSeat = seat
    invisWeld = weld
    task.wait(0.1)
    seat.CFrame = savedCF
    task.wait(0.1)
    setCharInvisTransparency(char, 0.5)
end

local function disableInvisibility()
    cleanupInvisSeat()
    if LP.Character then setCharInvisTransparency(LP.Character, 0) end
end

