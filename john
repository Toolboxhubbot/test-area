local _shootRemoteCache, _shootRemoteCacheAt = nil, 0
local function findShootRemote()
    if _shootRemoteCache and _shootRemoteCache.Parent and (tick() - _shootRemoteCacheAt) < 3 then
        return _shootRemoteCache
    end
    local paths = {
        {"Remotes","GunHit"},
        {"Remotes","Gameplay","GunHit"},
        {"Remotes","Gameplay","ShootGun"},
        {"Remotes","ShootGun"},
        {"Remotes","FireGun"},
        {"ShootGun"},
    }
    for _, path in ipairs(paths) do
        local cur = ReplicatedStorage
        local ok = true
        for i = 1, #path do
            cur = cur and cur:FindFirstChild(path[i])
            if not cur then ok = false; break end
        end
        if ok and cur and (cur:IsA("RemoteEvent") or cur:IsA("RemoteFunction")) then
            _shootRemoteCache, _shootRemoteCacheAt = cur, tick()
            return cur
        end
    end
    local gun = getGun()
    if gun then
        for _, d in ipairs(gun:GetDescendants()) do
            if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                _shootRemoteCache, _shootRemoteCacheAt = d, tick()
                return d
            end
        end
    end
    return nil
end

local function getAimPosition(char)
    local yh = state.silentAimYHeight or 2
    local head = char:FindFirstChild("Head")
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local root = char:FindFirstChild("HumanoidRootPart")
    if yh >= 1.5 then return (head and head.Position) or (root and root.Position + Vector3.new(0, 1.5, 0))
    elseif yh >= 0.5 then return (torso and torso.Position) or (root and root.Position)
    else return (root and (root.Position + Vector3.new(0, -2.5, 0))) or (torso and torso.Position) end
end

local function predictLeadPosition(basePos, velocity, camPos, bulletSpeed)
    local aimPos = basePos
    for _ = 1, 8 do
        local dist = (aimPos - camPos).Magnitude
        local t = dist / bulletSpeed
        aimPos = basePos + velocity * t
    end
    return aimPos
end

local function expandTargetHitbox(target, size)
    if not target or not target.Character then return nil end
    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local data = {hrp=hrp, size=hrp.Size, transparency=hrp.Transparency, cancollide=hrp.CanCollide}
    pcall(function()
        hrp.Size = Vector3.new(size, size, size)
        hrp.Transparency = 1
        hrp.CanCollide = false
    end)
    task.spawn(function()
        local st = tick()
        while tick() - st < 1 do
            pcall(function()
                if hrp and hrp.Parent then
                    hrp.Size = Vector3.new(size, size, size)
                    hrp.Transparency = 1
                    hrp.CanCollide = false
                end
            end)
            task.wait(0.05)
        end
    end)
    return data
end

local function revertTargetHitbox(data)
    if not data or not data.hrp then return end
    pcall(function()
        if data.hrp.Parent then
            data.hrp.Size = data.size
            data.hrp.Transparency = data.transparency
            data.hrp.CanCollide = data.cancollide
        end
    end)
end

function fireSilentAtMurderer()
    local pre = getPingPreset()
    if tick() - lastShotTime < pre.cooldown then return false end
    local murd = getMurd()
    if not murd or murd == LP then return false end
    local char = murd.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local gun = getGun()
    if not gun then
        gun = equipTool("Gun")
        if not gun then return false end
        task.wait(0.03)
        gun = getGun()
        if not gun then return false end
    end
    local remote = findShootRemote()
    if not remote then return false end
    local cam = Workspace.CurrentCamera
    if not cam then return false end
    local camPos = cam.CFrame.Position
    local aimPos = getAimPosition(char)
    if not aimPos then return false end
    if state.silentAimWallCheck and not state.shootThroughWall then
        local rp = RaycastParams.new()
        local ignores = {}
        if LP.Character then table.insert(ignores, LP.Character) end
        table.insert(ignores, char)
        rp.FilterDescendantsInstances = ignores
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.IgnoreWater = true
        local hit = Workspace:Raycast(camPos, aimPos - camPos, rp)
        if hit then return false end
    end
    lastShotTime = tick()
    local vel = root.AssemblyLinearVelocity
    local predictedPos = aimPos
    if vel.Magnitude > 1 then
        predictedPos = predictLeadPosition(aimPos, vel, camPos, pre.bulletSpeed)
        local dist = (predictedPos - camPos).Magnitude
        predictedPos = predictedPos + Vector3.new(0, math.clamp(dist * 0.0012, 0, 0.35), 0)
    end
    local hbData = expandTargetHitbox(murd, 10)
    local originCF = cam.CFrame
    local aimCF = CFrame.new(camPos, predictedPos)
    local targetCF = root.CFrame
    pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(originCF, aimCF)
            task.defer(function() pcall(function() remote:FireServer(originCF, targetCF) end) end)
            task.defer(function() pcall(function() remote:FireServer(originCF, predictedPos) end) end)
            task.defer(function() pcall(function() remote:FireServer(aimCF) end) end)
            task.defer(function() pcall(function() remote:FireServer(originCF, aimCF, root) end) end)
        elseif remote:IsA("RemoteFunction") then
            pcall(function() remote:InvokeServer(originCF, aimCF) end)
        end
    end)
    if hbData then task.delay(1, function() revertTargetHitbox(hbData) end) end
    return true
end

function fireThroughWall()
    local pre = getPingPreset()
    if tick() - lastShotTime < pre.cooldown then return false end
    local murd = getMurd()
    if not murd or not murd.Character then return false end
    local root = murd.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local gun = getGun() or equipTool("Gun")
    if not gun then return false end
    task.wait(0.03)
    local remote = findShootRemote()
    if not remote then return false end
    lastShotTime = tick()
    local hbData = expandTargetHitbox(murd, 20)
    local targetCF = root.CFrame
    local originCF = CFrame.new(targetCF.Position + Vector3.new(0, 3, 0))
    for _ = 1, 8 do
        pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer(originCF, targetCF)
                remote:FireServer(targetCF)
                remote:FireServer(originCF, targetCF, root)
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer(originCF, targetCF)
            end
        end)
        task.wait(0.015)
    end
    if hbData then task.delay(1, function() revertTargetHitbox(hbData) end) end
    return true
end

function tryShootMurderer()
    if state.shootThroughWall then
        return fireThroughWall()
    else
        return fireSilentAtMurderer()
    end
end

