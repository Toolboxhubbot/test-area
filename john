    local function stopHeadless(cfg)
        if cfg.stopped then pcall(function() cfg.stopped:Disconnect() end) cfg.stopped = nil end
        if cfg.track then pcall(function() cfg.track:Stop() cfg.track:Destroy() end) cfg.track = nil end
    end
    local function playHeadless(cfg)
        local c = LP.Character
        if not c then return end
        local hum = c:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        stopHeadless(cfg)
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. cfg.id
        local track = hum:LoadAnimation(anim)
        track.Priority = Enum.AnimationPriority.Action
        track.Looped = true
        track:Play()
        cfg.track = track
        cfg.stopped = track.Stopped:Connect(function()
            if cfg.on then task.wait(0.1) playHeadless(cfg) end
        end)
    end
    local keys = {"headless1", "headless2", "headless3"}
