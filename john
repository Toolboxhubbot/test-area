local currentAimTarget = nil
RunService.RenderStepped:Connect(function(dt)
    if not alive() then currentAimTarget = nil; return end
    if not (state.aimbotMurderer or state.aimbotSheriff) then currentAimTarget = nil; return end
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local vps = cam.ViewportSize
    local center = Vector2.new(vps.X*0.5, vps.Y*0.5)
    local candidates = {}
    if state.aimbotMurderer then
        local m = getMurd()
        if m then table.insert(candidates, m) end
    elseif state.aimbotSheriff then
        for _, s in ipairs(getLiveSheriffHeroes()) do table.insert(candidates, s) end
    end
    if #candidates == 0 then currentAimTarget = nil; return end
    local fovR = state.aimbotFOV or 250
    local best, bestScore = nil, -math.huge
    for _, tp in ipairs(candidates) do
        local ch = tp.Character
        if ch then
            local hh = ch:FindFirstChildOfClass("Humanoid")
            if hh and hh.Health > 0 then
                local tpart = ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
                if tpart then
                    local sp, onScreen = cam:WorldToViewportPoint(tpart.Position)
                    if onScreen and sp.Z > 0 then
                        local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if sd <= fovR then
                            local score = -sd
                            if tpart.Name == "Head" then score = score + 50 end
                            if score > bestScore then bestScore = score; best = tp end
                        end
                    end
                end
            end
        end
    end
    if not best or not best.Character then currentAimTarget = nil; return end
    currentAimTarget = best
    local ch = best.Character
    local tpart = ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
    if not tpart then return end
    local aimPos = tpart.Position
    if state.aimbotPredict then
        local vel = tpart.AssemblyLinearVelocity
        if vel.Magnitude > 1 then
            local dist = (tpart.Position - cam.CFrame.Position).Magnitude
            aimPos = tpart.Position + vel * (dist / 800)
        end
    end
    local desired = CFrame.new(cam.CFrame.Position, aimPos)
    if state.aimbotSnap then cam.CFrame = desired
    else
        local smooth = state.aimbotSmooth or 4
        if smooth <= 1 then cam.CFrame = desired
        else
            local alpha = math.clamp(1 - math.exp(-dt * (60 / smooth) * 0.15), 0.05, 1)
            cam.CFrame = cam.CFrame:Lerp(desired, alpha)
        end
    end
end)

-- ESP
local espF = nil
local espCache, gunDropCache = {}, {}
local function getOrCreateEspFolder()
    local f = CoreGui:FindFirstChild("AW_ESP")
    if f then return f end
    f = PlayerGui:FindFirstChild("AW_ESP")
    if f then return f end
    f = Instance.new("Folder")
    f.Name = "AW_ESP"
    pcall(function() f.Parent = CoreGui end)
    if not f.Parent then pcall(function() f.Parent = PlayerGui end) end
    return f
end
espF = getOrCreateEspFolder()
local function destroyEntry(e)
    if not e then return end
    pcall(function()
        if e.hl then e.hl:Destroy() end
        if e.bb then e.bb:Destroy() end
    end)
end
local function clearESP(plr)
    local e = espCache[plr]
    if not e then return end
    destroyEntry(e)
    espCache[plr] = nil
end
local function clearGunDropESP()
    for k, v in pairs(gunDropCache) do
        pcall(function() v:Destroy() end)
        gunDropCache[k] = nil
    end
end
task.spawn(function()
    while true do
        task.wait(0.1)
        if not espF or not espF.Parent then
            espF = getOrCreateEspFolder()
            for k in pairs(espCache) do espCache[k] = nil end
            gunDropCache = {}
        end
        if not state.espPlayers then
            for p, _ in pairs(espCache) do clearESP(p) end
        else
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP then
                    local ch = p.Character
                    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                    if ch and hrp and hum and hum.Health > 0 then
                        local role = getPlayerRole(p)
                        local col = roleColor(role)
                        local head = ch:FindFirstChild("Head") or hrp
                        local e = espCache[p]
                        if e and (not e.hl or not e.hl.Parent or not e.bb or not e.bb.Parent) then
                            destroyEntry(e); espCache[p] = nil; e = nil
                        end
                        if not e then
                            local hl = Instance.new("Highlight")
                            hl.FillColor = col
                            hl.FillTransparency = 0.5
                            hl.OutlineColor = col
                            hl.OutlineTransparency = 0
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Parent = espF
                            hl.Adornee = ch
                            local bb = Instance.new("BillboardGui")
                            bb.Size = UDim2.new(0, 220, 0, 44)
                            bb.StudsOffset = Vector3.new(0, 4, 0)
                            bb.AlwaysOnTop = true
                            bb.MaxDistance = 2000
                            bb.Parent = espF
                            bb.Adornee = head
                            local tx = Instance.new("TextLabel")
                            tx.Size = UDim2.new(1, 0, 1, 0)
                            tx.BackgroundTransparency = 1
                            tx.Text = p.Name .. "\n[" .. role .. "]"
                            tx.TextColor3 = col
                            tx.TextStrokeTransparency = 0
                            tx.TextStrokeColor3 = Color3.new(0, 0, 0)
                            tx.Font = Enum.Font.GothamBold
                            tx.TextSize = 14
                            tx.Parent = bb
                            espCache[p] = {hl = hl, bb = bb, tx = tx}
                        end
                    else
                        if espCache[p] then clearESP(p) end
                    end
                end
            end
        end
        if state.espGunDrop then
            for _, v in pairs(Workspace:GetDescendants()) do
                if v.Name == "GunDrop" and v:IsA("BasePart") and not gunDropCache[v] then
                    local hl = Instance.new("Highlight")
                    hl.FillColor = Color3.fromRGB(255, 255, 0)
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.fromRGB(255, 255, 0)
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = espF
                    hl.Adornee = v
                    gunDropCache[v] = hl
                end
            end
            for k, v in pairs(gunDropCache) do
                if not k.Parent or not v.Parent then
                    pcall(function() v:Destroy() end)
                    gunDropCache[k] = nil
                end
            end
        else
            clearGunDropESP()
        end
    end
end)

-- Farm loop
local HIDE_POS = CFrame.new(0,-300,0)
local lastCoinFoundTime = tick()
local NO_COIN_TIMEOUT = 12
local currentFarmTween, currentTargetCoin
local function cancelFarmTween()
    if currentFarmTween then pcall(function() currentFarmTween:Cancel() end); currentFarmTween = nil end
    currentTargetCoin = nil
end
task.spawn(function()
    while true do
        task.wait(0.05)
        if not state.farm and not state.xpFarm then cancelFarmTween()
        elseif not alive() then cancelFarmTween()
        else
            local r = LP.Character:FindFirstChild("HumanoidRootPart")
            local h = LP.Character:FindFirstChildOfClass("Humanoid")
            if r and h then
                if state.xpFarm then
                    cancelFarmTween()
                    h.PlatformStand = true
                    r.Anchored = true
                    r.CFrame = HIDE_POS
                    r.AssemblyLinearVelocity = Vector3.zero
                elseif state.farm then
                    if isLobby() then
                        cancelFarmTween()
                        h.PlatformStand = true
                        r.Anchored = true
                        r.CFrame = HIDE_POS
                        lastCoinFoundTime = tick()
                    else
                        r.Anchored = false
                        h.PlatformStand = true
                        h.AutoRotate = false
                        r.AssemblyLinearVelocity = Vector3.zero
                        local coins = {}
                        for _, m in ipairs(Workspace:GetChildren()) do
                            local cc = m:FindFirstChild("CoinContainer") or (m.Name == "CoinContainer" and m)
                            if cc then
                                for _, d in ipairs(cc:GetDescendants()) do
                                    if d:IsA("BasePart") and d:FindFirstChild("TouchInterest") then
                                        table.insert(coins, d)
                                    end
                                end
                            end
                        end
                        if #coins > 0 then
                            lastCoinFoundTime = tick()
                            local closest, sh = nil, math.huge
                            for _, c in ipairs(coins) do
                                local d = (r.Position - c.Position).Magnitude
                                if d < sh then sh = d; closest = c end
                            end
                            if closest then
                                local d = (r.Position - closest.Position).Magnitude
                                if d <= 7 then
                                    pcall(function()
                                        for _=1,3 do
                                            firetouchinterest(r, closest, 0)
                                            firetouchinterest(r, closest, 1)
                                        end
                                    end)
                                end
                                if currentTargetCoin ~= closest then
                                    cancelFarmTween()
                                    currentTargetCoin = closest
                                    local tp = closest.Position + Vector3.new(0,-4.8,0)
                                    local tc = CFrame.new(tp) * CFrame.Angles(math.rad(90), 0, math.rad(180))
                                    local dur = math.clamp(d / (settingsConfig.tweenSpeed or 25), 0.05, 3.3)
                                    currentFarmTween = TweenService:Create(r, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame=tc})
                                    currentFarmTween:Play()
                                end
                            end
                        elseif tick() - lastCoinFoundTime > NO_COIN_TIMEOUT then
                            lastCoinFoundTime = tick()
                            if not isLobby() then triggerMenuReset() task.wait(1.5) end
                        end
                    end
                end
            end
        end
    end
end)

