    local origin = hrp.Position
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v.Name == "GunDrop" and v:IsA("BasePart") then
            local d = (v.Position - origin).Magnitude
            if d < bd then
                bd = d
                best = v
            end
        end
    end
