lobbyBounds = nil
lobbyBoundsCheckedAt = 0
function detectLobbyBounds()
    for _, obj in ipairs(Workspace:GetChildren()) do
        local n = string.lower(obj.Name)
        if string.find(n, "lobby", 1, true) or string.find(n, "waiting", 1, true) then
            if obj:IsA("BasePart") then
                return {min=obj.Position - obj.Size * 0.5, max=obj.Position + obj.Size * 0.5}
            elseif obj:IsA("Model") then
                local ok, cf, sz = pcall(function() local c, s = obj:GetBoundingBox(); return c, s end)
                if ok and cf and sz then return {min=cf.Position - sz * 0.5, max=cf.Position + sz * 0.5} end
            end
        end
    end
    return nil
end
LOBBY_FALLBACK_Y = 400
function isInLobby(position)
    local now = tick()
    if not lobbyBounds or (now - lobbyBoundsCheckedAt) > 5 then
        lobbyBounds = detectLobbyBounds()
        lobbyBoundsCheckedAt = now
    end
    if lobbyBounds then
        local pad = 25
        local mn = lobbyBounds.min - Vector3.new(pad, pad, pad)
        local mx = lobbyBounds.max + Vector3.new(pad, pad, pad)
        if position.X >= mn.X and position.X <= mx.X and position.Y >= mn.Y and position.Y <= mx.Y and position.Z >= mn.Z and position.Z <= mx.Z then return true end
    end
    return position.Y > LOBBY_FALLBACK_Y
end

lastTpMapNotify = 0
function teleportToMap(silent)
    local r = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not r then return false end
    local mapFolder = nil
    for _, m in ipairs(Workspace:GetChildren()) do
        if m:FindFirstChild("CoinContainer") or m.Name == "CoinContainer" then mapFolder = m break end
    end
    if not mapFolder then
        if not silent and tick() - lastTpMapNotify > 8 then
            lastTpMapNotify = tick()
            _G.__AW_NOTIFY("No map detected")
        end
        return false
    end
    local spawnPart = nil
    for _, d in ipairs(mapFolder:GetDescendants()) do
        if d:IsA("SpawnLocation") and d.Enabled ~= false then spawnPart = d break end
    end
    local targetPos = nil
    if spawnPart then targetPos = spawnPart.Position + Vector3.new(0, 5, 0)
    elseif mapFolder:IsA("Model") then
        local ok, cf, size = pcall(function() local c, s = mapFolder:GetBoundingBox(); return c, s end)
        if ok and cf and size then targetPos = cf.Position + Vector3.new(0, size.Y * 0.5 + 8, 0) end
    end
    if not targetPos then
        local sum, count = Vector3.zero, 0
        for _, d in ipairs(mapFolder:GetDescendants()) do
            if d:IsA("BasePart") and d.Name ~= "CoinContainer" then sum = sum + d.Position; count = count + 1 end
        end
        if count > 0 then targetPos = (sum / count) + Vector3.new(0, 25, 0) end
    end
    if not targetPos then return false end
    r.Anchored = true
    r.CFrame = CFrame.new(targetPos + Vector3.new(0, 200, 0))
    task.wait(0.1)
    r.Anchored = false
    task.wait(0.15)
    local ray = RaycastParams.new()
    if LP.Character then ray.FilterDescendantsInstances = {LP.Character} end
    ray.FilterType = Enum.RaycastFilterType.Exclude
    local hit = Workspace:Raycast(r.Position, Vector3.new(0, -1000, 0), ray)
    if hit then
        r.Anchored = true
        r.CFrame = CFrame.new(hit.Position + Vector3.new(0, 4, 0))
        task.wait(0.1)
        r.Anchored = false
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
    if not silent then _G.__AW_NOTIFY("Teleported to <font color=\"#5aff8c\">" .. mapFolder.Name .. "</font>") end
    return true
end
