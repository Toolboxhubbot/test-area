            state.speedValue = n
            state.speedEnabled = true
            saveSettings()
            _G.__AW_NOTIFY("Speed = "..n)
        end
    elseif cmd == "jump" then
        local n = num(2)
        if n then
            state.jumpValue = n
            state.jumpEnabled = true
            saveSettings()
            _G.__AW_NOTIFY("Jump = "..n)
