local function refreshFloatVisual(def)
    local data = floatButtons[def.id]
    if not data or not data.btn or not data.btn.Parent then return end
    local isOn = false
    if def.type == "toggle" then isOn = state[def.key] and true or false end
    local ringCol, txtCol, strkCol
    if def.type ~= "toggle" then
        ringCol = def.color or THEME.accent
        txtCol = THEME.text
        strkCol = Color3.new(0,0,0)
    elseif isOn then
        ringCol = THEME.accent
        txtCol = Color3.new(0,0,0)
        strkCol = Color3.new(1,1,1)
    else
        ringCol = Color3.new(1,1,1)
        txtCol = THEME.text
        strkCol = Color3.new(0,0,0)
    end
    if data.outerStroke then data.outerStroke.Color = ringCol end
    if data.inner then data.inner.Color = ringCol end
    data.btn.TextColor3 = txtCol
    data.btn.TextStrokeColor3 = strkCol
