            if d < sh then sh = d; cl = c end
        end
        if not cl then cancelFarmTween(); continue end
        local d = (r.Position - cl.Position).Magnitude
        if d <= 7 then collectCoin(r, cl) end
        if currentFarmTween and currentFarmTween.PlaybackState == Enum.PlaybackState.Playing and currentTargetCoin == cl then
            collectCoin(r, cl); continue
        end
        cancelFarmTween(); currentTargetCoin = cl
        local tp = cl.Position + Vector3.new(0, -UNDER, 0)
        local tc = CFrame.new(tp) * CFrame.Angles(math.rad(90), 0, math.rad(180))
        local dur = math.clamp(d / TWEEN_SPEED, 0.05, 3.3)
        currentFarmTween = TweenService:Create(r, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame = tc})
        currentFarmTween:Play()
        farmVelocityConn = RunService.Heartbeat:Connect(function()
            if not r or not r.Parent then cancelFarmTween(); return end
            r.AssemblyLinearVelocity = Vector3.zero; r.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end)

