        track.Priority = Enum.AnimationPriority.Action
        track.Looped = true
        track:Play()
        cfg.track = track
        cfg.stopped = track.Stopped:Connect(function()
            if cfg.on then task.wait(0.1) playHeadless(cfg) end
        end)
    end
    local keys = {"headless1", "headless2", "headless3"}
