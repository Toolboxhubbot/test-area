            if rt then rt.Anchored = true; rt.CFrame = CFrame.new(VOTE_SPOTS[i]); task.wait(0.15); rt.Anchored = false end
            task.wait(0.25)
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if h then h.Health = 0 end
