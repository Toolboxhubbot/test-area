local function staggerFade(p)
    local children = {}
    for _, c in ipairs(p:GetChildren()) do
        if c:IsA("GuiObject") and c.Visible ~= false then table.insert(children, c) end
    end
    for i, c in ipairs(children) do
        local sb = c.BackgroundTransparency
        local stt = nil
        if c:IsA("TextLabel") or c:IsA("TextButton") then stt = c.TextTransparency; c.TextTransparency = 1 end
        if c:IsA("Frame") or c:IsA("TextButton") then c.BackgroundTransparency = 1 end
        task.delay(i * 0.02, function()
            if not c.Parent then return end
            if c:IsA("Frame") or c:IsA("TextButton") then
                TweenService:Create(c, TweenInfo.new(0.4, Enum.EasingStyle.Back), {BackgroundTransparency=sb}):Play()
            end
            if stt then TweenService:Create(c, TweenInfo.new(0.4), {TextTransparency=stt}):Play() end
        end)
    end
end
local function startPulse(g, isOn)
    task.spawn(function()
        while g.Parent do
            if isOn() then
                TweenService:Create(g, TweenInfo.new(1.2, Enum.EasingStyle.Sine), {BackgroundTransparency=0.55}):Play()
                task.wait(1.2)
                if not g.Parent then break end
                TweenService:Create(g, TweenInfo.new(1.2, Enum.EasingStyle.Sine), {BackgroundTransparency=0.92}):Play()
                task.wait(1.2)
            else task.wait(0.5) end
        end
    end)
end

