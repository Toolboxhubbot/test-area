-- Role detection
local cachedRoleModule, cachedRoleModuleAt = nil, 0
local function getCachedRoleData()
    local now = tick()
    if cachedRoleModule and (now - cachedRoleModuleAt) < 2 then return cachedRoleModule end
    local ok, data = pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        if mods then
            local pd = mods:FindFirstChild("PlayerData") or mods:FindFirstChild("Roles") or mods:FindFirstChild("RoleData") or mods:FindFirstChild("RoundData")
            if pd then return require(pd) end
        end
        local direct = ReplicatedStorage:FindFirstChild("PlayerData") or ReplicatedStorage:FindFirstChild("Roles")
        if direct then return require(direct) end
    end)
    if ok and type(data) == "table" then
        cachedRoleModule = data
        cachedRoleModuleAt = now
        return data
    end
    local rf = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
