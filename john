local LOBBY=CFrame.new(14.47,516.73,-25.34)
local VOID=CFrame.new(0,-300,0)
local function tpLobby() local r=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") if r then r.CFrame=LOBBY end end
local function tpVoid() local r=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") if r then r.Anchored=true; r.CFrame=VOID; task.wait(0.05); r.Anchored=false end end
local function getMap() for _,m in ipairs(W:GetChildren()) do if m:FindFirstChild("CoinContainer") or m.Name=="CoinContainer" then return m end end end
local function mapCenter()
local mf=getMap(); if not mf then return nil end
for _,d in ipairs(mf:GetDescendants()) do if d:IsA("SpawnLocation") and d.Enabled~=false then return d.Position+Vector3.new(0,5,0) end end
if mf:IsA("Model") then local ok,cf,sz=pcall(function() local c,s=mf:GetBoundingBox(); return c,s end) if ok and cf then return cf.Position+Vector3.new(0,sz.Y*0.5+8,0) end end
local sum,cnt=Vector3.zero,0
for _,d in ipairs(mf:GetDescendants()) do if d:IsA("BasePart") and d.Name~="CoinContainer" then sum=sum+d.Position; cnt=cnt+1 end end
if cnt>0 then return sum/cnt+Vector3.new(0,25,0) end
end
local function tpMap()
local r=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
if not r then return end
local mf=getMap(); if not mf then _G.__AW_NOTIFY("No map") return end
local tp=mapCenter(); if not tp then _G.__AW_NOTIFY("No spot") return end
r.Anchored=true; r.CFrame=CFrame.new(tp+Vector3.new(0,200,0)); task.wait(0.1); r.Anchored=false
task.wait(0.15)
local ray=RaycastParams.new(); ray.FilterDescendantsInstances={LP.Character}; ray.FilterType=Enum.RaycastFilterType.Exclude
local hit=W:Raycast(r.Position,Vector3.new(0,-1000,0),ray)
if hit then r.Anchored=true; r.CFrame=CFrame.new(hit.Position+Vector3.new(0,4,0)); task.wait(0.1); r.Anchored=false; r.AssemblyLinearVelocity=Vector3.zero end
_G.__AW_NOTIFY("Teleported: "..mf.Name)
