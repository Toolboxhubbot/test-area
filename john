local function getGuiParent()
    local ok, g = pcall(function()
        if gethui then return gethui() end
        if syn and syn.protect_gui then
            local c = Instance.new("Folder"); c.Name = "PGC"
            syn.protect_gui(c); c.Parent = CoreGui
            return c
        end
        if CoreGui:FindFirstChild("RobloxGui") then return CoreGui end
        return LP:WaitForChild("PlayerGui", 5)
    end)
    if ok and g then return g end
    return LP:FindFirstChild("PlayerGui") or CoreGui
end

