-- ============ LOOP TELEPORT SYSTEM ============
local lastLoopTPTime = 0
task.spawn(function()
    while true do
        task.wait(0.5)
        if state.loopTPEnabled and alive() then
            local targetPos = nil
            local tgt = state.loopTPTarget or "map"
            if tgt == "map" then
                -- Grab the current map spawn
                for _, m in ipairs(Workspace:GetChildren()) do
                    if m:FindFirstChild("CoinContainer") or m.Name == "CoinContainer" then
                        for _, d in ipairs(m:GetDescendants()) do
                            if d:IsA("SpawnLocation") and d.Enabled ~= false then targetPos = d.Position + Vector3.new(0,5,0); break end
                        end
                        if not targetPos and m:IsA("Model") then
                            local ok, cf = pcall(function() return m:GetBoundingBox() end)
                            if ok and cf then targetPos = cf.Position + Vector3.new(0, 25, 0) end
                        end
                        break
                    end
                end
            elseif tgt == "lobby" then
                targetPos = LOBBY_CFRAME.Position
            elseif tgt == "void" then
                targetPos = VOID_POS
            elseif tgt == "custom" then
                for _, n in ipairs(settingsConfig.flingList) do
                    for _, p in ipairs(Players:GetPlayers()) do
                        if playerMatchesName(p, n) then
                            local tr = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                            if tr then targetPos = tr.Position + Vector3.new(0, 3, 0) end
                        end
                    end
                    if targetPos then break end
                end
            end
            if targetPos and tick() - lastLoopTPTime > 0.4 then
                local r = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if r and (r.Position - targetPos).Magnitude > 10 then
                    lastLoopTPTime = tick()
                    r.CFrame = CFrame.new(targetPos)
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
    end
end)

-- ============ REMOVE BARRIERS (per round) ============
local lastBarrierRound = false
task.spawn(function()
    while true do
        task.wait(0.5)
        local inRoundNow = isInRound()
        if inRoundNow and not lastBarrierRound then
            -- New round started: reset removeBarriers gate
            lastBarrierRound = true
        elseif not inRoundNow and lastBarrierRound then
            lastBarrierRound = false
        end
        if state.removeBarriers and inRoundNow then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj and obj.Parent and obj.Name then
                    local n = string.lower(obj.Name)
                    if n == "glitchproof" or n == "glitch" or n == "thicc" then
                        pcall(function() obj:Destroy() end)
                    end
                end
            end
        end
    end
end)

