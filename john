local function autoStabKill(target, size)
    if not target or not target.Parent or target == LP then return false end
    if not targetIsAlive(target) then return false end
    local ch = target.Character
    if not ch then return false end
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    size = size or 2000
    local origSize = hrp.Size
    local origTrans = hrp.Transparency
    local origCanCollide = hrp.CanCollide
    local knife = findTool("Knife") or equipTool("Knife")
    if not knife then return false end
    task.wait(0.03)
    knife = findTool("Knife") or knife
    if not knife then return false end
    pcall(function()
        hrp.Size = Vector3.new(size, size, size)
        hrp.Transparency = 1
        hrp.CanCollide = false
    end)
    local startTime = tick()
    while tick() - startTime < 1.0 do
        if not targetIsAlive(target) then break end
        local k = findTool("Knife")
        if not k then k = equipTool("Knife") end
        if k then
            local handle = k:FindFirstChild("Handle")
            pcall(function() k:Activate() end)
            if handle and hrp and hrp.Parent then
                pcall(function()
                    firetouchinterest(hrp, handle, 0)
                    firetouchinterest(hrp, handle, 1)
                end)
            end
        end
        pcall(function()
            if hrp and hrp.Parent then
                hrp.Size = Vector3.new(size, size, size)
                hrp.Transparency = 1
                hrp.CanCollide = false
            end
        end)
        task.wait(0.04)
    end
    task.wait(0.05)
    pcall(function()
        if hrp and hrp.Parent then
            hrp.Size = origSize
            hrp.Transparency = origTrans
            hrp.CanCollide = origCanCollide
        end
    end)
    return true
end

