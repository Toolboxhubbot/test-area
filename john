local function attachGlow(inst, color, strength)
    if not inst then return end
    color = color or Color3.fromRGB(settingsConfig.accentColor.r, settingsConfig.accentColor.g, settingsConfig.accentColor.b)
    strength = strength or 1
    local existing = inst:FindFirstChild("AW_Glow")
    if existing then existing:Destroy() end
    local glow = Instance.new("ImageLabel", inst)
    glow.Name = "AW_Glow"
    glow.BackgroundTransparency = 1
    glow.Image = "rbxassetid://5028857084"
    glow.ImageColor3 = color
    glow.ImageTransparency = 0.35 / strength
    glow.ScaleType = Enum.ScaleType.Slice
    glow.SliceCenter = Rect.new(24, 24, 276, 276)
    glow.Size = UDim2.new(1, 24, 1, 24)
    glow.Position = UDim2.new(0.5, 0, 0.5, 0)
    glow.AnchorPoint = Vector2.new(0.5, 0.5)
    glow.ZIndex = (inst.ZIndex or 1) - 1
    glow.Active = false
    task.spawn(function()
        while glow and glow.Parent do
            if state.animationsEnabled == false then
                glow.ImageTransparency = 0.35 / strength
                task.wait(0.5)
            else
                TweenService:Create(glow, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                    {ImageTransparency = 0.65 / strength}):Play()
                task.wait(1.6)
                if not glow or not glow.Parent then break end
                TweenService:Create(glow, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                    {ImageTransparency = 0.35 / strength}):Play()
                task.wait(1.6)
            end
        end
    end)
end

task.spawn(function()
    local rot = 0
    local wobbleT = 0
    while true do
        local dt = RunService.Heartbeat:Wait()
        if state.animationsEnabled == false then
            for i = #spinGradients, 1, -1 do
                local g = spinGradients[i]
                if not g or not g.Parent then table.remove(spinGradients, i) end
            end
        else
            wobbleT = wobbleT + dt
            local wobble = 1 + math.sin(wobbleT * 1.4) * 0.15
            rot = (rot + dt * SPIN_SPEED * wobble) % 360
            for i = #spinGradients, 1, -1 do
                local g = spinGradients[i]
                if g and g.Parent then g.Rotation = rot
                else table.remove(spinGradients, i) end
            end
        end
    end
end)

local function attachBounce(b)
    if state.animationsEnabled == false then return end
    local s = Instance.new("UIScale", b)
    b.MouseButton1Down:Connect(function()
        TweenService:Create(s, TweenInfo.new(0.09, EASE_SMOOTH, EASE_OUT), {Scale=0.94}):Play()
    end)
    local function r()
        TweenService:Create(s, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, EASE_OUT), {Scale=1}):Play()
    end
    b.MouseButton1Up:Connect(r)
    b.MouseLeave:Connect(r)
end

local function attachRipple(b, c)
    if state.animationsEnabled == false then return end
    c = c or Color3.new(1,1,1)
    b.ClipsDescendants = true
    b.MouseButton1Down:Connect(function()
        local pos = b.AbsolutePosition
        local sz = b.AbsoluteSize
        local m = UIS:GetMouseLocation()
        local relX = m.X - pos.X
        local relY = m.Y - pos.Y
        local f = Instance.new("Frame", b)
        f.AnchorPoint = Vector2.new(0.5,0.5)
        f.Position = UDim2.new(0, relX, 0, relY)
        f.Size = UDim2.new(0,0,0,0)
        f.BackgroundColor3 = c
        f.BackgroundTransparency = 0.4
        f.BorderSizePixel = 0
        f.ZIndex = (b.ZIndex or 1)+5
        f.Active = false
        Instance.new("UICorner", f).CornerRadius = UDim.new(1,0)
        local maxR = math.max(sz.X - relX, relX, sz.Y - relY, relY) * 2.2
        TweenService:Create(f, TweenInfo.new(0.75, EASE_SMOOTH, EASE_OUT), {Size=UDim2.new(0,maxR*2,0,maxR*2), BackgroundTransparency=1}):Play()
        task.delay(0.85, function() if f and f.Parent then f:Destroy() end end)
    end)
end

local function attachShine(b)
    if state.animationsEnabled == false then return end
    b.ClipsDescendants = true
    local s = Instance.new("Frame", b)
    s.Size = UDim2.new(0,40,1.6,0)
    s.Position = UDim2.new(-0.4,0,-0.3,0)
    s.BackgroundColor3 = Color3.new(1,1,1)
    s.BackgroundTransparency = 0.82
    s.Rotation = 12
    s.BorderSizePixel = 0
    s.ZIndex = (b.ZIndex or 1)+2
    s.Active = false
    local running = false
    b.MouseEnter:Connect(function()
        if running then return end
        running = true
        s.Position = UDim2.new(-0.4,0,-0.3,0)
        TweenService:Create(s, TweenInfo.new(0.7, EASE_SMOOTH, EASE_OUT), {Position=UDim2.new(1.4,0,-0.3,0)}):Play()
        task.delay(0.75, function() running = false end)
    end)
end

local function staggerFade(p)
    if state.animationsEnabled == false then return end
    local ch = {}
    for _, c in ipairs(p:GetChildren()) do
        if c:IsA("GuiObject") and c.Visible ~= false and not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
            table.insert(ch, c)
        end
    end
    for i, c in ipairs(ch) do
        local sb = c.BackgroundTransparency
        local stt = nil
        if c:IsA("TextLabel") or c:IsA("TextButton") or c:IsA("TextBox") then
            stt = c.TextTransparency; c.TextTransparency = 1
        end
        if c:IsA("Frame") or c:IsA("TextButton") then c.BackgroundTransparency = 1 end
        local origPos = c.Position
        c.Position = origPos + UDim2.new(0, 10, 0, 0)
        task.delay(i * 0.02, function()
            if not c.Parent then return end
            if c:IsA("Frame") or c:IsA("TextButton") then
                TweenService:Create(c, TweenInfo.new(0.5, EASE_BOUNCE, EASE_OUT), {BackgroundTransparency=sb, Position=origPos}):Play()
            end
            if stt then TweenService:Create(c, TweenInfo.new(0.4, EASE_SOFT), {TextTransparency=stt}):Play() end
        end)
    end
end

