-- ==================== VIRTUAL MOVEMENT (invisible mode) ====================
RunService.RenderStepped:Connect(function(dt)
    if not invisActive then return end
    if not invisVirtualPos then return end

    local cam = Workspace.CurrentCamera
    if not cam then return end

    local moveVec = Vector3.zero

    local playerModule = LP.PlayerScripts:FindFirstChild("PlayerModule")
    if playerModule then
        pcall(function()
            local controls = require(playerModule):GetControls()
            local mv = controls:GetMoveVector()
            if mv and mv.Magnitude > 0.05 then
                moveVec = moveVec + mv
            end
        end)
    end

    if UIS.KeyboardEnabled then
        if UIS:IsKeyDown(Enum.KeyCode.W) then moveVec = moveVec + Vector3.new(0, 0, -1) end
        if UIS:IsKeyDown(Enum.KeyCode.S) then moveVec = moveVec + Vector3.new(0, 0, 1) end
        if UIS:IsKeyDown(Enum.KeyCode.A) then moveVec = moveVec + Vector3.new(-1, 0, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.D) then moveVec = moveVec + Vector3.new(1, 0, 0) end
    end

    local camLook = cam.CFrame.LookVector
    local camRight = cam.CFrame.RightVector
    camLook = Vector3.new(camLook.X, 0, camLook.Z)
    camRight = Vector3.new(camRight.X, 0, camRight.Z)
    if camLook.Magnitude > 0 then camLook = camLook.Unit end
    if camRight.Magnitude > 0 then camRight = camRight.Unit end

    local worldMove = camRight * moveVec.X + camLook * -moveVec.Z
    if worldMove.Magnitude > 1 then worldMove = worldMove.Unit end

    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    local speed = hum and hum.WalkSpeed or 16

    invisVirtualVel = Vector3.new(worldMove.X * speed, invisVirtualVel.Y, worldMove.Z * speed)

    local GRAVITY = 196.2
    invisVirtualVel = invisVirtualVel + Vector3.new(0, -GRAVITY * dt, 0)

    local wantJump = false
    if UIS.KeyboardEnabled and UIS:IsKeyDown(Enum.KeyCode.Space) then wantJump = true end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local exclude = {}
    if LP.Character then table.insert(exclude, LP.Character) end
    if ghostFolder then table.insert(exclude, ghostFolder) end
    rayParams.FilterDescendantsInstances = exclude

    local origin = invisVirtualPos + Vector3.new(0, 2, 0)
    local groundHit = Workspace:Raycast(origin, Vector3.new(0, -50, 0), rayParams)
    local groundY = groundHit and groundHit.Position.Y or nil

    local halfHeight = 2.5
    local newPos = invisVirtualPos + invisVirtualVel * dt

    if groundY and newPos.Y - halfHeight <= groundY then
        newPos = Vector3.new(newPos.X, groundY + halfHeight, newPos.Z)
        if wantJump then
            invisVirtualVel = Vector3.new(invisVirtualVel.X, 45, invisVirtualVel.Z)
        else
            invisVirtualVel = Vector3.new(invisVirtualVel.X, 0, invisVirtualVel.Z)
        end
    end

    invisVirtualPos = newPos

    if ghostModel and ghostModel.PrimaryPart then
        local facing = camLook
        if facing.Magnitude < 0.01 then facing = Vector3.new(0, 0, -1) end
        local ghostCF = CFrame.lookAt(invisVirtualPos, invisVirtualPos + facing)
        pcall(function() ghostModel:PivotTo(ghostCF) end)
    end

    if LP.Character then
        local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = HIDE_POS
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end
end)

