local function saveSettings()
    task.spawn(function()
        pcall(function()
            local d={state={},settings={}}
            for k,v in pairs(state) do
                if not NSK[k] then
                    local t=type(v)
                    if t=="number" or t=="string" or t=="boolean" or t=="table" then d.state[k]=v end
                end
            end
            for k,v in pairs(SC) do
                local t=type(v)
                if t=="number" or t=="string" or t=="boolean" or t=="table" then d.settings[k]=v end
            end
            if writefile then writefile(cfgPath(),HttpService:JSONEncode(d)) end
        end)
    end)
end

local function loadSettings()
    pcall(function()
        if isfile and isfile(cfgPath()) and readfile then
            local d=HttpService:JSONDecode(readfile(cfgPath()))
            if d.state then
                for k,v in pairs(d.state) do
                    if state[k]~=nil and not NSK[k] then
                        local t=type(v)
                        if t=="boolean" then
                            state[k]=false -- force everything to start off
                        else
                            state[k]=v
                        end
                    end
                end
            end
            if d.settings then
                for k,v in pairs(d.settings) do
                    if SC[k]~=nil then SC[k]=v end
                end
            end
        end
    end)
end
