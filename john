    end
end)

-- UNLOAD (turns off EVERYTHING including ESP)
_G.ApplewareUnload = function()
    _G.ApplewareActive = false
    _G.ApplewareLoaded = false

    -- turn off every feature explicitly
    for k, v in pairs(state) do
        if type(v) == "boolean" then
            state[k] = false
        end
    end

    -- reset character
    pcall(function()
        local ch = LP.Character
        if ch then
            local h = ch:FindFirstChildOfClass("Humanoid")
            if h then
                h.PlatformStand = false
                h.WalkSpeed = 16
                h.JumpPower = 50
                h.UseJumpPower = false
                h.AutoRotate = true
            end
            local r = ch:FindFirstChild("HumanoidRootPart")
            if r then
                r.Anchored = false
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end
            -- remove invisibility
            for _, d in ipairs(ch:GetDescendants()) do
                if d:IsA("BasePart") or d:IsA("Decal") then
                    pcall(function() d.Transparency = 0 end)
                end
            end
            -- remove hitboxes
            local hb = ch:FindFirstChild("AW_Hitbox")
            if hb then pcall(function() hb:Destroy() end) end
        end
    end)

    -- stop fly body movers
    if flyConn then pcall(function() flyConn:Disconnect() end) end
    if flyBV and flyBV.Parent then pcall(function() flyBV:Destroy() end) end
    if flyBG and flyBG.Parent then pcall(function() flyBG:Destroy() end) end

    -- clear ESP
    pcall(function()
        for p, e in pairs(EC) do
            if e then
                if e.hl then pcall(function() e.hl:Destroy() end) end
                if e.bb then pcall(function() e.bb:Destroy() end) end
            end
        end
        EC = {}
        for k, v in pairs(GC2) do
            if v then
                if v.hl then pcall(function() v.hl:Destroy() end) end
                if v.bb then pcall(function() v.bb:Destroy() end) end
            end
        end
        GC2 = {}
    end)

    -- clear floating buttons
    pcall(function()
        for _, d in pairs(FBs) do
            if d.btn and d.btn.Parent then pcall(function() d.btn:Destroy() end) end
            if d.outer and d.outer.Parent then pcall(function() d.outer:Destroy() end) end
        end
        FBs = {}
    end)

    -- destroy all GUI
    local gn = {"AWNotes", "AWRT", "AW_BigShoot", "AW_FloatingActions", "Appleware", "AW_EmoteFloats", "AW_FPS_Ping", "AW_ESP", "AW_ReloadPrompt", "AW_PrivateChat", "AW_WhatsNew"}
    local function KG(par)
        for _, n in ipairs(gn) do
            local g = par:FindFirstChild(n)
            if g then pcall(function() g:Destroy() end) end
        end
    end
    pcall(KG, CoreGui)
    pcall(KG, PlayerGui)

    -- destroy workspace objects
    for _, n in ipairs({"AW_VoidPlatform", "invischair"}) do
        local o = workspace:FindFirstChild(n)
        if o then pcall(function() o:Destroy() end) end
    end

    -- reset invis state
    dodgeActive = false
    invisApplied = false

    print("[Appleware] Unloaded.")
end

