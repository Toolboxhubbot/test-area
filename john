local function getGuiParent()
    local success, gui = pcall(function()
        if gethui then return gethui()
        elseif syn and syn.protect_gui then
            local c = Instance.new("Folder"); c.Name = "ProtectedGuiContainer"
            syn.protect_gui(c); c.Parent = CoreGui; return c
        elseif CoreGui:FindFirstChild("RobloxGui") then return CoreGui end
        return LP:WaitForChild("PlayerGui", 5)
    end)
    if success and gui then return gui end
    return LP:FindFirstChild("PlayerGui") or CoreGui
end

