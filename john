    local dead = (not h) or h.Health <= 0
    local role = "Innocent"
    if not dead then pcall(function() role = getPlayerRole(plr) end) end
    local col
    if dead then col = Color3.fromRGB(150, 150, 150)
    elseif state.espTeamColor then col = roleColor(role)
    else col = Color3.fromRGB(255, 255, 255) end

    local master = state.espPlayers
    local cam = Workspace.CurrentCamera
    local dist = 0
    if cam then dist = (cam.CFrame.Position - hrp.Position).Magnitude end
    local inFOV = dist <= (state.espFOV or 3000)

    if e.hl then
        e.hl.Enabled = master and state.espChams and inFOV and not dead
        e.hl.Adornee = ch
        e.hl.FillColor = col
        e.hl.FillTransparency = 0.55
        e.hl.OutlineColor = col
        e.hl.OutlineTransparency = 0.1
    end
    if e.bb then
        e.bb.Enabled = master and inFOV and (state.espName or state.espDistance or state.espHealthBar)
        e.bb.Adornee = hrp
        if e.nameLbl then
            e.nameLbl.Visible = state.espName
            if dead then e.nameLbl.Text = plr.Name .. " [Dead]"
            else e.nameLbl.Text = plr.Name .. " [" .. role .. "]" end
            e.nameLbl.TextColor3 = col
        end
        if e.distLbl then
            e.distLbl.Visible = state.espDistance
            e.distLbl.Text = string.format("[%d studs]", math.floor(dist))
        end
        if e.hpBg and e.hpFill then
            e.hpBg.Visible = state.espHealthBar
            local hpRatio = 0
            if h and h.MaxHealth > 0 then hpRatio = math.clamp(h.Health / h.MaxHealth, 0, 1) end
            e.hpFill.Size = UDim2.new(hpRatio, 0, 1, 0)
            if hpRatio > 0.5 then e.hpFill.BackgroundColor3 = Color3.fromRGB(90, 220, 90)
            elseif hpRatio > 0.25 then e.hpFill.BackgroundColor3 = Color3.fromRGB(255, 200, 80)
            else e.hpFill.BackgroundColor3 = Color3.fromRGB(255, 80, 80) end
        end
    end
    if e.boxFrame then
        local boxOn = master and state.espBox and inFOV
        e.boxFrame.Visible = boxOn
        if boxOn and cam then
            local okBB, cfBB, sizeBB = pcall(function() return ch:GetBoundingBox() end)
            if okBB and cfBB then
                local top = cfBB * CFrame.new(0, sizeBB.Y / 2, 0)
                local bottom = cfBB * CFrame.new(0, -sizeBB.Y / 2, 0)
                local ts, tOn = cam:WorldToViewportPoint(top.Position)
                local bs, bOn = cam:WorldToViewportPoint(bottom.Position)
                if tOn and bOn and ts.Z > 0 and bs.Z > 0 then
                    local height = math.abs(bs.Y - ts.Y)
                    local width = height * 0.55
                    e.boxFrame.Position = UDim2.new(0, ts.X - width / 2, 0, ts.Y)
                    e.boxFrame.Size = UDim2.new(0, width, 0, height)
                    e.boxFrame.BorderColor3 = col
                else
                    e.boxFrame.Visible = false
                end
            end
        end
    end
    if e.tracer then
        local tracerOn = master and state.espTracer and inFOV
        if tracerOn and cam then
            local sp, onScreen = cam:WorldToViewportPoint(hrp.Position)
            if onScreen and sp.Z > 0 then
                e.tracer.BackgroundColor3 = col
                local vps = cam.ViewportSize
                drawLine(e.tracer, Vector2.new(vps.X * 0.5, vps.Y),
                    Vector2.new(sp.X, sp.Y), state.espTracerThick or 2)
            else
                e.tracer.Visible = false
            end
        else
            e.tracer.Visible = false
        end
    end
end

