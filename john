    local lastMurdUserId = nil
    local lastPerk = nil
    while true do
        task.wait(0.2)
        if not isInRound() then
            nS = false
            lastMurdUserId = nil
            lastPerk = nil
        else
            local m = findPlayerByRole("Murderer")
            if state.murdererPredictor and m and m.UserId ~= lastMurdUserId then
                lastMurdUserId = m.UserId
                notify('<font color="#ff5a5a"><b>Murderer:</b></font> ' .. m.Name)
            end
            if not nS then
                local s = findPlayerByRole("Sheriff") or findPlayerByRole("Hero")
                if s then
                    nS = true
                    notify('<font color="#5aaaFF"><b>Sheriff:</b></font> ' .. s.Name)
                end
            end
            if state.murdererPerkNotify and m then
                local perk = detectMurdererPerk(m)
                if perk and perk ~= lastPerk then
                    lastPerk = perk
                    notify('<font color="#ffcc66"><b>Murderer Perk:</b></font> ' .. tostring(perk))
                end
            end
        end
    end
end)

task.spawn(function()
