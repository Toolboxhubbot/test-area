local bigDrag=nil
bigBtn.InputBegan:Connect(function(input)
    if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
    bigDrag={input=input,start=input.Position,startPos=bigWrap.Position,moved=false}
end)
UIS.InputChanged:Connect(function(input)
    if not bigDrag or input~=bigDrag.input then return end
    if input.UserInputType~=Enum.UserInputType.MouseMovement and input.UserInputType~=Enum.UserInputType.Touch then return end
    local d=input.Position-bigDrag.start
    if d.Magnitude>8 then bigDrag.moved=true end
    if bigDrag.moved then
        bigWrap.Position=UDim2.new(bigDrag.startPos.X.Scale,bigDrag.startPos.X.Offset+d.X,bigDrag.startPos.Y.Scale,bigDrag.startPos.Y.Offset+d.Y)
    end
end)
UIS.InputEnded:Connect(function(input)
    if not bigDrag or input~=bigDrag.input then return end
    local d=bigDrag
    bigDrag=nil
    if not d.moved then
        state.bigButtonX=bigWrap.Position.X.Scale
        state.bigButtonY=bigWrap.Position.Y.Scale
        runShootWorkflow()
    else
        state.bigButtonX=bigWrap.Position.X.Scale
        state.bigButtonY=bigWrap.Position.Y.Scale
        saveSettings()
    end
end)

