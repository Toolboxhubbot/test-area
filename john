                        wallHopInfJump = true
                        -- Wall hop flick: only flick when pressing space AND on cooldown expired
                        if state.wallHopFlick and UIS:IsKeyDown(Enum.KeyCode.Space) and not flicking and tick() > flickCooldown then
                            flicking = true
                            flickCooldown = tick() + 0.35
                            local cam = Workspace.CurrentCamera
                            if cam then
                                local scf = cam.CFrame
                                local flatNormal = Vector3.new(hit.Normal.X, 0, hit.Normal.Z)
                                if flatNormal.Magnitude > 0.1 then
                                    flatNormal = flatNormal.Unit
                                    local newCF = CFrame.lookAt(cam.CFrame.Position, cam.CFrame.Position + flatNormal * 10)
                                    cam.CFrame = newCF
                                    task.wait(0.09)
                                    if cam then cam.CFrame = scf end
                                end
                            end
                            task.wait(0.05)
                            flicking = false
                        end
                    end
                end
            end
        end
    end)
    UIS.JumpRequest:Connect(function()
        if not LP.Character then return end
        local h = LP.Character:FindFirstChildOfClass("Humanoid")
        if not h then return end
        if state.infJumpEnabled or wallHopInfJump then
            pcall(function() h:ChangeState(Enum.HumanoidStateType.Jumping) end)
        end
    end)
end

