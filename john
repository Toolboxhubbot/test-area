-- ============ SILENT AIM ============
local SHOT_COOLDOWN=0.4
local lastShotTime=-SHOT_COOLDOWN
local function canFire() return (tick()-lastShotTime)>=SHOT_COOLDOWN end

local function getGun()
    local char=LP.Character
    local bp=LP:FindFirstChild("Backpack")
    for _,name in ipairs(GUN_NAMES) do
        if char and char:FindFirstChild(name) then return char[name] end
        if bp and bp:FindFirstChild(name) then return bp[name] end
    end
    return nil
end
local function findShootRemote()
    local gun=getGun()
    if gun then
        local shoot=gun:FindFirstChild("Shoot",true)
        if shoot and (shoot:IsA("RemoteEvent") or shoot:IsA("RemoteFunction")) then return shoot end
    end
    local paths={
        {ReplicatedStorage,"Remotes","Gameplay","GunHit"},
        {ReplicatedStorage,"Remotes","Gameplay","ShootGun"},
        {ReplicatedStorage,"Remotes","ShootGun"},
        {ReplicatedStorage,"ShootGun"},
    }
    for _,path in ipairs(paths) do
        local cur=path[1]
        local ok=true
        for i=2,#path do
            cur=cur and cur:FindFirstChild(path[i])
            if not cur then ok=false break end
        end
        if ok and cur and (cur:IsA("RemoteEvent") or cur:IsA("RemoteFunction")) then return cur end
    end
    return nil
end
local function getTargetPart()
    local murd=getMurd()
    if not murd or not murd.Character then return nil end
    return murd.Character:FindFirstChild("Head") or murd.Character:FindFirstChild("HumanoidRootPart")
end
local function hasClearShot(targetPart)
    if not state.silentAimWallCheck then return true end
    if not targetPart then return true end
    local cam=Workspace.CurrentCamera
    if not cam then return true end
    local origin=cam.CFrame.Position
    local dir=targetPart.Position-origin
    local rp=RaycastParams.new()
    local ignore={}
    if LP.Character then table.insert(ignore,LP.Character) end
    if targetPart.Parent then table.insert(ignore,targetPart.Parent) end
    rp.FilterDescendantsInstances=ignore
    rp.FilterType=Enum.RaycastFilterType.Exclude
    local res=Workspace:Raycast(origin,dir,rp)
    return res==nil
end

local function fireSilentAtMurderer()
    if not canFire() then return false end
    local part=getTargetPart()
    if not part then return false end
    if not state.shootThroughWall and not hasClearShot(part) then return false end
    lastShotTime=tick()
    local remote=findShootRemote()
    if not remote then return false end
    local targetCF=part.CFrame
    local aimCF=CFrame.new(part.Position+Vector3.new(0,1.5,0))
    local originCF=Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame or targetCF
    pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(originCF,targetCF)
            remote:FireServer(aimCF,targetCF)
            remote:FireServer(targetCF)
            local hum=part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
            if hum then remote:FireServer(hum) end
        else
            remote:InvokeServer(originCF,targetCF)
            remote:InvokeServer(nil,part.Position)
            remote:InvokeServer(part.Position)
        end
    end)
    return true
end
local function fireThroughWall()
    if not canFire() then return false end
    local murd=getMurd()
    if not murd or not murd.Character then return false end
    local root=murd.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local remote=findShootRemote()
    if not remote then return false end
    lastShotTime=tick()
    local targetCF=root.CFrame
    local originCF=CFrame.new(targetCF.Position+Vector3.new(0,3,0))
    pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(originCF,targetCF)
