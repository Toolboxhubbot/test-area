local fpsBoostMaid = nil
applyFpsBoost = function(en)
    pcall(function()
        if en then
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            local function p(v)
                if v:IsA("BasePart") then
                    v.CastShadow = false
                    v.Material = Enum.Material.SmoothPlastic
                    v.Reflectance = 0
                elseif v:IsA("Decal") or v:IsA("Texture") then
                    v.Transparency = 1
                elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
                    v.Enabled = false
                end
            end
            for _, v in ipairs(Workspace:GetDescendants()) do p(v) end
            if not fpsBoostMaid then
                fpsBoostMaid = Workspace.DescendantAdded:Connect(function(v)
                    if state.fpsBoost then p(v) end
                end)
            end
        else
            Lighting.GlobalShadows = true
            if fpsBoostMaid then fpsBoostMaid:Disconnect(); fpsBoostMaid = nil end
        end
    end)
end

