        ib.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        ib.Text = tostring(iv)
        ib.TextColor3 = ACC
        ib.Font = Enum.Font.Gotham
        ib.TextSize = 11 * fm
        ib.ClearTextOnFocus = false
        Instance.new("UICorner", ib).CornerRadius = R(6)
        local tr = Instance.new("Frame", row)
        tr.Size = UDim2.new(1, -28 * selectedScale, 0, 8 * selectedScale)
        tr.Position = UDim2.new(0, 14 * selectedScale, 1, -18 * selectedScale)
        tr.BackgroundColor3 = BORD
        Instance.new("UICorner", tr).CornerRadius = UDim.new(1, 0)
        local fl = Instance.new("Frame", tr)
        fl.Size = UDim2.new((iv - minV) / (maxV - minV), 0, 1, 0)
        fl.BackgroundColor3 = ACC
        Instance.new("UICorner", fl).CornerRadius = UDim.new(1, 0)
        local kn = Instance.new("Frame", tr)
        kn.Size = UDim2.new(0, 16 * selectedScale, 0, 16 * selectedScale)
        kn.Position = UDim2.new((iv - minV) / (maxV - minV), 0, 0.5, -8 * selectedScale)
        kn.BackgroundColor3 = TXT
        Instance.new("UICorner", kn).CornerRadius = UDim.new(1, 0)
        local drag = false
        local function update(inp)
            local mx = inp.Position.X
            local tp = tr.AbsolutePosition.X
            local ts = tr.AbsoluteSize.X
            if ts == 0 then return end
            local p = math.clamp((mx - tp) / ts, 0, 1)
            local v = math.floor(minV + (maxV - minV) * p + 0.5)
            if sK then state[sK] = v end
            ib.Text = tostring(v)
            fl.Size = UDim2.new(p, 0, 1, 0)
            kn.Position = UDim2.new(p, 0, 0.5, -8 * selectedScale)
            if onChange then onChange(v) end
            if sK then saveSettings() end
        end
        tr.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                drag = true
                update(inp)
            end
        end)
        UIS.InputChanged:Connect(function(inp)
            if drag then update(inp) end
        end)
        UIS.InputEnded:Connect(function() drag = false end)
        ib.FocusLost:Connect(function()
            local v = tonumber(ib.Text)
            if v then
                v = math.clamp(v, minV, maxV)
                if sK then state[sK] = v end
                ib.Text = tostring(v)
                local p = (v - minV) / (maxV - minV)
                fl.Size = UDim2.new(p, 0, 1, 0)
                kn.Position = UDim2.new(p, 0, 0.5, -8 * selectedScale)
                if onChange then onChange(v) end
                if sK then saveSettings() end
            else
                if sK then ib.Text = tostring(state[sK]) else ib.Text = tostring(iv) end
            end
        end)
        return ib
    end

