        end
    elseif cmd == "silentaim" or cmd == "sa" then toggle("silentAimEnabled","Silent Aim")
    elseif cmd == "shoot" then task.spawn(function() pcall(FSS) end)
    elseif cmd == "shootwall" then task.spawn(function() pcall(FTW) end)
    elseif cmd == "fling" then
        local target = arg(2)
        if target then
            for _,p in ipairs(Players:GetPlayers()) do
                if PMN(p, target) then
                    task.spawn(function() RF(p, true) end)
                    _G.__AW_NOTIFY("Flinging "..p.Name)
                    return
                end
            end
            _G.__AW_NOTIFY("Not found: "..target)
        else
            local m = GM()
            if m then task.spawn(function() RF(m, true) end) end
        end
    elseif cmd == "flingall" then
        FAN()
        _G.__AW_NOTIFY("Flinging all")
    elseif cmd == "flingmur" then FMN()
    elseif cmd == "flingsher" then FSN()
    elseif cmd == "killall" then KAN()
    elseif cmd == "killsher" then KSN()
    elseif cmd == "tpmap" then task.spawn(function() pcall(function() TTM(false) end) end)
    elseif cmd == "tplobby" then pcall(TTL)
    elseif cmd == "tpmur" then pcall(TTMU)
    elseif cmd == "tpsher" then pcall(TTSH)
    elseif cmd == "grabgun" or cmd == "grab" then task.spawn(function() pcall(grabNearestGun) end)
    elseif cmd == "removebarriers" or cmd == "rb" then removeBarriersNow()
    elseif cmd == "reset" then
        local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if h then h.Health = 0 end
    elseif cmd == "invisible" or cmd == "inv" then
        toggle("invisibleEnabled","Invisible")
    else
        _G.__AW_NOTIFY("Unknown: ."..cmd)
    end
end

pcInput.FocusLost:Connect(function(enterPressed)
