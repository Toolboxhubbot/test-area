local function beginMainDrag(input) mainDrag = {input = input, start = input.Position, startPos = mainWrap.Position} end
local function endMainDrag(input)
    if not mainDrag then return end
    if input ~= mainDrag.input then return end
    mainDrag = nil
end
dragStrip.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then beginMainDrag(input) end
end)
UIS.InputChanged:Connect(function(input)
    if not mainDrag then return end
    if input ~= mainDrag.input then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local delta = input.Position - mainDrag.start
    local sc = mainScale.Scale
    mainWrap.Position = UDim2.new(mainDrag.startPos.X.Scale, mainDrag.startPos.X.Offset + delta.X / sc, mainDrag.startPos.Y.Scale, mainDrag.startPos.Y.Offset + delta.Y / sc)
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
    endMainDrag(input)
end)

