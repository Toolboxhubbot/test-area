        ring.ZIndex = 6
        ring.Active = false
        Instance.new("UICorner", ring).CornerRadius = UDim.new(1,0)
    end
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency=0.15}):Play()
    end)
    btn.MouseLeave:Connect(function()
        if circleDrag and circleDrag.btn==btn then return end
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency=0}):Play()
    end)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if circleDrag then return end
        local myDrag = {btn=btn, id=cfg.id, dragStart=input.Position, startPos=btn.Position, moved=false, dragAllowed=false}
        circleDrag = myDrag
        TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundTransparency=0.3}):Play()
        task.delay(CIRCLE_DRAG_HOLD, function()
            if circleDrag == myDrag then
                myDrag.dragAllowed = true
                TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency=0.4}):Play()
            end
        end)
    end)
    return btn
end
UIS.InputChanged:Connect(function(input)
    if not circleDrag then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if not circleDrag.dragAllowed then return end
    local delta = input.Position - circleDrag.dragStart
    if delta.Magnitude > CIRCLE_DRAG_THRESHOLD then circleDrag.moved = true end
    if circleDrag.moved then
        circleDrag.btn.Position = UDim2.new(
            circleDrag.startPos.X.Scale,
            circleDrag.startPos.X.Offset + delta.X,
            circleDrag.startPos.Y.Scale,
            circleDrag.startPos.Y.Offset + delta.Y
        )
    end
end)
UIS.InputEnded:Connect(function(input)
    if not circleDrag then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local d = circleDrag
    circleDrag = nil
    if not d.btn or not d.btn.Parent then return end
    d.btn.BackgroundTransparency = 0
    local info = circleActionMap[d.id]
    local isAction = info and info.type == "action"
    if d.moved then
        for _, c in ipairs(settingsConfig.circleButtons) do
            if c.id == d.id then
                local abs = d.btn.Position
                c.x = abs.X.Offset
                c.y = abs.Y.Offset
                break
            end
        end
        settingsConfig.circleManualLayout = true
        saveSettings()
        return
    end
    if isAction then
        local h = circleActionHandlers[d.id]
        if h then pcall(h) end
        return
    end
    local newState = not state[d.id]
    setCircleToggleAppearance(d.btn, newState)
    state[d.id] = newState
    if d.id == "customShiftLockButton" then updateShiftLockVisual() end
    saveSettings()
end)
