local function getPlayerRole(plr)
    if not plr or not plr.Character then return "Innocent" end
    local bp, char = plr:FindFirstChild("Backpack"), plr.Character
    if (bp and bp:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife")) then return "Murderer" end
    if (bp and bp:FindFirstChild("Gun")) or (char and char:FindFirstChild("Gun")) then return "Sheriff" end
    local roleData = getCachedRoleData()
    if roleData then
        local pData = roleData[plr.Name] or roleData[tostring(plr.UserId)]
        if type(pData) == "table" then
            local role = pData.Role or pData.role or pData.RoleName
            if role and role ~= "" then return role end
        end
    end
    return "Innocent"
end

