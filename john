local function setToggleState(key, value)
    if key == "antiRagdoll" then value = true end
    local prev = state[key]
    state[key] = value
    -- If the user turns Farm / XP Farm off, clean everything up + go to lobby
    if (key == "farm" or key == "xpFarm") and prev == true and value == false then
        if stopFarmAndReturnToLobby then
            task.spawn(stopFarmAndReturnToLobby)
        end
    end
    if prev ~= value and not notifyExcluded[key] then
        local n = toggleDisplayNames[key] or key
        local c = value and "#5aff8c" or "#ff5a5a"
        local v = value and "enabled" or "disabled"
        showNotification('<font color="'..c..'">'..n..'</font> '..v)
    end
    if value then
        if key == "aimbotMurderer" then state.aimbotSheriff = false; updateAllToggleVisuals("aimbotSheriff")
        elseif key == "aimbotSheriff" then state.aimbotMurderer = false; updateAllToggleVisuals("aimbotMurderer")
        elseif key == "farm" then state.xpFarm = false; updateAllToggleVisuals("xpFarm")
        elseif key == "xpFarm" then state.farm = false; updateAllToggleVisuals("farm") end
    end
    updateAllToggleVisuals(key)
    if key == "disable3d" then applyLowDeviceOptimizations(state.disable3d)
    elseif key == "fullbright" then
        pcall(function()
            if state.fullbright then
                Lighting.Brightness = 3
                Lighting.Ambient = Color3.fromRGB(178,178,178)
                Lighting.OutdoorAmbient = Color3.fromRGB(178,178,178)
