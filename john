                btn.Text = ""
            end
            local inner = Instance.new("UIStroke", btn)
            inner.Color = Color3.new(1,1,1)
            inner.Thickness = 1.5
            inner.Transparency = 0.3
            floatButtons[def.id] = {def = def, btn = btn, inner = inner, outer = outer, outerStroke = outerStroke}
