clickTPDebounce = 0
function tryClickTP()
    if not state.clickTP then return end
    if tick() - clickTPDebounce < 0.15 then return end
    if UIS:GetFocusedTextBox() then return end
    local c = Workspace.CurrentCamera
    if not c then return end
    local m = UIS:GetMouseLocation()
    local ray = c:ViewportPointToRay(m.X, m.Y)
    local p = RaycastParams.new()
    if LP.Character then p.FilterDescendantsInstances = {LP.Character} end
    p.FilterType = Enum.RaycastFilterType.Exclude
    local res = Workspace:Raycast(ray.Origin, ray.Direction * 2000, p)
    local pos = res and res.Position or (ray.Origin + ray.Direction * 60)
    local r = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if r then
        r.Anchored = true
        r.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
        task.wait(0.05)
        if r.Parent then r.Anchored = false end
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
        clickTPDebounce = tick()
    end
end
