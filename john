local function executeKillBehind(targetPlayer)
    local targetChar = targetPlayer.Character
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    local targetHumanoid = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not (targetHumanoid and targetHumanoid.Health > 0 and targetRoot and myRoot) then return end
    local tStart = tick()
    while tick() - tStart < 2.0 and targetHumanoid.Health > 0 and targetRoot.Parent and myRoot.Parent and alive() do
        local knife = LP.Character and LP.Character:FindFirstChild("Knife")
        if not knife then knife = equipTool("Knife") end
        if knife then
            myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3.2)
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
            pcall(function() knife:Activate() end)
            pcall(function()
                for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
                    if v:IsA("RemoteEvent") then
                        local n = string.lower(v.Name)
                        if n:find("knife") or n:find("hit") or n:find("stab") or n:find("kill") or n:find("slash") then
                            pcall(function()
                                v:FireServer(targetRoot.Position)
                                v:FireServer(targetPlayer)
                                v:FireServer(targetChar)
                            end)
                        end
                    end
                end
            end)
        end
        task.wait(0.04)
    end
end

