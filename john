    stroke.Color = isAction and Color3.fromRGB(120, 200, 255) or Color3.new(1, 1, 1)
    stroke.Thickness = 1.5
    stroke.Transparency = 0.35
    btn.TextStrokeColor3 = Color3.new(0, 0, 0)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if circleDrag then return end
        circleDrag = {
            btn = btn, id = cfg.id,
            dragStart = input.Position, startPos = btn.Position,
            moved = false, dragAllowed = false,
        }
        task.delay(0.22, function()
            if circleDrag and circleDrag.btn == btn then circleDrag.dragAllowed = true end
        end)
    end)
    return btn
end

UIS.InputChanged:Connect(function(input)
    if not circleDrag then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
       and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if not circleDrag.dragAllowed then return end
    local delta = input.Position - circleDrag.dragStart
    if delta.Magnitude > 8 then circleDrag.moved = true end
    if circleDrag.moved then
        circleDrag.btn.Position = UDim2.new(
            circleDrag.startPos.X.Scale,
            circleDrag.startPos.X.Offset + delta.X,
            circleDrag.startPos.Y.Scale,
            circleDrag.startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if not circleDrag then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
       and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local d = circleDrag
    circleDrag = nil
    if not d.btn or not d.btn.Parent then return end
    local info = circleActionMap[d.id]
    local isAction = info and info.type == "action"
    if d.moved then
        for _, c in ipairs(settingsConfig.circleButtons) do
            if c.id == d.id then
                c.x = d.btn.Position.X.Offset
                c.y = d.btn.Position.Y.Offset
                break
            end
        end
        settingsConfig.circleManualLayout = true
        saveSettings()
        return
    end
    if isAction then
        local h = circleActionHandlers[d.id]
        if h then pcall(h) end
        return
    end
    local newState = not state[d.id]
    setCircleToggleAppearance(d.btn, newState)
    if _G.setToggleState then _G.setToggleState(d.id, newState) end
end)

_G.updateCircleViz = function()
    for _, item in ipairs(circleButtonsList) do
        local cfg, b = item.cfg, item.btn
        if b and b.Parent then
            local info = circleActionMap[cfg.id]
            local isAction = info and info.type == "action"
            local sz = state.circleGlobalSize or cfg.size or 62
            cfg.size = sz
            b.Visible = cfg.enabled and state.circleButtonsEnabled
            TweenService:Create(b, TweenInfo.new(0.2), {
                Size = UDim2.new(0, sz, 0, sz),
                TextSize = math.clamp(math.floor(sz * 0.24), 9, 18),
            }):Play()
            if not isAction then setCircleToggleAppearance(b, state[cfg.id]) end
        end
    end
end

local function rebuildCircleButtons()
    for _, item in ipairs(circleButtonsList) do
        if item.btn and item.btn.Parent then item.btn:Destroy() end
    end
    circleButtonsList = {}
    _G.circleButtonsList = circleButtonsList
    for _, cfg in ipairs(settingsConfig.circleButtons) do
        if type(cfg) == "table" and type(cfg.id) == "string" and circleActionMap[cfg.id] then
            if not cfg.size or cfg.size == 0 then cfg.size = state.circleGlobalSize or 62 end
            local b = buildCircleButton(cfg)
            if b then table.insert(circleButtonsList, {cfg = cfg, btn = b}) end
        end
    end
    _G.updateCircleViz()
end

