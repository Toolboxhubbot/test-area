local currentAimTarget = nil
RunService.RenderStepped:Connect(function(dt)
    if not alive() then currentAimTarget = nil; return end
    if not (state.aimbotMurderer or state.aimbotSheriff) then currentAimTarget = nil; return end
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local vps = cam.ViewportSize
    local center = Vector2.new(vps.X*0.5, vps.Y*0.5)
    local candidates = {}
    if state.aimbotMurderer then
        local m = getMurd()
        if m then table.insert(candidates, m) end
    elseif state.aimbotSheriff then
        for _, s in ipairs(getLiveSheriffHeroes()) do table.insert(candidates, s) end
    end
    if #candidates == 0 then currentAimTarget = nil; return end
    local fovR = state.aimbotFOV or 250
    local best, bestScore = nil, -math.huge
    for _, tp in ipairs(candidates) do
        local ch = tp.Character
        if ch then
            local hh = ch:FindFirstChildOfClass("Humanoid")
            if hh and hh.Health > 0 then
                local tpart = ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
                if tpart then
                    local sp, onScreen = cam:WorldToViewportPoint(tpart.Position)
                    if onScreen and sp.Z > 0 then
                        local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if sd <= fovR then
                            local score = -sd
                            if tpart.Name == "Head" then score = score + 50 end
                            if score > bestScore then bestScore = score; best = tp end
                        end
                    end
                end
            end
        end
    end
    if not best or not best.Character then currentAimTarget = nil; return end
    currentAimTarget = best
    local ch = best.Character
    local tpart = ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
    if not tpart then return end
    local aimPos = tpart.Position
    if state.aimbotPredict then
        local vel = tpart.AssemblyLinearVelocity
        if vel.Magnitude > 1 then
            local dist = (tpart.Position - cam.CFrame.Position).Magnitude
            local t = dist / 800
            aimPos = tpart.Position + vel * t
        end
    end
    local desired = CFrame.new(cam.CFrame.Position, aimPos)
    if state.aimbotSnap then cam.CFrame = desired
    else
        local smooth = state.aimbotSmooth or 4
        if smooth <= 1 then cam.CFrame = desired
        else
            local alpha = math.clamp(1 - math.exp(-dt * (60 / smooth) * 0.15), 0.05, 1)
            cam.CFrame = cam.CFrame:Lerp(desired, alpha)
        end
    end
end)

