    lbl.Position = UDim2.new(0,8,0,0)
    lbl.BackgroundTransparency = 1
    local prefix = isSecret and "[S] " or (isAction and "[A] " or "")
    local suffix = isSecret and " (secret)" or (isAction and " (action)" or "")
    lbl.Text = prefix .. info.label .. suffix
    if isSecret then lbl.TextColor3 = Color3.fromRGB(255,220,90)
    elseif isAction then lbl.TextColor3 = Color3.fromRGB(120,200,255)
    else lbl.TextColor3 = cc3(settingsConfig.textColor) end
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    local en = Instance.new("TextButton", row)
    en.Size = UDim2.new(0,44,0,22)
    en.Position = UDim2.new(1,-50,0.5,-11)
    en.BackgroundColor3 = ccfg.enabled and cc3(settingsConfig.accentColor) or Color3.fromRGB(45,45,45)
    en.Text = ccfg.enabled and "ON" or "OFF"
    en.TextColor3 = ccfg.enabled and Color3.new(0,0,0) or Color3.fromRGB(150,150,150)
    en.Font = Enum.Font.GothamBold
    en.TextSize = 10
    en.AutoButtonColor = false
    Instance.new("UICorner", en).CornerRadius = UDim.new(0,5)
    en.MouseButton1Click:Connect(function()
        ccfg.enabled = not ccfg.enabled
