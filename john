-- ========== FLING ==========
local killLock={}
local resets={}
local RESET_D=2.0
local isFling=false
local fCount=0
local function isRst(uid)
local t=resets[uid]
if not t then return false end
if tick()-t>RESET_D+0.5 then resets[uid]=nil; return false end
return true
end
local function fling(tp,force)
if not tp or tp==LP or not tp.Parent or not tAlive(tp) then return false end
if isRst(tp.UserId) or isWL(tp) then return false end
if not force and not (state.loopFlingAll or state.loopFlingMur or state.loopFlingSher or state.loopFlingCust or state.flingAura) then return false end
local C=LP.Character; if not C then return false end
local H=C:FindFirstChildOfClass("Humanoid")
local R2=H and H.RootPart
local TC=tp.Character
if not (R2 and TC) then return false end
local TR=TC:FindFirstChild("HumanoidRootPart")
if not TR then return false end
fCount=fCount+1
isFling=true
local sc=R2.CFrame
H.PlatformStand=true
local bv=Instance.new("BodyVelocity")
bv.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
bv.Velocity=Vector3.new(0,-50000,0)
bv.Parent=R2
local bg=Instance.new("BodyGyro")
bg.MaxTorque=Vector3.new(math.huge,math.huge,math.huge)
bg.P=1e6; bg.CFrame=R2.CFrame; bg.Parent=R2
local oldDH=W.FallenPartsDestroyHeight
W.FallenPartsDestroyHeight=-100000
local st=tick()
resets[tp.UserId]=st
local conn,clean=nil,false
local function done()
if clean then return end
clean=true
pcall(function()
W.FallenPartsDestroyHeight=oldDH
if bv.Parent then bv:Destroy() end
if bg.Parent then bg:Destroy() end
if H.Parent then H.PlatformStand=false; for _,t in ipairs(H:GetPlayingAnimationTracks()) do t:Stop() end end
if R2.Parent then R2.AssemblyLinearVelocity=Vector3.zero; R2.AssemblyAngularVelocity=Vector3.zero; R2.CFrame=sc end
if conn then conn:Disconnect() end
end)
resets[tp.UserId]=nil
fCount=fCount-1
if fCount<=0 then fCount=0; isFling=false end
end
conn=R.Heartbeat:Connect(function()
if tick()-st>RESET_D or not tp.Character or not TR.Parent or not C.Parent then done(); return end
if TR and TR.Parent and R2 and R2.Parent then
local th=TC:FindFirstChild("Head")
local p=th and th.Position or TR.Position
R2.CFrame=CFrame.new(p-Vector3.new(0,0.5,0))*CFrame.Angles(math.pi/2,0,0)
R2.AssemblyLinearVelocity=Vector3.new(0,-50000,0)
R2.AssemblyAngularVelocity=Vector3.new(7500,7500,7500)
local dir=TR.Position-R2.Position
if dir.Magnitude>0.01 then bv.Velocity=dir.Unit*50000 end
bg.CFrame=R2.CFrame
end
end)
local to=tick()+RESET_D+1
while resets[tp.UserId] and tick()<to do task.wait(0.05) end
done()
return true
end

-- ========== KILL ==========
local function fireHTKill(targets)
local ch=LP.Character; if not ch then return end
local k=ch:FindFirstChild("Knife") or equip("Knife")
if not k then _G.__AW_NOTIFY("No Knife") return end
local ev=k:FindFirstChild("Events")
local ht=ev and ev:FindFirstChild("HandleTouched")
if not ht then _G.__AW_NOTIFY("HandleTouched missing") return end
local parts={}
for _,p in ipairs(targets) do
if p and p~=LP and tAlive(p) and not isWL(p) then
local pc=p.Character
if pc then
local tor=pc:FindFirstChild("UpperTorso") or pc:FindFirstChild("Torso") or pc:FindFirstChild("HumanoidRootPart")
if tor then table.insert(parts,tor) end
end
end
end
if #parts==0 then _G.__AW_NOTIFY("No targets") return end
task.spawn(function()
for _=1,8 do
for _,t in ipairs(parts) do pcall(function() ht:FireServer(t) end) end
task.wait(0.08)
end
end)
end
local function killAll()
task.spawn(function()
stand(); task.wait(0.1)
if not (findTool("Knife") or equip("Knife")) then _G.__AW_NOTIFY("No Knife") return end
local t={}
for _,p in ipairs(P:GetPlayers()) do if p~=LP and tAlive(p) and not isWL(p) then table.insert(t,p) end end
fireHTKill(t)
end)
end
local function killSheriff()
task.spawn(function()
if not alive() then return end
stand(); task.wait(0.1)
if not (findTool("Knife") or equip("Knife")) then _G.__AW_NOTIFY("No Knife") return end
fireHTKill(sheriffs())
end)
end
local function killCustom()
task.spawn(function()
if #cfg.flingList==0 then return end
stand(); task.wait(0.1)
if not (findTool("Knife") or equip("Knife")) then _G.__AW_NOTIFY("No Knife") return end
local t={}
for _,n in ipairs(cfg.flingList) do
for _,p in ipairs(P:GetPlayers()) do if nameMatch(p,n) and tAlive(p) then table.insert(t,p) end end
end
fireHTKill(t)
end)
end
local function flingAll() task.spawn(function() for _,p in ipairs(P:GetPlayers()) do if p~=LP and not isWL(p) and tAlive(p) then task.spawn(function() fling(p,true) end); task.wait(0.15) end end end) end
local function flingSheriff() task.spawn(function() if not alive() then return end for _=1,6 do local l=sheriffs() if #l==0 then break end for _,t in ipairs(l) do if t and not isRst(t.UserId) and not isWL(t) then task.spawn(function() fling(t,true) end) end end task.wait(0.4) end end) end
local function flingMur() task.spawn(function() local m=murd() if m then fling(m,true) end end) end
local function flingCustom() task.spawn(function() for _,n in ipairs(cfg.flingList) do for _,p in ipairs(P:GetPlayers()) do if nameMatch(p,n) and tAlive(p) and not isWL(p) then task.spawn(function() fling(p,true) end); task.wait(0.15) end end end end) end

