RunService.RenderStepped:Connect(function(dt)
    if not al() then CAT=nil return end
    if not (state.aimbotMurderer or state.aimbotSheriff) then CAT=nil return end
    local cm=Workspace.CurrentCamera
    if not cm then return end
    local vps=cm.ViewportSize
    local cn=Vector2.new(vps.X*0.5,vps.Y*0.5)
    local cs={}
    if state.aimbotMurderer then
        local m=GM()
        if m then table.insert(cs,m) end
    elseif state.aimbotSheriff then
        for _,s in ipairs(GLSH()) do table.insert(cs,s) end
    end
    if #cs==0 then CAT=nil return end
    local fR=state.aimbotFOV or 250
    local bs,bsc=nil,-math.huge
    for _,tp in ipairs(cs) do
        local ch=tp.Character
        if ch then
            local hh=ch:FindFirstChildOfClass("Humanoid")
            if hh and hh.Health>0 then
                local tp2=ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
                if tp2 then
                    local sp,os=cm:WorldToViewportPoint(tp2.Position)
                    if os and sp.Z>0 then
                        local sd=(Vector2.new(sp.X,sp.Y)-cn).Magnitude
                        if sd<=fR then
                            local sc=-sd
                            if tp2.Name=="Head" then sc=sc+50 end
                            if sc>bsc then
                                bsc=sc
                                bs=tp
                            end
                        end
                    end
                end
            end
        end
    end
    if not bs or not bs.Character then CAT=nil return end
    CAT=bs
    local ch=bs.Character
    local tp2=ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
    if not tp2 then return end
    local ap=tp2.Position
    if state.aimbotPredict then
        local v=tp2.AssemblyLinearVelocity
        if v.Magnitude>1 then
            local d=(tp2.Position-cm.CFrame.Position).Magnitude
            local t=d/800
            ap=tp2.Position+v*t
        end
    end
    local ds=CFrame.new(cm.CFrame.Position,ap)
    if state.aimbotSnap then
        cm.CFrame=ds
    else
        local sm=state.aimbotSmooth or 4
        if sm<=1 then
            cm.CFrame=ds
        else
            local al2=math.clamp(1-math.exp(-dt*(60/sm)*0.15),0.05,1)
            cm.CFrame=cm.CFrame:Lerp(ds,al2)
        end
    end
end)

