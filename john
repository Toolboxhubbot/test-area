    if prev ~= value and not notifyExcluded[key] then
        local displayName = toggleDisplayNames[key] or key
        local color = value and "#5aff8c" or "#ff5a5a"
        local verb = value and "enabled" or "disabled"
        showNotification('<font color="' .. color .. '">' .. displayName .. '</font> ' .. verb)
    end
    if value then
        if key == "aimbotMurderer" then state.aimbotSheriff = false; updateAllToggleVisuals("aimbotSheriff")
        elseif key == "aimbotSheriff" then state.aimbotMurderer = false; updateAllToggleVisuals("aimbotMurderer")
        elseif key == "farm" then state.xpFarm = false; updateAllToggleVisuals("xpFarm")
        elseif key == "xpFarm" then state.farm = false; updateAllToggleVisuals("farm") end
    end
    updateAllToggleVisuals(key)
    if key == "disable3d" then applyLowDeviceOptimizations(state.disable3d)
    elseif key == "fullbright" then
        pcall(function()
            if state.fullbright then
                Lighting.Brightness = 3
                Lighting.Ambient = Color3.fromRGB(178, 178, 178)
                Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
                Lighting.FogEnd = 100000
            else
                Lighting.Brightness = 1
                Lighting.Ambient = Color3.fromRGB(70, 70, 70)
                Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
            end
        end)
    elseif key == "fpsBoost" then applyFpsBoost(state.fpsBoost)
    elseif key == "quickTogglesVisible" and quickFrameReference then quickFrameReference.Visible = state.quickTogglesVisible
    elseif key == "showRoundTimerCountdown" then if not value then roundTimerFrame.Visible = false end end
    saveSettings()
end

