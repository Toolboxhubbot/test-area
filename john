local function buildPlayerRow(parent, plr, order)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, -12, 0, 52)
    row.LayoutOrder = order
    row.BackgroundColor3 = cc3(settingsConfig.cardHoverColor)
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

    local avatar = Instance.new("ImageLabel", row)
    avatar.Size = UDim2.new(0, 40, 0, 40)
    avatar.Position = UDim2.new(0, 5, 0.5, -20)
    avatar.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    avatar.BorderSizePixel = 0
    avatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(plr.UserId) .. "&w=150&h=150"
    Instance.new("UICorner", avatar).CornerRadius = UDim.new(1, 0)

    local disp = Instance.new("TextLabel", row)
    disp.Size = UDim2.new(1, -115, 0, 16)
    disp.Position = UDim2.new(0, 52, 0, 8)
    disp.BackgroundTransparency = 1
    disp.Text = plr.DisplayName
    disp.TextColor3 = cc3(settingsConfig.textColor)
    disp.Font = Enum.Font.GothamBold
    disp.TextSize = 12
    disp.TextXAlignment = Enum.TextXAlignment.Left

    local user = Instance.new("TextLabel", row)
    user.Size = UDim2.new(1, -115, 0, 14)
    user.Position = UDim2.new(0, 52, 0, 24)
    user.BackgroundTransparency = 1
    user.Text = "@" .. plr.Name
    user.TextColor3 = cc3(settingsConfig.tabTextColor)
    user.Font = Enum.Font.Gotham
    user.TextSize = 10
    user.TextXAlignment = Enum.TextXAlignment.Left

    local inList = false
    for _, x in ipairs(settingsConfig.flingList) do
        if string.lower(x) == string.lower(plr.Name) or string.lower(x) == string.lower(plr.DisplayName) then
            inList = true
            break
        end
    end

    local ab = Instance.new("TextButton", row)
    ab.Size = UDim2.new(0, 58, 0, 26)
    ab.Position = UDim2.new(1, -64, 0.5, -13)
    ab.BackgroundColor3 = inList and Color3.fromRGB(160, 40, 40) or Color3.fromRGB(35, 140, 65)
    ab.Text = inList and "Remove" or "Add"
    ab.TextColor3 = Color3.new(1, 1, 1)
    ab.Font = Enum.Font.GothamBold
    ab.TextSize = 10.5
    ab.AutoButtonColor = false
    Instance.new("UICorner", ab).CornerRadius = UDim.new(0, 6)

    ab.MouseButton1Click:Connect(function()
        local isIn = false
        local idx = nil
        for i, x in ipairs(settingsConfig.flingList) do
            if string.lower(x) == string.lower(plr.Name) or string.lower(x) == string.lower(plr.DisplayName) then
                isIn = true
                idx = i
                break
            end
        end
        if isIn and idx then
            table.remove(settingsConfig.flingList, idx)
            ab.Text = "Add"
            ab.BackgroundColor3 = Color3.fromRGB(35, 140, 65)
            _G.__AW_NOTIFY('Removed: <font color="#ff5a5a">' .. plr.Name .. '</font>')
        else
            table.insert(settingsConfig.flingList, plr.Name)
            ab.Text = "Remove"
            ab.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
            _G.__AW_NOTIFY('Added: <font color="#5aff8c">' .. plr.Name .. '</font>')
        end
        saveSettings()
        refreshCustomListUI()
    end)
end

local function refreshPlayerList()
    for _, c in ipairs(playerListScroll:GetChildren()) do
        if c:IsA("GuiObject") and c ~= plsLayout then c:Destroy() end
    end
    local sorted = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then table.insert(sorted, p) end
    end
    table.sort(sorted, function(a, b)
        return string.lower(a.Name) < string.lower(b.Name)
    end)
    if #sorted == 0 then
        local lbl = Instance.new("TextLabel", playerListScroll)
        lbl.Size = UDim2.new(1, -12, 0, 26)
        lbl.LayoutOrder = 1
        lbl.BackgroundTransparency = 1
        lbl.Text = "(no other players)"
        lbl.TextColor3 = cc3(settingsConfig.tabTextColor)
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 11
        return
    end
    for i, p in ipairs(sorted) do
        buildPlayerRow(playerListScroll, p, i)
    end
end
_G.__AW_REFRESH_PLAYER_LIST = refreshPlayerList

