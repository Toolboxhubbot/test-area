-- ===== SAVE / LOAD =====
function saveSettings()
    task.spawn(function()
        pcall(function()
            local data = {state={}, settings={}}
            for k,v in pairs(state) do
                if not NO_SAVE_STATE_KEYS[k] then
                    local t = type(v)
                    if t=="number" or t=="string" or t=="boolean" or t=="table" then data.state[k]=v end
                end
            end
            for k,v in pairs(settingsConfig) do
                local t = type(v)
                if t=="number" or t=="string" or t=="boolean" or t=="table" then data.settings[k]=v end
            end
            if writefile then writefile(cfgPath(), HttpService:JSONEncode(data)) end
        end)
    end)
end

function loadSettings()
    pcall(function()
        if isfile and isfile(cfgPath()) and readfile then
            local decoded = HttpService:JSONDecode(readfile(cfgPath()))
            if decoded.state then
                for k,v in pairs(decoded.state) do
                    if state[k] ~= nil and not NO_SAVE_STATE_KEYS[k] then state[k] = v end
                end
            end
            if decoded.settings then
                for k,v in pairs(decoded.settings) do
                    if settingsConfig[k] ~= nil then settingsConfig[k] = v end
                end
            end
        end
    end)
end
