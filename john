local function drawLine(frame, pA, pB, thickness)
    local dx = pB.X - pA.X
    local dy = pB.Y - pA.Y
    local len = math.sqrt(dx * dx + dy * dy)
    if len < 0.1 then frame.Visible = false; return end
    local ang = math.deg(math.atan2(dy, dx))
    frame.Position = UDim2.new(0, pA.X, 0, pA.Y)
    frame.Size = UDim2.new(0, len, 0, thickness or 1.5)
    frame.Rotation = ang
    frame.Visible = true
end

