_G.circleButtonsList = circleButtonsList

local function autoLayoutCircleButtons()
    if settingsConfig.circleManualLayout then return end
    local cam = Workspace.CurrentCamera
    local vps = cam and cam.ViewportSize or Vector2.new(1920, 1080)
    local maxW = vps.X
    local size = state.circleGlobalSize or 62
    local gap = 4
    local startX = 8
    local startY = 8
    local x, y = startX, startY
    for _, cfg in ipairs(settingsConfig.circleButtons) do
        if x + size > maxW - 8 then
            x = startX
            y = y + size + gap
        end
        cfg.x = x
        cfg.y = y
        x = x + size + gap
    end
end

local function setCircleToggleAppearance(btn, isOn)
    if isOn then
        btn.BackgroundColor3 = Color3.new(1, 1, 1)
        btn.TextColor3 = Color3.new(0, 0, 0)
    else
        btn.BackgroundColor3 = Color3.new(0, 0, 0)
        btn.TextColor3 = Color3.new(1, 1, 1)
    end
    btn.TextStrokeTransparency = 1
end

local function buildCircleButton(cfg)
    if type(cfg) ~= "table" then return nil end
    if type(cfg.id) ~= "string" or cfg.id == "" then return nil end
    local info = circleActionMap[cfg.id]
    if not info then return nil end

    local isAction = info.type == "action"
    local isSecret = info.secret == true

    local btn = Instance.new("TextButton")
    btn.Name = "AWC_" .. cfg.id
    btn.Size = UDim2.new(0, cfg.size, 0, cfg.size)
    btn.Position = UDim2.new(0, cfg.x, 0, cfg.y)

    if isAction then
        btn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.TextStrokeTransparency = 1
    else
        setCircleToggleAppearance(btn, state[cfg.id] == true)
    end

    btn.BackgroundTransparency = 0
    btn.Text = info.label
    btn.Font = Enum.Font.Gotham
    btn.TextSize = math.clamp(math.floor(cfg.size * 0.24), 9, 18)
    btn.TextWrapped = true
    btn.AutoButtonColor = false
    btn.BorderSizePixel = 0
    btn.Active = true
    btn.ZIndex = 5
    btn.Visible = cfg.enabled and state.circleButtonsEnabled
    btn.Parent = circleGui
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
    local stroke = Instance.new("UIStroke", btn)
    if isAction then
        stroke.Color = Color3.fromRGB(120, 200, 255)
    else
        stroke.Color = Color3.new(1, 1, 1)
    end
    stroke.Thickness = 1.5
    stroke.Transparency = 0.35
    btn.TextStrokeColor3 = Color3.new(0, 0, 0)

    if isSecret then
        local ring = Instance.new("Frame", btn)
        ring.Name = "SecretRing"
        ring.AnchorPoint = Vector2.new(0.5, 0.5)
        ring.Position = UDim2.new(0.5, 0, 0.5, 0)
        ring.Size = UDim2.new(1, -8, 1, -8)
        ring.BackgroundTransparency = 1
        ring.BorderSizePixel = 1
        ring.BorderColor3 = Color3.fromRGB(255, 220, 90)
        ring.ZIndex = 6
        ring.Active = false
        Instance.new("UICorner", ring).CornerRadius = UDim.new(1, 0)
    end

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(animTime(0.15)), {BackgroundTransparency = 0.15}):Play()
    end)
    btn.MouseLeave:Connect(function()
        if circleDrag and circleDrag.btn == btn then return end
        TweenService:Create(btn, TweenInfo.new(animTime(0.15)), {BackgroundTransparency = 0}):Play()
    end)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if circleDrag then return end
        local myDrag = {
            btn = btn, id = cfg.id,
            dragStart = input.Position, startPos = btn.Position,
            moved = false, dragAllowed = false,
        }
        circleDrag = myDrag
        TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundTransparency = 0.3}):Play()
        task.delay(CIRCLE_DRAG_HOLD, function()
            if circleDrag == myDrag then
                myDrag.dragAllowed = true
                TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.4}):Play()
            end
        end)
    end)
    return btn
end

UIS.InputChanged:Connect(function(input)
    if not circleDrag then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
       and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if not circleDrag.dragAllowed then return end
    local delta = input.Position - circleDrag.dragStart
    if delta.Magnitude > CIRCLE_DRAG_THRESHOLD then
        circleDrag.moved = true
    end
    if circleDrag.moved then
        circleDrag.btn.Position = UDim2.new(
            circleDrag.startPos.X.Scale,
            circleDrag.startPos.X.Offset + delta.X,
            circleDrag.startPos.Y.Scale,
            circleDrag.startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if not circleDrag then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
       and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local d = circleDrag
    circleDrag = nil
    if not d.btn or not d.btn.Parent then return end
    d.btn.BackgroundTransparency = 0
    local info = circleActionMap[d.id]
    local isAction = info and info.type == "action"

    if d.moved then
        for _, c in ipairs(settingsConfig.circleButtons) do
            if c.id == d.id then
                local abs = d.btn.Position
                c.x = abs.X.Offset
                c.y = abs.Y.Offset
                break
            end
        end
        settingsConfig.circleManualLayout = true
        saveSettings()
        return
    end

    if isAction then
        local h = circleActionHandlers[d.id]
        if h then pcall(h) end
        return
    end

    local newState = not state[d.id]
    setCircleToggleAppearance(d.btn, newState)
    setToggleState(d.id, newState)
end)

updateCircleViz = function()
    for _, item in ipairs(circleButtonsList) do
        local cfg = item.cfg
        local b = item.btn
        if not b or not b.Parent then continue end
        local info = circleActionMap[cfg.id]
        local isAction = info and info.type == "action"
        local sz = state.circleGlobalSize or cfg.size or 62
        cfg.size = sz
        b.Visible = cfg.enabled and state.circleButtonsEnabled
        TweenService:Create(b, TweenInfo.new(animTime(0.2)), {
            Size = UDim2.new(0, sz, 0, sz),
            TextSize = math.clamp(math.floor(sz * 0.24), 9, 18),
        }):Play()
        if isAction then
            b.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
            b.TextColor3 = Color3.new(1,1,1)
            b.TextStrokeTransparency = 1
        else
            setCircleToggleAppearance(b, state[cfg.id])
        end
    end
end

rebuildCircleButtons = function()
    for _, item in ipairs(circleButtonsList) do
        if item.btn and item.btn.Parent then item.btn:Destroy() end
    end
    circleButtonsList = {}
    _G.circleButtonsList = circleButtonsList
    autoLayoutCircleButtons()
    for _, cfg in ipairs(settingsConfig.circleButtons) do
        if type(cfg) == "table"
           and type(cfg.id) == "string"
           and circleActionMap[cfg.id] then
            if not cfg.size or cfg.size == 0 then cfg.size = state.circleGlobalSize or 62 end
            local b = buildCircleButton(cfg)
            if b then table.insert(circleButtonsList, {cfg = cfg, btn = b}) end
        end
    end
    updateCircleViz()
end

