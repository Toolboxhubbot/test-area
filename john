RunService.RenderStepped:Connect(function(dt)
    if not alive() then
        currentAimTarget = nil
        lockedAimTarget = nil
        lockedAimPart = nil
        return
    end
    if not (state.aimbotMurderer or state.aimbotSheriff) then
        currentAimTarget = nil
        lockedAimTarget = nil
        lockedAimPart = nil
        return
    end
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local vps = cam.ViewportSize
    local center = Vector2.new(vps.X*0.5, vps.Y*0.5)
    local fovR = state.aimbotFOV or 250

    local keepLocked = false
    if state.aimbotSticky and lockedAimTarget and lockedAimTarget.Parent then
        local ch = lockedAimTarget.Character
        if ch then
            local hh = ch:FindFirstChildOfClass("Humanoid")
            local tpart = ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
            if hh and hh.Health > 0 and tpart then
                local sp, onScreen = cam:WorldToViewportPoint(tpart.Position)
                if onScreen and sp.Z > 0 then
                    local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if sd <= fovR * 1.35 then
                        keepLocked = true
                        lockedAimPart = tpart
                    end
                end
            end
        end
    end

    local target = nil
    local targetPart = nil

    if keepLocked then
        target = lockedAimTarget
        targetPart = lockedAimPart
    else
        local candidates = {}
        if state.aimbotMurderer then
            local m = getMurd()
            if m then table.insert(candidates, m) end
        elseif state.aimbotSheriff then
            for _, s in ipairs(getLiveSheriffHeroes()) do table.insert(candidates, s) end
        end
        if #candidates == 0 then
            lockedAimTarget = nil
            lockedAimPart = nil
            return
        end

        local best, bestScore = nil, -math.huge
        local bestPart = nil
        for _, tp in ipairs(candidates) do
            local ch = tp.Character
            if ch then
                local hh = ch:FindFirstChildOfClass("Humanoid")
                if hh and hh.Health > 0 then
                    local tpart = ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
                    if tpart then
                        local sp, onScreen = cam:WorldToViewportPoint(tpart.Position)
                        if onScreen and sp.Z > 0 then
                            local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if sd <= fovR then
                                local score = -sd
                                if tpart.Name == "Head" then score = score + 100 end
                                if score > bestScore then
                                    bestScore = score
                                    best = tp
                                    bestPart = tpart
                                end
                            end
                        end
                    end
                end
            end
        end
        target = best
        targetPart = bestPart
        if target and targetPart then
            lockedAimTarget = target
            lockedAimPart = targetPart
        else
            lockedAimTarget = nil
            lockedAimPart = nil
        end
    end

    if not target or not targetPart then return end
    currentAimTarget = target

    local aimPos = targetPart.Position
    if state.aimbotPredict then
        local vel = targetPart.AssemblyLinearVelocity
        if vel.Magnitude > 1 then
            local dist = (targetPart.Position - cam.CFrame.Position).Magnitude
            local t = dist / 1000
            aimPos = targetPart.Position + vel * t
        end
    end
    local desired = CFrame.new(cam.CFrame.Position, aimPos)

    if state.aimbotSnap then
        cam.CFrame = desired
    else
        local smooth = state.aimbotSmooth or 1
        if smooth <= 1 then
            cam.CFrame = desired
        else
            local alpha = math.clamp(1 - math.exp(-dt * (60 / smooth) * 0.9), 0.35, 1)
            cam.CFrame = cam.CFrame:Lerp(desired, alpha)
        end
    end
end)

