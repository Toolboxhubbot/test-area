detectMurdererPerk = function(plr)
    if not plr then return nil end
    local ch = plr.Character

    for _, attr in ipairs({"Perk","perk","PerkName","perkName","MurdererPerk","murdererPerk","CurrentPerk","currentPerk"}) do
        local v = plr:GetAttribute(attr)
        if type(v) == "string" and v ~= "" then return v end
    end

    if ch then
        for _, attr in ipairs({"Perk","perk","PerkName","perkName"}) do
            local v = ch:GetAttribute(attr)
            if type(v) == "string" and v ~= "" then return v end
        end
        for _, child in ipairs(ch:GetChildren()) do
            local n = child.Name
            if n == "Perk" or n == "PerkName" then
                if child.Value then return tostring(child.Value) end
            end
            if n == "Tag" or n == "PerkTag" then
                local v = child.Value
                if type(v) == "string" and v ~= "" then return v end
            end
        end
    end

    local function scanTools(container)
        if not container then return nil end
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local n = tool.Name
                if n ~= "Knife" and n ~= "Gun" and n ~= "Revolver" and n ~= "SheriffGun" then
                    return n
                end
                for _, attr in ipairs({"Perk","perk","PerkName","perkName"}) do
                    local v = tool:GetAttribute(attr)
                    if type(v) == "string" and v ~= "" then return v end
                end
            end
        end
        return nil
    end
    if ch then
        local r = scanTools(ch); if r then return r end
    end
    if plr:FindFirstChild("Backpack") then
        local r = scanTools(plr:FindFirstChild("Backpack")); if r then return r end
    end

    local rd = getCachedRoleData()
    if rd and type(rd) == "table" then
        local pd = rd[plr.Name] or rd[tostring(plr.UserId)] or rd[plr.UserId]
        if type(pd) == "table" then
            local p = pd.Perk or pd.perk or pd.PerkName or pd.perkName
            if type(p) == "string" and p ~= "" then return p end
        end
    end

    local ok, res = pcall(function()
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("ModuleScript") and (obj.Name == "Perks" or obj.Name == "MurdererPerks" or obj.Name == "PerkData") then
                local m = require(obj)
                if type(m) == "table" then
                    local entry = m[plr.Name] or m[tostring(plr.UserId)] or m[plr.UserId]
                    if type(entry) == "string" then return entry end
                    if type(entry) == "table" then
                        local p = entry.Perk or entry.perk or entry.Name or entry.name
                        if type(p) == "string" then return p end
                    end
                end
            end
        end
        return nil
    end)
    if ok and type(res) == "string" and res ~= "" then return res end

    return nil
end

