local function isShiftLocked()
    local ok, mh = pcall(function() return UIS.MouseBehavior end)
    return ok and (mh == Enum.MouseBehavior.LockCenter or mh == Enum.MouseBehavior.LockCurrentPosition)
end

local function setShiftLock(on)
    pcall(function()
        local pm = LP.PlayerScripts:FindFirstChild("PlayerModule")
        if pm then
            local controls = require(pm):GetControls()
            if on then
                if controls.EnableShiftLock then controls:EnableShiftLock() end
            else
                if controls.DisableShiftLock then controls:DisableShiftLock() end
            end
        end
    end)
    pcall(function()
        if on then
            if UserGameSettings.RotationType ~= Enum.RotationType.CameraRelative then
                UserGameSettings.RotationType = Enum.RotationType.CameraRelative
            end
            if UIS.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
                UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
            end
            if state.shiftLockHideIcon then UIS.MouseIconEnabled = false end
        else
            UIS.MouseBehavior = Enum.MouseBehavior.Default
            UIS.MouseIconEnabled = true
        end
    end)
end

task.spawn(function()
    local last = false
    while true do
        task.wait(0.05)
        local now = state.shiftLockEnabled == true
        if now ~= last then setShiftLock(now); last = now end
        if now and not isShiftLocked() then setShiftLock(true) end
    end
end)

