    ab.BackgroundColor3 = inList and Color3.fromRGB(160, 40, 40) or Color3.fromRGB(35, 140, 65)
    ab.Text = inList and "Remove" or "Add"
    ab.TextColor3 = Color3.new(1, 1, 1)
    ab.Font = Enum.Font.GothamBold; ab.TextSize = 10.5
    ab.AutoButtonColor = false
    Instance.new("UICorner", ab).CornerRadius = UDim.new(0, 6)
    ab.MouseButton1Click:Connect(function()
        local isIn = false
