        end
        for i=1,ct do
            local cch=LP.Character
            if cch then
                local h=cch:FindFirstChildOfClass("Humanoid")
                if h then
                    pcall(function()
                        h.Health=0
                        h:ChangeState(Enum.HumanoidStateType.Dead)
                    end)
                end
            end
            local spn=false
            local cn
            cn=LP.CharacterAdded:Connect(function(nc)
                spn=true
                local nr=nc:WaitForChild("HumanoidRootPart",1)
                if nr then
                    nr.Anchored=true
                    nr.CFrame=tcf
                    task.wait(0.01)
                    nr.Anchored=false
                    nr.AssemblyLinearVelocity=Vector3.zero
                    nr.AssemblyAngularVelocity=Vector3.zero
                end
                if cn then cn:Disconnect() end
            end)
            local t=0
            while not spn and t<3 do
                task.wait(0.02)
                t=t+0.02
            end
            if cn then cn:Disconnect() end
            task.wait(dl)
            local c2=LP.Character
            if c2 then
                local r=c2:FindFirstChild("HumanoidRootPart")
                if r then
                    r.Anchored=true
                    r.CFrame=tcf
                    task.wait(0.01)
                    r.Anchored=false
                    r.AssemblyLinearVelocity=Vector3.zero
                    r.AssemblyAngularVelocity=Vector3.zero
                end
            end
        end
        task.wait(0.1)
        local fc=LP.Character
        if fc and scf then
            local r=fc:FindFirstChild("HumanoidRootPart")
            if r then r.CFrame=scf end
        end
        voting=false
    end)
end
local function GVN()
    local mn={"N/A","N/A","N/A"}
