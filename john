        b.Size = UDim2.new(1,0,0,32*selectedScale)
        b.BackgroundColor3 = (i == 1) and Color3.fromRGB(22,22,22) or Color3.fromRGB(0,0,0)
        b.BackgroundTransparency = (i == 1) and 0 or 1
