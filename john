do
    local function findPlaySong()
        local paths = {
            {"Remotes", "Inventory", "PlaySong"},
            {"Remotes", "PlaySong"},
            {"Remotes", "Gameplay", "PlaySong"},
            {"Remotes", "Radio", "PlaySong"},
            {"Remotes", "Inventory", "PlaySound"},
            {"Remotes", "PlaySound"},
            {"PlaySong"},
        }
        for _, path in ipairs(paths) do
            local cur = ReplicatedStorage
            local ok = true
            for _, name in ipairs(path) do
                cur = cur and cur:FindFirstChild(name)
                if not cur then ok = false; break end
            end
            if ok and cur and (cur:IsA("RemoteEvent") or cur:IsA("RemoteFunction")) then
                return cur
            end
        end
        local found = ReplicatedStorage:FindFirstChild("PlaySong", true)
        if found and (found:IsA("RemoteEvent") or found:IsA("RemoteFunction")) then
            return found
        end
        return nil
    end

    local function findStopRemote()
        local stopNames = {"StopSong", "StopSound", "PauseSong", "PauseSound", "StopMusic", "StopRadio", "Stop"}
        local parent = PlaySong and PlaySong.Parent or (ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Inventory"))
        if parent then
            for _, name in ipairs(stopNames) do
                local r = parent:FindFirstChild(name)
                if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then
                    return r
                end
            end
        end
        for _, name in ipairs(stopNames) do
            local found = ReplicatedStorage:FindFirstChild(name, true)
            if found and (found:IsA("RemoteEvent") or found:IsA("RemoteFunction")) then
                return found
            end
        end
        return nil
    end

    local PlaySong = findPlaySong()
    task.spawn(function()
        while true do
            task.wait(2)
            if not PlaySong or not PlaySong.Parent then
                PlaySong = findPlaySong()
            end
        end
    end)

    local songFile = "AW_RadioSongs.json"
    local savedSongs = {}
    if isfile and isfile(songFile) and readfile then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(songFile)) end)
        if ok and type(data) == "table" then savedSongs = data end
    end
    local function saveSongs()
        if writefile then pcall(function() writefile(songFile, HttpService:JSONEncode(savedSongs)) end) end
    end

    local function firePlaySong(rawId, tryAllFormats)
        if not PlaySong or not PlaySong.Parent then
            PlaySong = findPlaySong()
        end
        if not PlaySong then
            _G.__AW_NOTIFY("PlaySong remote not found")
            return false
        end
        local idNum = tonumber(tostring(rawId or ""):match("%d+"))
        if not idNum then
            _G.__AW_NOTIFY("Invalid audio ID")
            return false
        end
        local formats = { idNum }
        if tryAllFormats then
            table.insert(formats, "rbxassetid://" .. idNum)
            table.insert(formats, "https://www.roblox.com/asset/?id=" .. idNum)
        end
        for i, arg in ipairs(formats) do
            pcall(function()
                if PlaySong:IsA("RemoteEvent") then
                    PlaySong:FireServer(arg)
                elseif PlaySong:IsA("RemoteFunction") then
                    PlaySong:InvokeServer(arg)
                end
            end)
            if i < #formats then task.wait(0.08) end
        end
        return true
    end

    local function stopAudio()
        if not PlaySong or not PlaySong.Parent then
            PlaySong = findPlaySong()
        end
        local stopRemote = findStopRemote()
        if stopRemote then
            pcall(function()
                if stopRemote:IsA("RemoteEvent") then
                    stopRemote:FireServer()
                else
                    stopRemote:InvokeServer()
                end
            end)
            return true
        end
        if PlaySong then
            pcall(function()
                if PlaySong:IsA("RemoteEvent") then
                    PlaySong:FireServer(0)
                    task.wait(0.05)
                    PlaySong:FireServer("")
                    task.wait(0.05)
                    PlaySong:FireServer(nil)
                else
                    PlaySong:InvokeServer(0)
                end
            end)
            return true
        end
        return false
    end

