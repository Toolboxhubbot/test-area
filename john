local function loadSettings()
    pcall(function()
        local path = getFullPath()
        if readfile and isfile and isfile(path) then
            local decoded = HttpService:JSONDecode(readfile(path))
            if decoded.state then
                for k, v in pairs(decoded.state) do if state[k] ~= nil then state[k] = v end end
            end
            if decoded.config then
                for k, v in pairs(decoded.config) do if settingsConfig[k] ~= nil then settingsConfig[k] = v end end
            end
            if settingsConfig.tweenSpeed then TWEEN_SPEED = settingsConfig.tweenSpeed end
            if settingsConfig.roundLength then ROUND_LENGTH_FALLBACK = settingsConfig.roundLength end
            if type(settingsConfig.flingList) ~= "table" then settingsConfig.flingList = {} end
            if type(settingsConfig.whitelist) ~= "table" then settingsConfig.whitelist = {} end
        end
    end)
    state.antiRagdoll = true
end
