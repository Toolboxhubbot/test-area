local function safePointAt(p)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    if LP.Character then rp.FilterDescendantsInstances = {LP.Character} end
    local hit = Workspace:Raycast(p + Vector3.new(0, 200, 0), Vector3.new(0, -400, 0), rp)
    if hit then return hit.Position + Vector3.new(0, 4, 0) end
    return p + Vector3.new(0, 4, 0)
end

local function findMapPosition()
    for _, m in ipairs(Workspace:GetChildren()) do
        local cc = m:FindFirstChild("CoinContainer") or (m.Name == "CoinContainer" and m)
        if cc then
            local spawn = m:FindFirstChildWhichIsA("SpawnLocation", true)
            if spawn then return safePointAt(spawn.Position) end
            if cc:IsA("BasePart") then return safePointAt(cc.Position) end
            local ccp = cc:FindFirstChildWhichIsA("BasePart", true)
            if ccp then return safePointAt(ccp.Position) end
            local sum, count = Vector3.zero, 0
            for _, d in ipairs(m:GetDescendants()) do
                if d:IsA("BasePart") and d.Name ~= "Coin" then
                    sum = sum + d.Position
                    count = count + 1
                    if count >= 50 then break end
                end
            end
            if count > 0 then
                return safePointAt(sum / count)
            end
        end
    end
    return nil
end

