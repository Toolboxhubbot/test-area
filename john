local switching = false
local function switchTab(n)
    if switching or n == curTab then return end
    switching = true
    local o = curTab
    curTab = n
    for nm, b in pairs(btns) do
        local ia = (nm == n)
        local txtCol
        if nm == SECRET_NAME then txtCol = Color3.fromRGB(0,0,0)
        else txtCol = ia and Color3.new(1,1,1) or THEME.textSub end
        TweenService:Create(b, TweenInfo.new(0.32, EASE_SMOOTH), {
            BackgroundTransparency = ia and 0 or 1,
            BackgroundColor3 = ia and THEME.cardHover or THEME.sidebar,
            TextColor3 = txtCol
        }):Play()
        local pill = b:FindFirstChild("ActivePill")
        if pill then
            TweenService:Create(pill, TweenInfo.new(0.3, EASE_SMOOTH), {BackgroundTransparency = ia and 0 or 1}):Play()
        end
    end
    if pageGs[o] then
        local op = pages[o]
        TweenService:Create(op, TweenInfo.new(0.24, EASE_BOUNCE, EASE_IN), {Position=UDim2.new(-0.12,0,0,0)}):Play()
        task.delay(0.24, function() if pageGs[o] then pageGs[o].Visible = false op.Position = UDim2.new(0,0,0,0) end end)
    end
    if pageGs[n] then
        pageGs[n].Visible = true
        local np = pages[n]
        np.Position = UDim2.new(0.12,0,0,0)
        TweenService:Create(np, TweenInfo.new(0.45, EASE_BOUNCE, EASE_OUT), {Position=UDim2.new(0,0,0,0)}):Play()
        staggerFade(np)
    end
    task.delay(0.24, function() switching = false end)
end

