    local function buildEmoteFloat(id,emote)
        id=tostring(id)
        if emoteFloatButtons[id] then return end
        local outer=Instance.new("Frame",emoteFloatGui)
        outer.AnchorPoint=Vector2.new(0,0)
        outer.BackgroundTransparency=1
        outer.Size=UDim2.new(0,60,0,60)
        local savedPos=state.emoteFloatPositions[id]
        if savedPos then outer.Position=UDim2.new(savedPos.xScale or 0,savedPos.xOffset or 20,savedPos.yScale or 0,savedPos.yOffset or 200)
        else outer.Position=UDim2.new(0,20,0,200+#emoteFloatButtons*66) end
        local btn=Instance.new("TextButton",outer)
        btn.Size=UDim2.new(1,0,1,0)
        btn.BackgroundColor3=BLACK
        btn.BackgroundTransparency=0.3
        btn.Text=""
        btn.AutoButtonColor=false
        Instance.new("UICorner",btn).CornerRadius=UDim.new(0,10)
        local stroke=Instance.new("UIStroke",btn)
        stroke.Color=cc3(settingsConfig.accentColor)
        stroke.Thickness=1.5; stroke.Transparency=0.4
        local img=Instance.new("ImageLabel",btn)
        img.Size=UDim2.new(0.85,0,0.85,0)
        img.Position=UDim2.new(0.075,0,0.075,0)
        img.BackgroundTransparency=1
        img.Image="rbxthumb://type=Asset&id="..id.."&w=150&h=150"
        img.ScaleType=Enum.ScaleType.Fit
        btn.MouseButton1Click:Connect(function() playEmote(id) end)
        local dragState=nil
        btn.InputBegan:Connect(function(input)
            if input.UserInputType~=Enum.UserInputType.Touch and input.UserInputType~=Enum.UserInputType.MouseButton1 then return end
            dragState={input=input,start=input.Position,sp=outer.Position,moved=false}
        end)
        UIS.InputChanged:Connect(function(input)
            if not dragState or input~=dragState.input then return end
            local d=input.Position-dragState.start
            if d.Magnitude>6 then dragState.moved=true end
            if dragState.moved then outer.Position=UDim2.new(dragState.sp.X.Scale,dragState.sp.X.Offset+d.X,dragState.sp.Y.Scale,dragState.sp.Y.Offset+d.Y) end
        end)
        UIS.InputEnded:Connect(function(input)
            if dragState and input==dragState.input then
                if dragState.moved then
                    state.emoteFloatPositions[id]={xScale=outer.Position.X.Scale,xOffset=outer.Position.X.Offset,yScale=outer.Position.Y.Scale,yOffset=outer.Position.Y.Offset}
                    saveSettings()
                end
                dragState=nil
            end
        end)
        emoteFloatButtons[id]={btn=btn,outer=outer,emote=emote}
        btn.Visible=state.floatButtonsEnabled
    end

