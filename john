end

local fpsBoostMaid = nil
local function applyFpsBoost(en)
    pcall(function()
        if en then
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            local function p(v)
                if v:IsA("BasePart") then
                    v.CastShadow = false
                    v.Material = Enum.Material.SmoothPlastic
                    v.Reflectance = 0
                elseif v:IsA("Decal") or v:IsA("Texture") then
                    v.Transparency = 1
                elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
                    v.Enabled = false
                end
            end
            for _, v in ipairs(Workspace:GetDescendants()) do p(v) end
            if not fpsBoostMaid then
                fpsBoostMaid = Workspace.DescendantAdded:Connect(function(v)
                    if state.fpsBoost then p(v) end
                end)
            end
        else
            Lighting.GlobalShadows = true
            if fpsBoostMaid then fpsBoostMaid:Disconnect(); fpsBoostMaid = nil end
        end
    end)
end

setToggleState = function(key, value)
    pcall(function()
        if key == "antiRagdoll" then value = true end
        local prev = state[key]
        state[key] = value
        if (key == "farm" or key == "xpFarm") and prev == true and value == false then
            if stopFarm then task.spawn(stopFarm) end
        end
        if key == "farm" then
            if value == true and prev == false then
                if not state.farmTimerStart or state.farmTimerStart == 0 then
                    state.farmTimerStart = os.time()
                end
            elseif value == false then
                state.farmTimerStart = 0
            end
        end
        if prev ~= value and not nExcl[key] then
            local n = toggleDisplayNames[key] or key
            local c = value and "#5aff8c" or "#ff5a5a"
            notify('<font color="' .. c .. '">' .. n .. '</font> ' .. (value and "enabled" or "disabled"))
        end
        if value then
            if key == "aimbotMurderer" then
                state.aimbotSheriff = false
                updateViz("aimbotSheriff")
            elseif key == "aimbotSheriff" then
                state.aimbotMurderer = false
                updateViz("aimbotMurderer")
            elseif key == "farm" then
                state.xpFarm = false
                updateViz("xpFarm")
            elseif key == "xpFarm" then
                state.farm = false
                updateViz("farm")
            end
        end
        updateViz(key)
        if key == "disable3d" then
            applyLowDeviceOptimizations(state.disable3d)
        elseif key == "fullbright" then
            pcall(function()
                if state.fullbright then
                    Lighting.Brightness = 3
                    Lighting.Ambient = Color3.fromRGB(178, 178, 178)
                    Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
                    Lighting.FogEnd = 100000
                else
                    Lighting.Brightness = 1
                    Lighting.Ambient = Color3.fromRGB(70, 70, 70)
                    Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
                end
            end)
        elseif key == "fpsBoost" then
            applyFpsBoost(state.fpsBoost)
        elseif key == "quickTogglesVisible" and quickFrame then
            quickFrame.Visible = state.quickTogglesVisible
        elseif key == "circleButtonsEnabled" then
            if updateCircleViz then updateCircleViz() end
        elseif key == "crosshairEnabled" or key == "crosshairHideShiftLock"
            or key == "crosshairDot" or key == "crosshairShiftLockOnly"
            or key == "crosshairSpin" or key == "customShiftLockButton" then
            if applyCrosshair then applyCrosshair() end
            if updateShiftLockVisual then updateShiftLockVisual() end
        elseif key == "showRoundTimerCountdown" and not value then
            if roundTimerFrame then roundTimerFrame.Visible = false end
        end
        saveSettings()
    end)
end

updateViz = function(key)
    if mainTgls and mainTgls[key] then
        local d = mainTgls[key]
        local on = state[key]
        local pillC = on and Color3.new(1,1,1) or Color3.fromRGB(32,32,32)
        local innerC = on and Color3.new(1,1,1) or Color3.fromRGB(22,22,22)
        local dotPos = on and UDim2.new(1, -20*selectedScale, 0.5, -8*selectedScale)
                          or UDim2.new(0, 4*selectedScale, 0.5, -8*selectedScale)
        local dotC = on and Color3.new(0,0,0) or Color3.fromRGB(200,200,200)
        TweenService:Create(d.pill, TweenInfo.new(animTime(0.28), getAnimStyle()), {BackgroundColor3 = pillC}):Play()
        if d.inner then
            TweenService:Create(d.inner, TweenInfo.new(animTime(0.28), getAnimStyle()), {BackgroundColor3 = innerC}):Play()
        end
        TweenService:Create(d.dot, TweenInfo.new(animTime(0.42), Enum.EasingStyle.Elastic), {
            Position = dotPos,
            BackgroundColor3 = dotC
        }):Play()
    end
    if quickTgls and quickTgls[key] then
        local d = quickTgls[key]
        local on = state[key]
        local bg = on and Color3.new(1,1,1) or Color3.fromRGB(18,18,18)
        local tc = on and Color3.new(0,0,0) or Color3.fromRGB(220,220,220)
        TweenService:Create(d.row, TweenInfo.new(animTime(0.25), getAnimStyle()), {BackgroundColor3 = bg}):Play()
        TweenService:Create(d.txt, TweenInfo.new(animTime(0.25)), {TextColor3 = tc}):Play()
    end
    if _G.circleButtonsList then
        for _, item in ipairs(_G.circleButtonsList) do
            if item.cfg.id == key then
                local b = item.btn
                if b and b.Parent then
                    local info = circleActionMap[key]
                    if info and info.type ~= "action" then
                        local on = state[key]
                        if on then
                            b.BackgroundColor3 = Color3.new(1,1,1)
                            b.TextColor3 = Color3.new(0,0,0)
                            b.TextStrokeTransparency = 1
                        else
                            b.BackgroundColor3 = Color3.new(0,0,0)
                            b.TextColor3 = Color3.new(1,1,1)
                            b.TextStrokeTransparency = 1
                        end
                    end
                end
            end
        end
    end
end

