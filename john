EASE_IN = Enum.EasingDirection.In

spinGradients = {}
local SPIN_SPEED = 130
local PULSE_SPEED = 0.9
local PULSE_MIN = 0.6
local PULSE_MAX = 1.8

local BLACK = Color3.new(0,0,0)
local WHITE = Color3.new(1,1,1)

local function buildAltSeq(firstColor, secondColor)
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0.000, firstColor),
        ColorSequenceKeypoint.new(0.166, firstColor),
        ColorSequenceKeypoint.new(0.166, secondColor),
        ColorSequenceKeypoint.new(0.333, secondColor),
        ColorSequenceKeypoint.new(0.333, firstColor),
        ColorSequenceKeypoint.new(0.500, firstColor),
        ColorSequenceKeypoint.new(0.500, secondColor),
        ColorSequenceKeypoint.new(0.666, secondColor),
        ColorSequenceKeypoint.new(0.666, firstColor),
        ColorSequenceKeypoint.new(0.833, firstColor),
        ColorSequenceKeypoint.new(0.833, secondColor),
        ColorSequenceKeypoint.new(1.000, secondColor),
    })
end

local function setSpinGradColors(grad, isOn)
    if not grad then return end
    if isOn then grad.Color = buildAltSeq(WHITE, BLACK)
    else grad.Color = buildAltSeq(BLACK, WHITE) end
end

local function attachSpinStroke(stroke, isOn, opts)
    if not stroke then return nil end
    opts = opts or {}
    stroke.Color = WHITE
    pcall(function() stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border end)
    local existing = stroke:FindFirstChild("SpinGrad")
    local grad
    if existing then grad = existing
    else
        grad = Instance.new("UIGradient", stroke)
        grad.Name = "SpinGrad"
        grad.Rotation = 0
        table.insert(spinGradients, grad)
    end
    setSpinGradColors(grad, isOn)
    if opts.pulse ~= false and not stroke:GetAttribute("Breathing") then
        stroke:SetAttribute("Breathing", true)
        local baseThickness = opts.baseThickness or stroke.Thickness or 2
        local minT = math.max(1, baseThickness * PULSE_MIN)
        local maxT = baseThickness * PULSE_MAX
        task.spawn(function()
            while stroke and stroke.Parent do
                if state.animationsEnabled == false then
                    stroke.Thickness = baseThickness
                    task.wait(0.4)
                else
                    TweenService:Create(stroke, TweenInfo.new(PULSE_SPEED, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Thickness = maxT}):Play()
                    task.wait(PULSE_SPEED)
                    if not stroke or not stroke.Parent then break end
                    TweenService:Create(stroke, TweenInfo.new(PULSE_SPEED, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Thickness = minT}):Play()
                    task.wait(PULSE_SPEED)
                end
            end
        end)
    end
    return grad
end

task.spawn(function()
    local rot = 0
    local wobbleT = 0
    while true do
        local dt = RunService.Heartbeat:Wait()
        if state.animationsEnabled == false then
            for i = #spinGradients, 1, -1 do
                local g = spinGradients[i]
                if not g or not g.Parent then table.remove(spinGradients, i) end
            end
        else
            wobbleT = wobbleT + dt
            local wobble = 1 + math.sin(wobbleT * 1.4) * 0.15
            rot = (rot + dt * SPIN_SPEED * wobble) % 360
            for i = #spinGradients, 1, -1 do
                local g = spinGradients[i]
                if g and g.Parent then g.Rotation = rot
                else table.remove(spinGradients, i) end
            end
        end
    end
end)

