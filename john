                    local n = d.Name
                    local ln = string.lower(n)
                    if n == "THICC" or n == "Glitchproof" or n == "Glitch"
                        or string.find(ln, "glitchproof", 1, true)
                        or string.find(ln, "glitch", 1, true) then
                        seen[d] = true
                        table.insert(parts, d)
                    end
                end
            end
        end
    end
    return parts
end

function setBarriersRemoved(remove)
    local parts = collectBarrierParts()
    for _, p in ipairs(parts) do
        pcall(function()
            if remove then
                if barrierOrigProps[p] == nil then
                    barrierOrigProps[p] = {
                        CanCollide = p.CanCollide,
                        Transparency = p.Transparency,
                        CanTouch = p.CanTouch,
                        CanQuery = p.CanQuery,
                    }
                end
                p.CanCollide = false
                p.CanTouch = false
                p.CanQuery = false
                p.Transparency = 1
            else
                local o = barrierOrigProps[p]
                if o then
                    p.CanCollide = o.CanCollide
                    p.CanTouch = o.CanTouch
                    p.CanQuery = o.CanQuery
                    p.Transparency = o.Transparency
                    barrierOrigProps[p] = nil
                end
            end
        end)
    end
end

