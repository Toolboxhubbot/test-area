RunService.RenderStepped:Connect(function()
    if not alive() then return end
    if not (state.aimbotMurderer or state.aimbotSheriff) then return end
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local vps = cam.ViewportSize
    local center = Vector2.new(vps.X * 0.5, vps.Y * 0.5)
    local target = nil
    if state.aimbotMurderer then target = getMurd()
    elseif state.aimbotSheriff then target = getLiveSheriffHeroes()[1] end
    if not target or not target.Character then return end
    local h = target.Character:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return end
    local tpart = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
    if not tpart then return end
    if state.aimbotUseFOV ~= false then
        local sp, onScreen = cam:WorldToViewportPoint(tpart.Position)
        if not onScreen or sp.Z <= 0 then return end
        if (Vector2.new(sp.X, sp.Y) - center).Magnitude > (state.aimbotFOV or 250) then return end
    end
    Workspace.CurrentCamera.CFrame = CFrame.lookAt(cam.CFrame.Position, tpart.Position)
end)

