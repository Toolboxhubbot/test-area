function reliableFling(tp, forceManual)
    if not tp or tp==LP or not tp.Parent then return false end
    if not targetIsAlive(tp) then return false end
    if isResetActive(tp.UserId) then return false end
    if isWhitelisted(tp) then return false end
    if not forceManual then
        local ok = state.loopFlingAll or state.loopFlingMur or state.loopFlingSheriff or state.loopFlingCustom or state.flingAura
        if not ok then return false end
    end
    local Character = LP.Character
    if not Character then return false end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart
    local TCharacter = tp.Character
    if not (Character and Humanoid and RootPart and TCharacter) then return false end
    local TRootPart = TCharacter:FindFirstChild("HumanoidRootPart")
    local THead = TCharacter:FindFirstChild("Head")
    if not TRootPart then return false end

    flingActiveCount = flingActiveCount + 1
    isLocalFlinging = true

    local savedCF = RootPart.CFrame
    Humanoid.PlatformStand = true
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(0,-50000,0)
    bv.Parent = RootPart
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 1000000
    bg.CFrame = RootPart.CFrame
    bg.Parent = RootPart
    local origDH = Workspace.FallenPartsDestroyHeight
    Workspace.FallenPartsDestroyHeight = -100000
    local startTime = tick()
    activeResets[tp.UserId] = startTime
    local conn, cleaned = nil, false
    local function cleanup()
        if cleaned then return end
        cleaned = true
        pcall(function()
            Workspace.FallenPartsDestroyHeight = origDH
            if bv and bv.Parent then bv:Destroy() end
            if bg and bg.Parent then bg:Destroy() end
            if Humanoid and Humanoid.Parent then
                Humanoid.PlatformStand = false
                for _,t in ipairs(Humanoid:GetPlayingAnimationTracks()) do t:Stop() end
            end
            if RootPart and RootPart.Parent then
                RootPart.AssemblyLinearVelocity = Vector3.zero
                RootPart.AssemblyAngularVelocity = Vector3.zero
                RootPart.CFrame = savedCF
            end
            if Humanoid and Humanoid.Parent then pcall(function() Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
            if Character and Character.Parent then
                for _,p in ipairs(Character:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = true end
                end
            end
            if conn then conn:Disconnect() end
        end)
        activeResets[tp.UserId] = nil
        flingActiveCount = flingActiveCount - 1
        if flingActiveCount <= 0 then
            flingActiveCount = 0
            isLocalFlinging = false
        end
    end
    conn = RunService.Heartbeat:Connect(function()
        if tick()-startTime > RESET_DURATION or not tp.Character or not TRootPart.Parent or not Character.Parent then
            cleanup(); return
        end
        if TRootPart and TRootPart.Parent and RootPart and RootPart.Parent then
            local targetPos = THead and THead.Position or TRootPart.Position
            local neckPos = targetPos - Vector3.new(0, 0.5, 0)
            RootPart.CFrame = CFrame.new(neckPos) * CFrame.Angles(math.pi/2, 0, 0)
            RootPart.AssemblyLinearVelocity = Vector3.new(0,-50000,0)
            RootPart.AssemblyAngularVelocity = Vector3.new(7500,7500,7500)
            local dir = TRootPart.Position - RootPart.Position
            if dir.Magnitude > 0.01 then bv.Velocity = dir.Unit * 50000 end
            bg.CFrame = RootPart.CFrame
        end
    end)
    local timeout = tick() + RESET_DURATION + 1
    while activeResets[tp.UserId] and tick() < timeout do task.wait(0.05) end
    cleanup()
    return true
end

function executeHitboxKill(tp)
    if not tp or not tp.Parent then return end
    if killLocked[tp.UserId] then return end
    killLocked[tp.UserId] = true
    pcall(function()
        local tc = tp.Character
        if not tc then return end
        local tr = tc:FindFirstChild("HumanoidRootPart")
        local th = tc:FindFirstChildOfClass("Humanoid")
        if not (th and th.Health > 0 and tr) then return end
        local mr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not mr then return end
        local k = LP.Character:FindFirstChild("Knife") or equipTool("Knife")
        if not k then return end
        local origSize = tr.Size
        local origTrans = tr.Transparency
        local origCanCollide = tr.CanCollide
        pcall(function()
            tr.Size = Vector3.new(2000, 2000, 2000)
            tr.Transparency = 1
            tr.CanCollide = false
        end)
        local startTime = tick()
        while tick() - startTime < 0.5 do
            if not targetIsAlive(tp) then break end
            local kHandle = k:FindFirstChild("Handle")
            if kHandle and tr and tr.Parent then
                pcall(function() k:Activate() end)
                pcall(function() firetouchinterest(tr, kHandle, 0) firetouchinterest(tr, kHandle, 1) end)
                pcall(function() firetouchinterest(mr, tr, 0) firetouchinterest(mr, tr, 1) end)
            end
            task.wait(0.05)
        end
        task.wait(0.05)
        pcall(function()
            if tr and tr.Parent then
                tr.Size = origSize
                tr.Transparency = origTrans
                tr.CanCollide = origCanCollide
            end
        end)
    end)
    killLocked[tp.UserId] = nil
end

