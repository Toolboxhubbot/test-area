-- Force real character parts invisible (this replicates to other clients
-- because the LocalPlayer owns its character's parts)
local function applyRealInvisibility()
    if not LP.Character then return end
    for _, d in ipairs(LP.Character:GetDescendants()) do
        if d:IsA("BasePart") then
            if invisSavedTransparency[d] == nil then
                invisSavedTransparency[d] = d.Transparency
            end
            if invisSavedCanCollide[d] == nil then
                invisSavedCanCollide[d] = d.CanCollide
            end
            d.Transparency = 1
            d.CanCollide = false
            d.CanTouch = false
        elseif d:IsA("Decal") or d:IsA("Texture") then
            if invisSavedTransparency[d] == nil then
                invisSavedTransparency[d] = d.Transparency
            end
            d.Transparency = 1
        end
    end
end

local function restoreRealVisibility()
    for part, trans in pairs(invisSavedTransparency) do
        if part and part.Parent then
            pcall(function() part.Transparency = trans end)
        end
    end
    for part, cc in pairs(invisSavedCanCollide) do
        if part and part.Parent then
            pcall(function() part.CanCollide = cc end)
        end
    end
    invisSavedTransparency = {}
    invisSavedCanCollide = {}
end

local function startInvisible()
    if invisActive then return end
    if not LP.Character then return end
    local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    invisSavedCFrame = hrp.CFrame
    invisSavedAnchored = hrp.Anchored
    invisVirtualPos = hrp.Position
    invisVirtualVel = Vector3.zero

    createGhost()

    local cam = Workspace.CurrentCamera
    if cam and ghostModel then
        local ghostRoot = ghostModel:FindFirstChild("HumanoidRootPart") or ghostModel.PrimaryPart
        if ghostRoot then cam.CameraSubject = ghostRoot end
    end

    -- Make the real body invisible to everyone (client-owned → replicates)
    applyRealInvisibility()

    -- Park the real character far below the map so even if the transparency
    -- somehow fails to replicate, they're nowhere near the action
    hrp.Anchored = true
    hrp.CFrame = HIDE_POS

    invisActive = true
    setStatus("Invisible (hide mode) ON")
end

local function stopInvisible()
    if not invisActive then return end
    invisActive = false

    restoreRealVisibility()

    if LP.Character then
        local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        if hrp then
            hrp.Anchored = invisSavedAnchored
            if invisSavedCFrame then hrp.CFrame = invisSavedCFrame end
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
        if hum then
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        local cam = Workspace.CurrentCamera
        if cam and hum then cam.CameraSubject = hum end
    end

    destroyGhost()
    invisSavedCFrame = nil
    invisVirtualPos = nil
    invisVirtualVel = Vector3.zero
    setStatus("Invisible OFF")
end

