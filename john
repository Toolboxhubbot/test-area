local function clearPlayerESP(plr)
    local e = espCache[plr]
    if not e then return end
    pcall(function()
        if e.hl then e.hl:Destroy() end
        if e.bb then e.bb:Destroy() end
        if e.skelFolder then e.skelFolder:Destroy() end
        if e.boxFrame then e.boxFrame:Destroy() end
        if e.tracer then e.tracer:Destroy() end
        if e.cornerSegs then for _, s in ipairs(e.cornerSegs) do s:Destroy() end end
        if e.chevron then e.chevron:Destroy() end
    end)
    espCache[plr] = nil
end

local function drawLine(frame, pA, pB, thickness)
    local dx = pB.X - pA.X
    local dy = pB.Y - pA.Y
    local len = math.sqrt(dx * dx + dy * dy)
    if len < 0.1 then frame.Visible = false; return end
    local ang = math.deg(math.atan2(dy, dx))
    frame.Position = UDim2.new(0, pA.X, 0, pA.Y)
    frame.Size = UDim2.new(0, len, 0, thickness or 1.5)
    frame.Rotation = ang
    frame.Visible = true
end

local function updatePlayerESP(plr)
    local ch = plr.Character
    local h = ch and ch:FindFirstChildOfClass("Humanoid")
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not (ch and h and hrp and h.Health > 0) then
        local e = espCache[plr]
        if e then
            if e.hl then e.hl.Enabled = false end
            if e.bb then e.bb.Enabled = false end
            if e.skelFolder then e.skelFolder.Visible = false end
            if e.boxFrame then e.boxFrame.Visible = false end
            if e.tracer then e.tracer.Visible = false end
            if e.cornerSegs then for _, s in ipairs(e.cornerSegs) do s.Visible = false end end
            if e.chevron then e.chevron.Visible = false end
        end
        return
    end
    if not espCache[plr] then createPlayerESP(plr) end
    local e = espCache[plr]
    if not e then return end
    local role = getPlayerRole(plr)
    local col = state.espTeamColor and roleColor(role) or Color3.fromRGB(255, 255, 255)
    local master = state.espPlayers
    local cam = Workspace.CurrentCamera
    local dist = 0
    if cam then dist = (cam.CFrame.Position - hrp.Position).Magnitude end
    local inFOV = dist <= (state.espFOV or 500)

    if e.hl then
        e.hl.Enabled = master and state.espChams and inFOV
        e.hl.Adornee = ch
        e.hl.FillColor = col
        e.hl.FillTransparency = 0.55
        e.hl.OutlineColor = col
        e.hl.OutlineTransparency = 0.1
    end
    if e.bb then
        e.bb.Enabled = master and inFOV and (state.espName or state.espDistance or state.espHealthBar)
        e.bb.Adornee = hrp
        if e.nameLbl then
            e.nameLbl.Visible = state.espName
            e.nameLbl.Text = plr.Name .. " [" .. role .. "]"
            e.nameLbl.TextColor3 = col
        end
        if e.distLbl then
            e.distLbl.Visible = state.espDistance
            e.distLbl.Text = string.format("[%d studs]", math.floor(dist))
        end
        if e.hpBg and e.hpFill then
            e.hpBg.Visible = state.espHealthBar
            local hpRatio = math.clamp(h.Health / h.MaxHealth, 0, 1)
            e.hpFill.Size = UDim2.new(hpRatio, 0, 1, 0)
            local hpc
            if hpRatio > 0.5 then hpc = Color3.fromRGB(90, 220, 90)
            elseif hpRatio > 0.25 then hpc = Color3.fromRGB(255, 200, 80)
            else hpc = Color3.fromRGB(255, 80, 80) end
            e.hpFill.BackgroundColor3 = hpc
        end
    end
    if e.boxFrame then
        local boxOn = master and state.espBox and inFOV
        e.boxFrame.Visible = boxOn
        if boxOn and cam then
            local okBB, cfBB, sizeBB = pcall(function() return ch:GetBoundingBox() end)
            if okBB and cfBB then
                local top = cfBB * CFrame.new(0, sizeBB.Y / 2, 0)
                local bottom = cfBB * CFrame.new(0, -sizeBB.Y / 2, 0)
                local topScreen, topOn = cam:WorldToViewportPoint(top.Position)
                local bottomScreen, bottomOn = cam:WorldToViewportPoint(bottom.Position)
                if topOn and bottomOn and topScreen.Z > 0 and bottomScreen.Z > 0 then
                    local height = math.abs(bottomScreen.Y - topScreen.Y)
                    local width = height * 0.55
                    e.boxFrame.Position = UDim2.new(0, topScreen.X - width / 2, 0, topScreen.Y)
                    e.boxFrame.Size = UDim2.new(0, width, 0, height)
                    e.boxFrame.BorderColor3 = col
                else
                    e.boxFrame.Visible = false
                end
            end
        end
    end
    if e.cornerSegs then
        local cornerOn = master and state.espCornerBox and inFOV
        if cornerOn and cam then
            local okBB, cfBB, sizeBB = pcall(function() return ch:GetBoundingBox() end)
            if okBB and cfBB then
                local top = cfBB * CFrame.new(0, sizeBB.Y / 2, 0)
                local bottom = cfBB * CFrame.new(0, -sizeBB.Y / 2, 0)
                local ts, tOn = cam:WorldToViewportPoint(top.Position)
                local bs, bOn = cam:WorldToViewportPoint(bottom.Position)
                if tOn and bOn and ts.Z > 0 and bs.Z > 0 then
                    local H = math.abs(bs.Y - ts.Y)
                    local W = H * 0.55
                    local x1 = ts.X - W / 2
                    local y1 = ts.Y
                    local x2 = ts.X + W / 2
                    local y2 = bs.Y
                    local arm = math.min(W, H) * 0.2
                    local seg = {
                        {x1, y1, arm, 2}, {x1, y1, 2, arm},
                        {x2 - arm, y1, arm, 2}, {x2, y1, 2, arm},
                        {x1, y2, arm, 2}, {x1, y2 - arm, 2, arm},
                        {x2 - arm, y2, arm, 2}, {x2, y2 - arm, 2, arm},
                    }
                    for i, s in ipairs(seg) do
                        local f = e.cornerSegs[i]
                        if f then
                            f.Position = UDim2.new(0, s[1], 0, s[2])
                            f.Size = UDim2.new(0, s[3], 0, s[4])
                            f.BackgroundColor3 = col
                            f.Visible = true
                        end
                    end
                else
                    for _, s in ipairs(e.cornerSegs) do s.Visible = false end
                end
            end
        else
            for _, s in ipairs(e.cornerSegs) do s.Visible = false end
        end
    end
    if e.chevron and e.chevronInner then
        local arrowOn = master and state.espOffscreen and inFOV
        if arrowOn and cam then
            local sp, onScreen = cam:WorldToViewportPoint(hrp.Position)
            local vps = cam.ViewportSize
            local cx, cy = vps.X * 0.5, vps.Y * 0.5
            if onScreen and sp.Z > 0 and sp.X >= 0 and sp.X <= vps.X and sp.Y >= 0 and sp.Y <= vps.Y then
                e.chevron.Visible = false
            else
                local dirX, dirY
                if onScreen and sp.Z > 0 then
                    dirX, dirY = sp.X - cx, sp.Y - cy
                else
                    local rel = hrp.Position - cam.CFrame.Position
                    dirX = rel:Dot(cam.CFrame.RightVector)
                    dirY = -rel:Dot(cam.CFrame.UpVector)
                end
                local m = math.sqrt(dirX * dirX + dirY * dirY)
                if m > 0 then dirX, dirY = dirX / m, dirY / m
                else dirX, dirY = 0, -1 end
                local tx = (vps.X * 0.45) / math.max(0.001, math.abs(dirX))
                local ty = (vps.Y * 0.45) / math.max(0.001, math.abs(dirY))
                local t = math.min(tx, ty)
                e.chevron.Position = UDim2.new(0, cx + dirX * t - 10, 0, cy + dirY * t - 10)
                e.chevron.BackgroundColor3 = col
                e.chevron.Visible = true
            end
        else
            e.chevron.Visible = false
        end
    end
    if e.skelFolder and e.skelLines then
        local skelOn = master and state.espSkeleton and inFOV
        e.skelFolder.Visible = skelOn
        if skelOn and cam then
            local pairs_, motorMap = getSkeletonPairs(ch)
            if pairs_ then
                for i, line in ipairs(e.skelLines) do
                    local pair = pairs_[i]
                    if pair then
                        local a = ch:FindFirstChild(pair[1])
                        local b = ch:FindFirstChild(pair[2])
                        if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
                            local posA = getPartJointWorldPos(a, motorMap) or a.Position
                            local posB = getPartJointWorldPos(b, motorMap) or b.Position
                            local pA, onA = cam:WorldToViewportPoint(posA)
                            local pB, onB = cam:WorldToViewportPoint(posB)
                            if onA and onB and pA.Z > 0 and pB.Z > 0 then
                                line.BackgroundColor3 = col
                                drawLine(line, Vector2.new(pA.X, pA.Y), Vector2.new(pB.X, pB.Y), 2)
                            else
                                line.Visible = false
                            end
                        else
                            line.Visible = false
                        end
                    else
                        line.Visible = false
                    end
                end
            else
                for _, line in ipairs(e.skelLines) do line.Visible = false end
            end
        end
    end
    if e.tracer then
        local tracerOn = master and state.espTracer and inFOV
        if tracerOn and cam then
            local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
            if onScreen and screenPos.Z > 0 then
                e.tracer.BackgroundColor3 = col
                local vps = cam.ViewportSize
                drawLine(e.tracer, Vector2.new(vps.X * 0.5, vps.Y),
                    Vector2.new(screenPos.X, screenPos.Y), state.espTracerThick or 2)
            else
                e.tracer.Visible = false
            end
        else
            e.tracer.Visible = false
        end
    end
end

