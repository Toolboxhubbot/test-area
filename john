    local ray = c:ViewportPointToRay(x, y)
    local p = RaycastParams.new()
    if LP.Character then p.FilterDescendantsInstances = {LP.Character} end
    p.FilterType = Enum.RaycastFilterType.Exclude
    local res = Workspace:Raycast(ray.Origin, ray.Direction * 2000, p)
    if res then return res.Position end
    return ray.Origin + ray.Direction * 60
