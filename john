local function getTPScreen(x, y)
    local c = Workspace.CurrentCamera
    if not c then return nil end
    local ray = c:ViewportPointToRay(x, y)
    local p = RaycastParams.new()
    if LP.Character then p.FilterDescendantsInstances = {LP.Character} end
    p.FilterType = Enum.RaycastFilterType.Exclude
    local res = Workspace:Raycast(ray.Origin, ray.Direction * 2000, p)
    if res then return res.Position end
    return ray.Origin + ray.Direction * 60
end
local function doClickTP(x, y)
    if not state.clickTP then return end
    local r = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not r then return end
    local p = getTPScreen(x, y)
    if p then
        r.CFrame = CFrame.new(p + Vector3.new(0, 3, 0))
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
end
