        pad.PaddingLeft=UDim.new(0,12)
        Instance.new("UICorner",optBtn).CornerRadius=UDim.new(0,6)
        optBtn.MouseEnter:Connect(function()
            if not anim() then return end
            TweenService:Create(optBtn,TweenInfo.new(0.15),{BackgroundTransparency=0}):Play()
        end)
        optBtn.MouseLeave:Connect(function()
            if not anim() then return end
            TweenService:Create(optBtn,TweenInfo.new(0.15),{BackgroundTransparency=0.4}):Play()
        end)
        optBtn.MouseButton1Click:Connect(function()
            current=opt
            val.Text=tostring(opt)
            setOpen(false)
            if onSelect then pcall(onSelect,opt) end
        end)
    end
    header.MouseButton1Click:Connect(function() setOpen(not open) end)
    return wrapper,function() return current end,function(nv) current=nv; val.Text=tostring(nv) end
end

