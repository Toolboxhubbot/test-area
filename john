local function getMapNames()
    local mn = {"Slot 1: N/A", "Slot 2: N/A", "Slot 3: N/A"}
    local bs = {}
    for _, o in ipairs(Workspace:GetDescendants()) do
        if o:IsA("SurfaceGui") then
            local p = o.Adornee or o.Parent
            if p and p:IsA("BasePart") then
                local ivb, pn = false, nil
                for _, l in ipairs(o:GetDescendants()) do
                    if l:IsA("TextLabel") and l.Visible then
                        local tx, ltx = l.Text, string.lower(l.Text)
                        if string.match(ltx, "votes:") then ivb = true
                        elseif tx ~= "" and ltx ~= "map name" and ltx ~= "label" and ltx ~= "0" then pn = tx end
                    end
                end
                if ivb and pn then table.insert(bs, {Name = pn, Pos = p.Position}) end
            end
        end
    end
    for i, sp in ipairs(Spots) do
        local cd, cn = 45, "N/A"
        for _, b in ipairs(bs) do
            local d = (b.Pos - sp).Magnitude
            if d < cd then cd = d; cn = b.Name end
        end
        mn[i] = "Slot " .. i .. ": " .. cn
    end
    return mn
