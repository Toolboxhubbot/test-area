-- ============ SPIN STROKE ============
local spinGradients={}
local SPIN_SPEED=130
local PULSE_SPEED=0.9

local function buildAltSeq(a,b)
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0.000,a),ColorSequenceKeypoint.new(0.166,a),
        ColorSequenceKeypoint.new(0.166,b),ColorSequenceKeypoint.new(0.333,b),
        ColorSequenceKeypoint.new(0.333,a),ColorSequenceKeypoint.new(0.500,a),
        ColorSequenceKeypoint.new(0.500,b),ColorSequenceKeypoint.new(0.666,b),
        ColorSequenceKeypoint.new(0.666,a),ColorSequenceKeypoint.new(0.833,a),
        ColorSequenceKeypoint.new(0.833,b),ColorSequenceKeypoint.new(1.000,b),
    })
end

local function setSpinGradColors(grad,isOn)
    if not grad then return end
    if isOn then grad.Color=buildAltSeq(WHITE,cc3(settingsConfig.accentColor))
    else grad.Color=buildAltSeq(cc3(settingsConfig.accentColor),BLACK) end
end

local function attachSpinStroke(stroke,isOn,opts)
    if not stroke then return nil end
    opts=opts or {}
    stroke.Color=WHITE
    pcall(function() stroke.ApplyStrokeMode=Enum.ApplyStrokeMode.Border end)
    local existing=stroke:FindFirstChild("SpinGrad")
    local grad
    if existing then grad=existing
    else
        grad=Instance.new("UIGradient",stroke)
        grad.Name="SpinGrad"
        grad.Rotation=0
        table.insert(spinGradients,grad)
    end
    setSpinGradColors(grad,isOn)
    if opts.pulse~=false and not stroke:GetAttribute("Breathing") then
        stroke:SetAttribute("Breathing",true)
        local baseT=opts.baseThickness or stroke.Thickness or 2
        local minT=math.max(1,baseT*0.6)
        local maxT=baseT*1.8
        task.spawn(function()
            while stroke and stroke.Parent do
                if anim() then
                    TweenService:Create(stroke,TweenInfo.new(PULSE_SPEED,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{Thickness=maxT}):Play()
                    task.wait(PULSE_SPEED)
                    if not stroke or not stroke.Parent then break end
                    TweenService:Create(stroke,TweenInfo.new(PULSE_SPEED,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{Thickness=minT}):Play()
                    task.wait(PULSE_SPEED)
                else
                    stroke.Thickness=baseT
                    task.wait(0.25)
                end
            end
        end)
    end
    return grad
end

task.spawn(function()
    local rot=0
    local wob=0
    while true do
        local dt=RunService.Heartbeat:Wait()
        if anim() then
            wob=wob+dt
            local w=1+math.sin(wob*1.4)*0.15
            rot=(rot+dt*SPIN_SPEED*w)%360
            for i=#spinGradients,1,-1 do
                local g=spinGradients[i]
                if g and g.Parent then g.Rotation=rot
                else table.remove(spinGradients,i) end
            end
        else
            task.wait(0.1)
        end
    end
end)

