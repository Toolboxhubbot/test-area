local function buildCircleButton(cfg)
    local btn = Instance.new("TextButton")
    btn.Name = "AWC_" .. cfg.name
    btn.Size = UDim2.new(0, cfg.size, 0, cfg.size)
    btn.Position = UDim2.new(0, cfg.x, 0, cfg.y)
    btn.BackgroundColor3 = Color3.new(0, 0, 0)
    btn.BackgroundTransparency = 0
    btn.Text = cfg.name
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = math.clamp(math.floor(cfg.size * 0.24), 9, 16)
    btn.TextWrapped = true
    btn.AutoButtonColor = false
    btn.BorderSizePixel = 0
    btn.Active = true
    btn.ZIndex = 5
    btn.Visible = cfg.enabled and state.circleButtonsEnabled
    btn.Parent = circleGui
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = Color3.new(1, 1, 1)
    stroke.Thickness = 1.5
    stroke.Transparency = 0.35
    btn.TextStrokeColor3 = Color3.new(0, 0, 0)
    btn.TextStrokeTransparency = 0.4

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30,30,30)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        if circleDrag and circleDrag.btn == btn then return end
        TweenService:Create(btn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.new(0,0,0)}):Play()
    end)

    btn.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if circleDrag then return end
        local myDrag = {
            btn = btn,
            action = cfg.action,
            dragStart = input.Position,
            startPos = btn.Position,
            moved = false,
            dragAllowed = false,
        }
        circleDrag = myDrag
        TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(45,45,45)}):Play()
        task.delay(CIRCLE_DRAG_HOLD, function()
            if circleDrag == myDrag then
                myDrag.dragAllowed = true
                TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.35}):Play()
            end
        end)
    end)

    return btn
end

UIS.InputChanged:Connect(function(input)
    if not circleDrag then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
       and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if not circleDrag.dragAllowed then return end
    local delta = input.Position - circleDrag.dragStart
    if delta.Magnitude > CIRCLE_DRAG_THRESHOLD then
        circleDrag.moved = true
    end
    if circleDrag.moved then
        circleDrag.btn.Position = UDim2.new(
            circleDrag.startPos.X.Scale,
            circleDrag.startPos.X.Offset + delta.X,
            circleDrag.startPos.Y.Scale,
            circleDrag.startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if not circleDrag then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
       and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local d = circleDrag
    circleDrag = nil
    if not d.btn or not d.btn.Parent then return end
    d.btn.BackgroundTransparency = 0
    TweenService:Create(d.btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.new(0,0,0)}):Play()

    if d.moved then
        for _, c in ipairs(settingsConfig.circleButtons) do
            if c.action == d.action then
                local abs = d.btn.Position
                c.x = abs.X.Offset
                c.y = abs.Y.Offset
                break
            end
        end
        saveSettings()
        return
    end

    if d.action == "killAll" then
        killAllNow(); flashBtn(d.btn, 0.4)
    elseif d.action == "grabGun" then
        local ok = cDoGrabGun(); flashBtn(d.btn, 0.4)
    elseif d.action == "flingSheriff" then
        flingSheriffNow(); flashBtn(d.btn, 0.6)
    elseif d.action == "tpMap" then
        teleportToMap(); flashBtn(d.btn, 0.4)
    elseif d.action == "savePos" then
        saveCurrentPos(); flashBtn(d.btn, 0.4)
    end
end)

