            TweenService:Create(wrapper, TweenInfo.new(0.30, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, 44 + targetH + 2)}):Play()
        else
            TweenService:Create(list, TweenInfo.new(0.22, EASE_SMOOTH, EASE_IN), {Size = UDim2.new(1, 0, 0, 0)}):Play()
            TweenService:Create(wrapper, TweenInfo.new(0.22, EASE_SMOOTH, EASE_IN), {Size = UDim2.new(1, 0, 0, 44)}):Play()
            task.delay(0.24, function() if not open then list.Visible = false end end)
        end
    end
    for i, opt in ipairs(options) do
        local optBtn = Instance.new("TextButton", list)
        optBtn.Size = UDim2.new(1, 0, 0, OPTION_H)
        optBtn.LayoutOrder = i
        optBtn.BackgroundColor3 = cc3(settingsConfig.cardHoverColor)
        optBtn.Text = tostring(opt)
        optBtn.TextColor3 = cc3(settingsConfig.textColor)
        optBtn.Font = Enum.Font.GothamMedium
        optBtn.TextSize = 14
        optBtn.TextXAlignment = Enum.TextXAlignment.Left
        optBtn.AutoButtonColor = false
        optBtn.ZIndex = 6
        local pad = Instance.new("UIPadding", optBtn)
        pad.PaddingLeft = UDim.new(0, 12)
        Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0, 6)
        optBtn.MouseEnter:Connect(function()
            if state.animationsEnabled == false then return end
            TweenService:Create(optBtn, TweenInfo.new(0.15), {BackgroundColor3 = cc3(settingsConfig.accentColor), TextColor3 = Color3.new(0,0,0)}):Play()
        end)
        optBtn.MouseLeave:Connect(function()
            if state.animationsEnabled == false then return end
            TweenService:Create(optBtn, TweenInfo.new(0.15), {BackgroundColor3 = cc3(settingsConfig.cardHoverColor), TextColor3 = cc3(settingsConfig.textColor)}):Play()
        end)
        optBtn.MouseButton1Click:Connect(function()
            current = opt
            val.Text = tostring(opt)
            setOpen(false)
            if onSelect then pcall(onSelect, opt) end
        end)
    end
    header.MouseButton1Click:Connect(function()
        setOpen(not open)
    end)
    return wrapper, function() return current end, function(newVal)
        current = newVal
        val.Text = tostring(newVal)
    end
end

