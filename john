-- ============ FLING / KILL ============
local activeResets = {}
local RESET_DURATION = 3
local RESET_START_STUDS = 5

local function reliableFling(tp)
    if not tp or tp == LP or not tp.Parent then return false end
    if not targetIsAlive(tp) then return false end
    if activeResets[tp.UserId] then return false end
    if isWhitelisted(tp) then return false end
    local Character = LP.Character
    if not Character then return false end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart
    local TCharacter = tp.Character
    if not (Character and Humanoid and RootPart and TCharacter) then return false end
    local TRootPart = TCharacter:FindFirstChild("HumanoidRootPart")
    local THead = TCharacter:FindFirstChild("Head")
    if not TRootPart then return false end
    local savedCF = RootPart.CFrame
    Humanoid.PlatformStand = true
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(0, -50000, 0)
    bv.Parent = RootPart
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 1000000
    bg.CFrame = RootPart.CFrame
    bg.Parent = RootPart
    local origHeight = Workspace.FallenPartsDestroyHeight
    Workspace.FallenPartsDestroyHeight = -100000
    local startTime = tick()
    activeResets[tp.UserId] = true
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if tick() - startTime > RESET_DURATION
           or not tp.Character or not TRootPart.Parent or not Character.Parent then
            Workspace.FallenPartsDestroyHeight = origHeight
            if bv.Parent then bv:Destroy() end
            if bg.Parent then bg:Destroy() end
            Humanoid.PlatformStand = false
            for _, t in ipairs(Humanoid:GetPlayingAnimationTracks()) do t:Stop() end
            RootPart.AssemblyLinearVelocity = Vector3.zero
            RootPart.AssemblyAngularVelocity = Vector3.zero
            RootPart.CFrame = savedCF
            pcall(function() Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            for _, part in ipairs(Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
            if conn then conn:Disconnect() end
            activeResets[tp.UserId] = nil
            return
        end
        if TRootPart and TRootPart.Parent and RootPart and RootPart.Parent then
            local topPos = THead and (THead.Position + Vector3.new(0, RESET_START_STUDS, 0))
                or (TRootPart.Position + Vector3.new(0, RESET_START_STUDS + 0.5, 0))
            local lowestY = TRootPart.Position.Y - 3
            for _, part in ipairs(TCharacter:GetDescendants()) do
                if part:IsA("BasePart") then
                    local pY = part.Position.Y - (part.Size.Y / 2)
                    if pY < lowestY and pY > (TRootPart.Position.Y - 6) then lowestY = pY end
                end
            end
            local bottomPos = Vector3.new(TRootPart.Position.X, lowestY - 0.5, TRootPart.Position.Z)
            local alpha = math.clamp((tick() - startTime) / RESET_DURATION, 0, 1)
            local sweepPos = topPos:Lerp(bottomPos, alpha)
            RootPart.CFrame = CFrame.new(sweepPos) * CFrame.Angles(math.pi/2, 0, 0)
            RootPart.AssemblyLinearVelocity = Vector3.new(0, -50000, 0)
            RootPart.AssemblyAngularVelocity = Vector3.new(7500, 7500, 7500)
            local dir = TRootPart.Position - RootPart.Position
            if dir.Magnitude > 0.01 then bv.Velocity = dir.Unit * 50000 end
            bg.CFrame = RootPart.CFrame
        end
    end)
    local to = tick() + RESET_DURATION + 1.5
    while activeResets[tp.UserId] and tick() < to do task.wait(0.05) end
    return true
end

local function findTool(n)
    local ch, bp = LP.Character, LP:FindFirstChild("Backpack")
    if ch and ch:FindFirstChild(n) then return ch[n] end
    if bp and bp:FindFirstChild(n) then return bp[n] end
    return nil
end

local function executeKillBehind(tp)
    local tc = tp.Character
    if not tc then return end
    local tr = tc:FindFirstChild("HumanoidRootPart")
    local th = tc:FindFirstChildOfClass("Humanoid")
    local mr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not (th and th.Health > 0 and tr and mr) then return end
    local ts = tick()
    while tick() - ts < 2 do
        if not tr.Parent or not th.Parent or th.Health <= 0 then break end
        if tp.Character ~= tc then break end
        if not alive() then break end
        local k = LP.Character and LP.Character:FindFirstChild("Knife")
        if not k then
            local bp = LP:FindFirstChild("Backpack")
            local h = LP.Character:FindFirstChildOfClass("Humanoid")
            local t = bp and bp:FindFirstChild("Knife")
            if t and h then h:EquipTool(t); task.wait(0.1); k = LP.Character:FindFirstChild("Knife") end
        end
        if k then
            mr.CFrame = tr.CFrame * CFrame.new(0, 0, 3.2)
            mr.AssemblyLinearVelocity = Vector3.zero
            mr.AssemblyAngularVelocity = Vector3.zero
            pcall(function() k:Activate() end)
        end
        task.wait(0.05)
    end
end

