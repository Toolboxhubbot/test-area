local function findShootRemote()
    local gun = getGun()
    if gun then
        local shoot = gun:FindFirstChild("Shoot", true)
        if shoot and (shoot:IsA("RemoteEvent") or shoot:IsA("RemoteFunction")) then return shoot end
    end
    local paths = {
        {ReplicatedStorage, "Remotes", "Gameplay", "GunHit"},
        {ReplicatedStorage, "Remotes", "Gameplay", "ShootGun"},
        {ReplicatedStorage, "Remotes", "ShootGun"},
        {ReplicatedStorage, "ShootGun"},
    }
    for _, path in ipairs(paths) do
        local cur = path[1]
        local ok = true
        for i = 2, #path do
            cur = cur and cur:FindFirstChild(path[i])
            if not cur then ok = false break end
        end
        if ok and cur and (cur:IsA("RemoteEvent") or cur:IsA("RemoteFunction")) then return cur end
    end
    return nil
end
local function getTargetPart()
    local murd = getMurd()
    if not murd or not murd.Character then return nil end
    return murd.Character:FindFirstChild("Head") or murd.Character:FindFirstChild("HumanoidRootPart")
end
local function hasClearShot(targetPart)
    if not state.silentAimWallCheck then return true end
    if not targetPart then return true end
    local cam = Workspace.CurrentCamera
    if not cam then return true end
    local origin = cam.CFrame.Position
    local dir = targetPart.Position - origin
    local rp = RaycastParams.new()
    local ignore = {}
    if LP.Character then table.insert(ignore, LP.Character) end
    if targetPart.Parent then table.insert(ignore, targetPart.Parent) end
    rp.FilterDescendantsInstances = ignore
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local res = Workspace:Raycast(origin, dir, rp)
    return res == nil
end

