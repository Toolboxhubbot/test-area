        ob.MouseEnter:Connect(function() if anim() then TweenService:Create(ob,TweenInfo.new(0.15),{BackgroundTransparency=0}):Play() end end)
        ob.MouseLeave:Connect(function() if anim() then TweenService:Create(ob,TweenInfo.new(0.15),{BackgroundTransparency=0.4}):Play() end end)
        ob.MouseButton1Click:Connect(function()
            current=opt
            val.Text=tostring(opt)
            setOpen(false)
            if onSelect then pcall(onSelect,opt) end
        end)
    end
    header.MouseButton1Click:Connect(function() setOpen(not open) end)
    return wrapper,function() return current end,function(nv) current=nv; val.Text=tostring(nv) end
end

