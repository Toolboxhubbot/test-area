    local msg = pcInput.Text
    pcInput.Text = ""
    if string.sub(msg, 1, 1) == "." then
        pcall(_G.__AW_RUN_COMMAND, msg)
        return
    end
    addPrivateMessage(LP.Name, msg, false)
    sendToRelay(LP.Name, msg)
end)

