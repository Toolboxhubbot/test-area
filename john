local function staggerFadeIn(p)
    local ch = {}
    for _,c in ipairs(p:GetChildren()) do if c:IsA("GuiObject") and c.Visible ~= false then table.insert(ch, c) end end
    for i,c in ipairs(ch) do
        local sb = c.BackgroundTransparency
        local stt = nil
        local sp = c.Position
        local ox = 24 * (settingsConfig.selectedScale or 1)
        if c:IsA("TextLabel") or c:IsA("TextButton") or c:IsA("TextBox") then stt = c.TextTransparency; c.TextTransparency = 1 end
        if c:IsA("Frame") or c:IsA("TextButton") or c:IsA("TextBox") then c.BackgroundTransparency = 1 end
        c.Position = UDim2.new(sp.X.Scale, sp.X.Offset + ox, sp.Y.Scale, sp.Y.Offset)
        task.delay(i * 0.024, function()
            if not c.Parent then return end
            if c:IsA("Frame") or c:IsA("TextButton") or c:IsA("TextBox") then
                TweenService:Create(c, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {BackgroundTransparency=sb}):Play()
            end
            if stt ~= nil then TweenService:Create(c, TweenInfo.new(0.42, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency=stt}):Play() end
            TweenService:Create(c, TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position=sp}):Play()
        end)
    end
end
local function startPulsingGlow(g, isOn)
    task.spawn(function()
        while g.Parent do
            if isOn() then
                TweenService:Create(g, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundTransparency=0.55}):Play()
                task.wait(1.2)
                if not g.Parent then break end
                TweenService:Create(g, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundTransparency=0.92}):Play()
                task.wait(1.2)
            else task.wait(0.5) end
        end
    end)
end

