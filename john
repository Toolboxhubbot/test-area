            local dragState = nil
            btn.InputBegan:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.Touch
                   and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                dragState = {
                    inputType = input.UserInputType,
                    start = input.Position,
                    sp = btn.Position,
                    spOuter = outer.Position,
                    moved = false,
                }
            end)
            UIS.InputChanged:Connect(function(input)
                if not dragState then return end
                if dragState.inputType == Enum.UserInputType.MouseButton1 then
                    if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
                elseif dragState.inputType == Enum.UserInputType.Touch then
                    if input.UserInputType ~= Enum.UserInputType.Touch then return end
                end
                local d = input.Position - dragState.start
                if d.Magnitude > DRAG_DEAD_ZONE then dragState.moved = true end
                if dragState.moved then
                    btn.Position = UDim2.new(dragState.sp.X.Scale, dragState.sp.X.Offset + d.X,
