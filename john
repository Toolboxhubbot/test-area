        if cfg.stopped then pcall(function() cfg.stopped:Disconnect() end) cfg.stopped = nil end
        if cfg.track then pcall(function() cfg.track:Stop() cfg.track:Destroy() end) cfg.track = nil end
    end
    local function playHeadless(cfg)
        local c = LP.Character
        if not c then return end
