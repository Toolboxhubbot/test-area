local ghostFolder = nil
local ghostModel = nil
local ghostHighlight = nil
local invisActive = false
local invisSavedCFrame = nil
local invisVirtualPos = nil
local invisVirtualVel = Vector3.zero
local invisSavedAnchored = false
local invisSavedTransparency = {}   -- [BasePart/Decal] = original transparency
local invisSavedCanCollide = {}     -- [BasePart] = original CanCollide

local function ensureGhostFolder()
    if ghostFolder and ghostFolder.Parent then return end
    ghostFolder = Instance.new("Folder")
    ghostFolder.Name = "AW_GhostContainer"
    ghostFolder.Parent = workspace
end

local function destroyGhost()
    if ghostModel then pcall(function() ghostModel:Destroy() end) ghostModel = nil end
    if ghostHighlight then pcall(function() ghostHighlight:Destroy() end) ghostHighlight = nil end
end

local function createGhost()
    destroyGhost()
    if not LP.Character then return end
    ensureGhostFolder()

    local clone = LP.Character:Clone()
    clone.Name = "AW_GhostCharacter"

    for _, d in ipairs(clone:GetDescendants()) do
        if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
            d:Destroy()
        elseif d:IsA("BasePart") then
            d.CanCollide = false
            d.CanTouch = false
            d.CanQuery = false
            d.Anchored = true
            d.Massless = true
            d.Transparency = 0.55
            d.Color = Color3.fromRGB(80, 180, 255)
            d.Material = Enum.Material.ForceField
        elseif d:IsA("Decal") or d:IsA("Texture") then
            d.Transparency = 1
