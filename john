local function applyCrosshair()
    local cc = state.crosshairColor
    if type(cc) ~= "table" then cc = {r=0, g=255, b=100}; state.crosshairColor = cc end
    local col = Color3.fromRGB(cc.r or 0, cc.g or 255, cc.b or 100)
    local size = state.crosshairSize or 20
    local thick = state.crosshairThickness or 2
    local gap = state.crosshairGap or 4

    crossUp.Visible = false; crossDown.Visible = false
    crossLeft.Visible = false; crossRight.Visible = false
    crossDotF.Visible = false; crossCircle.Visible = false; crossImg.Visible = false

    hideShiftLockCrosshair(state.crosshairHideShiftLock)

    if not state.crosshairEnabled then crossRoot.Visible = false; return end
    local locked = isShiftLocked() or state.shiftLockEnabled
    if state.crosshairShiftLockOnly and not locked then crossRoot.Visible = false; return end
    crossRoot.Visible = true

    local style = state.crosshairStyle or "Dot"
    if style == "Cross" then
        crossUp.BackgroundColor3 = col; crossUp.Size = UDim2.new(0, thick, 0, size)
        crossUp.Position = UDim2.new(0.5, 0, 0.5, -(gap + size/2)); crossUp.Visible = true
        crossDown.BackgroundColor3 = col; crossDown.Size = UDim2.new(0, thick, 0, size)
        crossDown.Position = UDim2.new(0.5, 0, 0.5, (gap + size/2)); crossDown.Visible = true
        crossLeft.BackgroundColor3 = col; crossLeft.Size = UDim2.new(0, size, 0, thick)
        crossLeft.Position = UDim2.new(0.5, -(gap + size/2), 0.5, 0); crossLeft.Visible = true
        crossRight.BackgroundColor3 = col; crossRight.Size = UDim2.new(0, size, 0, thick)
        crossRight.Position = UDim2.new(0.5, (gap + size/2), 0.5, 0); crossRight.Visible = true
    elseif style == "Dot" then
        crossDotF.BackgroundColor3 = col
        crossDotF.Size = UDim2.new(0, size, 0, size)
        crossDotF.Visible = true
    elseif style == "Circle" then
        crossCircle.BorderColor3 = col
        crossCircle.Size = UDim2.new(0, size * 2, 0, size * 2)
        crossCircle.BorderSizePixel = thick
        crossCircle.Visible = true
    elseif style == "Custom" then
        crossImg.Image = state.crosshairImageId
        crossImg.ImageColor3 = col
        crossImg.Size = UDim2.new(0, size * 2, 0, size * 2)
        crossImg.Visible = true
    end
    if state.crosshairDot and style ~= "Dot" and style ~= "Custom" then
        crossDotF.BackgroundColor3 = col
        crossDotF.Size = UDim2.new(0, state.crosshairDotSize or 3, 0, state.crosshairDotSize or 3)
        crossDotF.Visible = true
    end
end

task.spawn(function()
