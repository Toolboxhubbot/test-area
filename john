local EASE_SMOOTH = Enum.EasingStyle.Quint
local EASE_BOUNCE = Enum.EasingStyle.Back
local EASE_SOFT   = Enum.EasingStyle.Sine
local EASE_OUT    = Enum.EasingDirection.Out
local EASE_IN     = Enum.EasingDirection.In

local THEME = {
    bg        = Color3.fromRGB(11, 11, 17),
    bgDeep    = Color3.fromRGB(6, 6, 11),
    sidebar   = Color3.fromRGB(14, 14, 22),
    card      = Color3.fromRGB(22, 22, 34),
    cardHover = Color3.fromRGB(32, 32, 48),
    border    = Color3.fromRGB(40, 40, 58),
    text      = Color3.fromRGB(242, 242, 252),
    textSub   = Color3.fromRGB(140, 142, 166),
    textDim   = Color3.fromRGB(88, 90, 112),
    accent    = Color3.fromRGB(124, 92, 255),
    accent2   = Color3.fromRGB(0, 195, 255),
    success   = Color3.fromRGB(80, 230, 140),
    danger    = Color3.fromRGB(255, 85, 120),
    warning   = Color3.fromRGB(255, 200, 90),
}

local function cc3(t)
    if type(t) == "table" then return Color3.fromRGB(t.r or 0, t.g or 0, t.b or 0) end
    return t or THEME.accent
end

local function corner(parent, r)
    local c = Instance.new("UICorner", parent)
    c.CornerRadius = UDim.new(0, r or 12)
    return c
end

local function gradient(parent, colA, colB, rot)
    local g = Instance.new("UIGradient", parent)
    g.Color = ColorSequence.new(colA, colB)
    g.Rotation = rot or 90
    return g
end

local function glow(parent, color, transparency, thickness)
    local s = Instance.new("UIStroke", parent)
    s.Color = color or THEME.accent
    s.Transparency = transparency or 0.4
    s.Thickness = thickness or 1.2
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    return s
end

local function pad(parent, t, b, l, r)
    local p = Instance.new("UIPadding", parent)
    if t then p.PaddingTop = UDim.new(0, t) end
    if b then p.PaddingBottom = UDim.new(0, b) end
    if l then p.PaddingLeft = UDim.new(0, l) end
    if r then p.PaddingRight = UDim.new(0, r) end
    return p
end

