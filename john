local function resetX4(index)
    if votingRunning then setStatus("Voting sequence already running!") return end
    votingRunning = true
    isExecutingAction = true
    cancelFarmTween()
    task.spawn(function()
        pcall(function()
            local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if root then savedVotingCFrame = root.CFrame end
            setStatus("Spot " .. tostring(index) .. " - Starting...")
            for i = 1, 4 do
                if not votingRunning then break end
                local char = LP.Character
                local rt = char and char:FindFirstChild("HumanoidRootPart")
                if rt then rt.CFrame = CFrame.new(Spots[index]) end
                task.wait(0.4)
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum then hum.Health = 0 end
                setStatus(string.format("Spot %d - Reset %d/4", index, i))
                local finished = false
                local conn
                conn = LP.CharacterAdded:Connect(function()
                    finished = true
                    if conn then conn:Disconnect() end
                end)
                local timer = 0
                while not finished and timer < 15 and votingRunning do
                    task.wait(0.1)
                    timer = timer + 0.1
                end
                if conn then conn:Disconnect() end
                task.wait(0.5)
            end
            local char = LP.Character
            local rt = char and char:FindFirstChild("HumanoidRootPart")
            if rt and savedVotingCFrame then rt.CFrame = savedVotingCFrame end
            setStatus("Spot " .. tostring(index) .. " - Finished")
        end)
        votingRunning = false
        isExecutingAction = false
    end)
end

