local espFolder = Instance.new("Folder")
espFolder.Name = "AW_ESP_Container"
pcall(function() espFolder.Parent = getGuiParent() end)
local espCache = {}
local function clearESP(i)
    if espCache[i] then
        pcall(function()
            if espCache[i].highlight then espCache[i].highlight:Destroy() end
            if espCache[i].billboard then espCache[i].billboard:Destroy() end
        end)
        espCache[i] = nil
    end
end
local function updateCreateESP(i, ts, col)
    if not i or not i.Parent then clearESP(i) return end
    if not espCache[i] then
        local hl = Instance.new("Highlight")
        hl.Adornee = i; hl.FillColor = col
        hl.FillTransparency = 0.5; hl.OutlineColor = col
        hl.OutlineTransparency = 0.2
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = espFolder
        local bb = Instance.new("BillboardGui")
        bb.Adornee = i; bb.Size = UDim2.new(0,200,0,50)
        bb.StudsOffset = Vector3.new(0,4,0); bb.AlwaysOnTop = true; bb.Parent = espFolder
        local tx = Instance.new("TextLabel")
        tx.Size = UDim2.new(1,0,1,0); tx.BackgroundTransparency = 1
        tx.Text = ts; tx.TextColor3 = col; tx.TextStrokeTransparency = 0
        tx.Font = Enum.Font.GothamBold; tx.TextSize = 12; tx.Parent = bb
        espCache[i] = {highlight=hl, billboard=bb, text=tx}
    else
        local e = espCache[i]
        if e.highlight and e.billboard and e.text then
            e.highlight.Adornee = i; e.billboard.Adornee = i
            e.highlight.FillColor = col; e.highlight.OutlineColor = col
            e.text.Text = ts; e.text.TextColor3 = col
        else clearESP(i) end
    end
end
