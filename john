local function c3(t) return Color3.fromRGB(t.r or 0, t.g or 0, t.b or 0) end

local function attachBounce(b)
    if state.animationsEnabled == false then return end
    local s = Instance.new("UIScale", b)
    b.MouseButton1Down:Connect(function() TweenService:Create(s, TweenInfo.new(0.08), {Scale=0.92}):Play() end)
    local function r() TweenService:Create(s, TweenInfo.new(0.45, Enum.EasingStyle.Elastic), {Scale=1}):Play() end
    b.MouseButton1Up:Connect(r); b.MouseLeave:Connect(r)
end

local function attachRipple(b, c)
    if state.animationsEnabled == false then return end
    c = c or Color3.new(1,1,1)
    b.ClipsDescendants = true
    b.MouseButton1Down:Connect(function()
        local pos = b.AbsolutePosition
        local m = UIS:GetMouseLocation()
        local f = Instance.new("Frame", b)
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.Position = UDim2.new(0, m.X - pos.X, 0, m.Y - pos.Y)
        f.Size = UDim2.new(0, 0, 0, 0)
        f.BackgroundColor3 = c
        f.BackgroundTransparency = 0.5
        f.BorderSizePixel = 0
        f.ZIndex = (b.ZIndex or 1) + 5
        f.Active = false
        Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
        local sz = math.max(b.AbsoluteSize.X, b.AbsoluteSize.Y) * 3
        TweenService:Create(f, TweenInfo.new(0.55, Enum.EasingStyle.Quint),
            {Size = UDim2.new(0, sz, 0, sz), BackgroundTransparency = 1}):Play()
        task.delay(0.65, function() if f and f.Parent then f:Destroy() end end)
    end)
end

local function attachShine(b)
    if state.animationsEnabled == false then return end
    b.ClipsDescendants = true
    local s = Instance.new("Frame", b)
    s.Size = UDim2.new(0, 28, 1.6, 0)
    s.Position = UDim2.new(-0.35, 0, -0.3, 0)
    s.BackgroundColor3 = Color3.new(1,1,1)
    s.BackgroundTransparency = 0.88
    s.Rotation = 14; s.BorderSizePixel = 0
    s.ZIndex = (b.ZIndex or 1) + 2; s.Active = false
    b.MouseEnter:Connect(function()
        s.Position = UDim2.new(-0.35, 0, -0.3, 0)
        TweenService:Create(s, TweenInfo.new(0.55), {Position = UDim2.new(1.35, 0, -0.3, 0)}):Play()
    end)
end

local function staggerFade(p)
    if state.animationsEnabled == false then return end
    for i, c in ipairs(p:GetChildren()) do
        if c:IsA("GuiObject") and c.Visible ~= false then
            local sb = c.BackgroundTransparency
            local stt
            if c:IsA("TextLabel") or c:IsA("TextButton") then
                stt = c.TextTransparency; c.TextTransparency = 1
            end
            if c:IsA("Frame") or c:IsA("TextButton") then c.BackgroundTransparency = 1 end
            task.delay(i * 0.02, function()
                if not c.Parent then return end
                if c:IsA("Frame") or c:IsA("TextButton") then
                    TweenService:Create(c, TweenInfo.new(0.4, Enum.EasingStyle.Back), {BackgroundTransparency=sb}):Play()
                end
                if stt then TweenService:Create(c, TweenInfo.new(0.4), {TextTransparency=stt}):Play() end
            end)
        end
    end
end

