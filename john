local function updateESP(i, txt, col)
    if not i or not i.Parent then clearESP(i); return end
    if not espCache[i] then
        local hl = Instance.new("Highlight", espF)
        hl.Adornee = i; hl.FillColor = col; hl.FillTransparency = 0.5
        hl.OutlineColor = col; hl.OutlineTransparency = 0.2
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        local bb = Instance.new("BillboardGui", espF)
        bb.Adornee = i; bb.Size = UDim2.new(0, 200, 0, 50)
        bb.StudsOffset = Vector3.new(0, 4, 0); bb.AlwaysOnTop = true
        local tx = Instance.new("TextLabel", bb)
        tx.Size = UDim2.new(1, 0, 1, 0); tx.BackgroundTransparency = 1
        tx.Text = txt; tx.TextColor3 = col; tx.TextStrokeTransparency = 0
        tx.Font = Enum.Font.GothamBold; tx.TextSize = 12
        espCache[i] = {h=hl, b=bb, t=tx}
    else
        local e = espCache[i]
        if e.h and e.b and e.t then
            e.h.Adornee = i; e.b.Adornee = i
            e.h.FillColor = col; e.h.OutlineColor = col
            e.t.Text = txt; e.t.TextColor3 = col
        else clearESP(i) end
    end
end
