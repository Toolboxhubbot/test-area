        kn.Position = UDim2.new((iv-minV)/(maxV-minV),0,0.5,-8*selectedScale)
        kn.BackgroundColor3 = Color3.fromRGB(255,255,255); kn.Parent = tr
        Instance.new("UICorner", kn).CornerRadius = UDim.new(1,0)
        local drag = false
        local function ufi(inp)
            local mx = inp.Position.X
            local tp = tr.AbsolutePosition.X
            local ts = tr.AbsoluteSize.X
            if ts == 0 then return end
            local p = math.clamp((mx - tp)/ts, 0, 1)
            local v = math.floor(minV + (maxV-minV)*p + 0.5)
            state[sK] = v; ib.Text = tostring(v)
            fl.Size = UDim2.new(p,0,1,0)
            kn.Position = UDim2.new(p,0,0.5,-8*selectedScale)
            saveSettings()
        end
        local function ufv(v)
            v = math.clamp(v, minV, maxV); state[sK] = v; ib.Text = tostring(v)
            local p = (v-minV)/(maxV-minV)
            fl.Size = UDim2.new(p,0,1,0)
            kn.Position = UDim2.new(p,0,0.5,-8*selectedScale)
            saveSettings()
        end
        tr.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                drag = true; ufi(inp)
                TweenService:Create(kn, TweenInfo.new(0.15), {Size=UDim2.new(0,22*selectedScale,0,22*selectedScale), BackgroundColor3=Color3.fromRGB(150,200,255)}):Play()
            end
        end)
        UIS.InputChanged:Connect(function(inp)
            if drag and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then ufi(inp) end
        end)
        UIS.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                drag = false
                TweenService:Create(kn, TweenInfo.new(0.35, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Size=UDim2.new(0,16*selectedScale,0,16*selectedScale), BackgroundColor3=Color3.fromRGB(255,255,255)}):Play()
            end
        end)
        ib.FocusLost:Connect(function()
            local v = tonumber(ib.Text)
            if v then ufv(v) else ib.Text = tostring(state[sK]) end
        end)
    end

