local function buildDefaultCircleButtons()
    local list, size, gap = {}, 62, 4
    local x, y = 8, 8
    local cam = Workspace.CurrentCamera
    local vps = cam and cam.ViewportSize or Vector2.new(1920, 1080)
    for _, a in ipairs(CIRCLE_ACTIONS) do
        if x + size > vps.X - 8 then x = 8; y = y + size + gap end
        table.insert(list, { id=a.id, enabled=true, size=size, x=x, y=y })
        x = x + size + gap
    end
    return list
end
