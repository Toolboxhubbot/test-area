local function anim() return state.anims~=false end
local spinG={}
local function altSeq(a,b) return ColorSequence.new({
ColorSequenceKeypoint.new(0,a),ColorSequenceKeypoint.new(0.25,a),
ColorSequenceKeypoint.new(0.25,b),ColorSequenceKeypoint.new(0.5,b),
ColorSequenceKeypoint.new(0.5,a),ColorSequenceKeypoint.new(0.75,a),
ColorSequenceKeypoint.new(0.75,b),ColorSequenceKeypoint.new(1,b)}) end
local function setG(g,on) if g then g.Color=on and altSeq(WH,C3(cfg.accentC)) or altSeq(C3(cfg.accentC),BK) end end
local function sStroke(s,on,o)
if not s then return end
o=o or {}
s.Color=WH
pcall(function() s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border end)
local e=s:FindFirstChild("SpinGrad")
local g
if e then g=e else g=Instance.new("UIGradient",s); g.Name="SpinGrad"; table.insert(spinG,g) end
setG(g,on)
if o.pulse~=false and not s:GetAttribute("Br") then
s:SetAttribute("Br",true)
local base=o.baseT or s.Thickness or 2
task.spawn(function()
while s and s.Parent do
if anim() then
T:Create(s,TweenInfo.new(0.9,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{Thickness=base*1.6}):Play()
task.wait(0.9)
if not s.Parent then break end
T:Create(s,TweenInfo.new(0.9,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{Thickness=math.max(1,base*0.6)}):Play()
task.wait(0.9)
else s.Thickness=base; task.wait(0.3) end
end
end)
end
end
