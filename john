                                    e.tx.Text=table.concat(parts,"\n")
                                end
                                if e.tracer then
                                    local cam=Workspace.CurrentCamera
                                    if cam then
                                        local sp=hrp.Position
                                        local vp,onS=cam:WorldToViewportPoint(sp)
                                        if onS then
                                            e.tracer.From=Vector2.new(cam.ViewportSize.X/2,cam.ViewportSize.Y)
                                            e.tracer.To=Vector2.new(vp.X,vp.Y)
                                            e.tracer.Color=col
                                            e.tracer.Visible=true
                                        else
                                            e.tracer.Visible=false
                                        end
                                    end
                                end
                            else
                                clearESP(p)
                            end
                        else
                            if espCache[p] then clearESP(p) end
                        end
                    else
                        if espCache[p] then clearESP(p) end
                    end
                end
            end
        end
        if not state.espTracers then
            for _,e in pairs(espCache) do
                if e.tracer then e.tracer.Visible=false end
            end
        end
        if not state.espBox then
            for _,e in pairs(espCache) do
                if e.box and e.box.Parent then e.box.Visible=false end
            end
        end
        if state.espGunDrop then
            for _,v in pairs(Workspace:GetDescendants()) do
                if v.Name=="GunDrop" and v:IsA("BasePart") and not gunCache[v] then
                    local hl=Instance.new("Highlight")
                    hl.FillColor=Color3.fromRGB(255,255,0)
                    hl.FillTransparency=0.5
                    hl.OutlineColor=Color3.fromRGB(255,255,0)
                    hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent=espF
                    hl.Adornee=v
                    gunCache[v]=hl
                end
            end
            for k,v in pairs(gunCache) do
                if not k.Parent or not v.Parent then
                    pcall(function() v:Destroy() end)
                    gunCache[k]=nil
                end
            end
        else
            for k,v in pairs(gunCache) do
                pcall(function() v:Destroy() end)
                gunCache[k]=nil
            end
        end
    end
end)

