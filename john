-- ============ SILENT AIM ============
local SHOT_CD=0.4
local lastShot=-SHOT_CD
local function canFire() return (tick()-lastShot)>=SHOT_CD end
local function getGun()
    local char=LP.Character
    local bp=LP:FindFirstChild("Backpack")
    for _,n in ipairs(GUN_NAMES) do
        if char and char:FindFirstChild(n) then return char[n] end
        if bp and bp:FindFirstChild(n) then return bp[n] end
    end
end
local function findShootRemote()
    local gun=getGun()
    if gun then
        local s=gun:FindFirstChild("Shoot",true)
        if s and (s:IsA("RemoteEvent") or s:IsA("RemoteFunction")) then return s end
    end
    local paths={
        {RS,"Remotes","Gameplay","GunHit"},
        {RS,"Remotes","Gameplay","ShootGun"},
        {RS,"Remotes","ShootGun"},
        {RS,"ShootGun"},
    }
    for _,p in ipairs(paths) do
        local cur=p[1]; local ok=true
        for i=2,#p do cur=cur and cur:FindFirstChild(p[i]); if not cur then ok=false break end end
        if ok and cur and (cur:IsA("RemoteEvent") or cur:IsA("RemoteFunction")) then return cur end
    end
end
local function getTargetPart()
    local m=getMurd()
    if not m or not m.Character then return nil end
    return m.Character:FindFirstChild("Head") or m.Character:FindFirstChild("HumanoidRootPart")
end
local function hasClearShot(tp)
    if not state.silentAimWallCheck or not tp then return true end
    local cam=Workspace.CurrentCamera; if not cam then return true end
    local rp=RaycastParams.new()
    local ig={}
    if LP.Character then table.insert(ig,LP.Character) end
    if tp.Parent then table.insert(ig,tp.Parent) end
    rp.FilterDescendantsInstances=ig
    rp.FilterType=Enum.RaycastFilterType.Exclude
    return Workspace:Raycast(cam.CFrame.Position,tp.Position-cam.CFrame.Position,rp)==nil
end
local function fireSilentAtMurderer()
    if not canFire() then return false end
    local part=getTargetPart(); if not part then return false end
    if not state.shootThroughWall and not hasClearShot(part) then return false end
    lastShot=tick()
    local remote=findShootRemote(); if not remote then return false end
    local tCF=part.CFrame
    local aCF=CFrame.new(part.Position+Vector3.new(0,1.5,0))
    local oCF=Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame or tCF
    pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(oCF,tCF); remote:FireServer(aCF,tCF); remote:FireServer(tCF)
            local h=part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
            if h then remote:FireServer(h) end
        else
            remote:InvokeServer(oCF,tCF)
            remote:InvokeServer(nil,part.Position)
            remote:InvokeServer(part.Position)
        end
    end)
    return true
