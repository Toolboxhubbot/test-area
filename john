        for i, x in ipairs(settingsConfig.flingList) do
            if string.lower(x) == string.lower(plr.Name) or string.lower(x) == string.lower(plr.DisplayName) then isIn = true; idx = i; break end
        end
        if isIn and idx then
            table.remove(settingsConfig.flingList, idx)
