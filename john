local function applyShape(btn, shape)
    for _, c in ipairs(btn:GetChildren()) do
        if c:IsA("UICorner") then c:Destroy() end
    end
    local c2 = Instance.new("UICorner", btn)
    local rot = 0
    if shape == "circle" then c2.CornerRadius = UDim.new(1, 0)
    elseif shape == "square" then c2.CornerRadius = UDim.new(0, 0)
    elseif shape == "rounded" then c2.CornerRadius = UDim.new(0, 14)
    elseif shape == "diamond" then c2.CornerRadius = UDim.new(0, 6); rot = 45
    else c2.CornerRadius = UDim.new(1, 0) end
    btn.Rotation = rot
    return rot
end

local DRAG_DEAD_ZONE = 6
local syncToggleUI

