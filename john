task.spawn(function()
    while true do
        task.wait(1)
        if not alive() then continue end
        if isExecutingAction or next(activeResets) then continue end
        if state.xpFarm then continue end
        if not bagFull then continue end

        if state.autoFlingMur then
            local m = getMurd()
            if m and targetIsAlive(m) and not isWhitelisted(m) then
                task.spawn(function() reliableFling(m) end)
                task.wait(1.5)
            end
        end

        if state.autoFlingSheriff then
            local live = getLiveSheriffHeroes()
            if #live > 0 then
                for _, s in ipairs(live) do
                    if not isWhitelisted(s) then
                        task.spawn(function() reliableFling(s) end)
                        task.wait(1.2)
                    end
                end
            end
        end

        if state.autoKillAll then
            local knife = findTool("Knife")
            if knife then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LP and targetIsAlive(p) and not isWhitelisted(p) then
                        task.spawn(function() executeKillBehind(p) end)
                        task.wait(0.5)
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(1)
        if not alive() then continue end
        if not bagFull then continue end
        if state.loopFlingAll or state.loopFlingMur or state.loopFlingSheriff or state.loopFlingCustom then
            isExecutingAction = true
            cancelFarmTween()
            if state.loopFlingAll then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LP and alive() and not isWhitelisted(p) then
                        task.spawn(function() reliableFling(p) end)
                        task.wait(0.3)
                    end
                end
            elseif state.loopFlingMur then
                local m = getMurd()
                if m and not isWhitelisted(m) then
                    task.spawn(function() reliableFling(m) end)
                end
            elseif state.loopFlingSheriff then
                if lpHasGun() then
                    state.loopFlingSheriff = false
                    updateViz("loopFlingSheriff")
                else
                    refreshRoleCache()
                    local live = getLiveSheriffHeroes()
                    if #live > 0 then
                        task.spawn(function() reliableFling(live[1]) end)
                    end
                end
            elseif state.loopFlingCustom then
                for _, n in ipairs(settingsConfig.flingList) do
                    for _, p in ipairs(Players:GetPlayers()) do
                        if string.lower(p.Name) == string.lower(n) and not isWhitelisted(p) then
                            task.spawn(function() reliableFling(p) end)
                        end
                    end
                end
            end
            isExecutingAction = false
            task.wait(1.5)
        end
    end
end)

