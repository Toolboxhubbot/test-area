    local DEFAULT_ANIMS=nil
    local function captureDefaultAnims(char)
        if not char then char=LP.Character end
        if not char then return end
        local animate=char:FindFirstChild("Animate")
        if not animate then return end
        local captured={}
        for slot in pairs(ANIM_SLOT_PATHS) do
            local id=getAnimIdFromChar(char,slot)
            if id then captured[slot]=id end
        end
        DEFAULT_ANIMS=captured
    end
    local function applyPresetToSlots(presetName,slots)
        local char=LP.Character
        if not char then return end
        local animate=char:FindFirstChild("Animate")
        if not animate then return end
        if presetName=="Default" then
            if not DEFAULT_ANIMS then captureDefaultAnims(char) end
            for _,slot in ipairs(slots) do
                local id=DEFAULT_ANIMS[slot]
                if id then setAnimIdOnChar(char,slot,id) end
            end
        else
            local preset=FE_PRESETS[presetName]
            if not preset then return end
            for _,slot in ipairs(slots) do
                local id=preset[slot]
                if id then setAnimIdOnChar(char,slot,id) end
            end
        end
        resetAnimateScript(char)
    end

