local flyBV,flyBG,flyConn,flyHold=nil,nil,nil,false
local function startFly()
local c=LP.Character; if not c then return end
local hrp=c:FindFirstChild("HumanoidRootPart")
local h=c:FindFirstChildOfClass("Humanoid")
if not hrp or not h then return end
h.PlatformStand=true
if not flyBV or not flyBV.Parent then
flyBV=Instance.new("BodyVelocity")
flyBV.MaxForce=Vector3.new(9e9,9e9,9e9); flyBV.P=10000
flyBV.Velocity=Vector3.zero; flyBV.Parent=hrp
end
if not flyBG or not flyBG.Parent then
flyBG=Instance.new("BodyGyro")
flyBG.P=9e4; flyBG.MaxTorque=Vector3.new(9e9,9e9,9e9)
flyBG.CFrame=hrp.CFrame; flyBG.Parent=hrp
end
if flyConn then flyConn:Disconnect() end
flyConn=R.RenderStepped:Connect(function()
local ch=LP.Character; if not ch then return end
local r=ch:FindFirstChild("HumanoidRootPart")
local hh=ch:FindFirstChildOfClass("Humanoid")
if not r or not hh then return end
if not flyBV or not flyBV.Parent or not flyBG or not flyBG.Parent then return end
local cam=W.CurrentCamera; if not cam then return end
local camCF=cam.CFrame
local mv=Vector3.zero
local md=hh.MoveDirection
if md.Magnitude>0.01 then
local fl=Vector3.new(camCF.LookVector.X,0,camCF.LookVector.Z)
local fr=Vector3.new(camCF.RightVector.X,0,camCF.RightVector.Z)
if fl.Magnitude>0.01 then fl=fl.Unit end
if fr.Magnitude>0.01 then fr=fr.Unit end
local fm=Vector3.new(md.X,0,md.Z)
if fm.Magnitude>0.01 then fm=fm.Unit end
local f=0; local rr=0
if fl.Magnitude>0.01 then f=fm:Dot(fl) end
if fr.Magnitude>0.01 then rr=fm:Dot(fr) end
if f~=0 then mv=mv+camCF.LookVector*f end
if rr~=0 then mv=mv+camCF.RightVector*rr end
end
if U:IsKeyDown(Enum.KeyCode.Space) then mv=mv+camCF.UpVector end
if U:IsKeyDown(Enum.KeyCode.LeftShift) then mv=mv-camCF.UpVector end
if flyHold then mv=mv+camCF.UpVector end
local sp=state.flySpeed or 50
if mv.Magnitude>0 then flyBV.Velocity=mv.Unit*sp else flyBV.Velocity=Vector3.zero end
flyBG.CFrame=camCF
end)
end
local function stopFly()
if flyConn then flyConn:Disconnect(); flyConn=nil end
if flyBV and flyBV.Parent then flyBV:Destroy() end
if flyBG and flyBG.Parent then flyBG:Destroy() end
flyBV=nil; flyBG=nil
local c=LP.Character
if c then
local h=c:FindFirstChildOfClass("Humanoid")
if h then h.PlatformStand=false; h.AutoRotate=true end
local r=c:FindFirstChild("HumanoidRootPart")
if r then r.AssemblyLinearVelocity=Vector3.zero; r.AssemblyAngularVelocity=Vector3.zero end
end
end
