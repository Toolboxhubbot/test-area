local function executeKillBehind(tp)
    local tc = tp.Character
    if not tc then return end
    local tr = tc:FindFirstChild("HumanoidRootPart")
    local th = tc:FindFirstChildOfClass("Humanoid")
    local mr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not (th and th.Health > 0 and tr and mr) then return end
    local ts = tick()
    while tick() - ts < 3 do
        if not tr.Parent or not th.Parent or th.Health <= 0 then break end
        if tp.Character ~= tc then break end
        if not alive() then break end
        local k = LP.Character and LP.Character:FindFirstChild("Knife")
        if not k or k.Parent ~= LP.Character then k = equipTool("Knife") end
        if k and k.Parent == LP.Character then
            mr.CFrame = tr.CFrame * CFrame.new(0, 0, 3.2)
            mr.AssemblyLinearVelocity = Vector3.zero
            mr.AssemblyAngularVelocity = Vector3.zero
            pcall(function() k:Activate() end)
            pcall(function()
                for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
                    if v:IsA("RemoteEvent") then
                        local n = string.lower(v.Name)
                        if n:find("knife") or n:find("hit") or n:find("stab") or n:find("kill") then
