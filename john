                    local playerModule = LP.PlayerScripts:FindFirstChild("PlayerModule")
                    if playerModule then
                        local controls = require(playerModule):GetControls()
                        local moveVector = controls:GetMoveVector()
                        if moveVector.Magnitude > 0 then
                            moveDir = moveDir + (camCF.LookVector * -moveVector.Z) + (camCF.RightVector * moveVector.X)
                        end
                    end
                    if flyUp then moveDir = moveDir + Vector3.new(0,1,0) end
                    if flyDown then moveDir = moveDir - Vector3.new(0,1,0) end
                end

                flyBV.Velocity = moveDir * state.flySpeed
                flyBG.CFrame = camCF
            end
        else
            if mobileFlyUpBtn then mobileFlyUpBtn.Visible = false end
            if mobileFlyDownBtn then mobileFlyDownBtn.Visible = false end
            if flyBV then flyBV:Destroy() flyBV = nil end
            if flyBG then flyBG:Destroy() flyBG = nil end
