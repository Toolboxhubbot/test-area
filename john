local function makeSlider(page,label,order,iv,minV,maxV,sK,onChange)
    local row=Instance.new("Frame",page)
    row.Size=UDim2.new(1,0,0,56)
    row.LayoutOrder=order
    row.BackgroundColor3=cc3(settingsConfig.cardColor)
    row.BackgroundTransparency=1
    Instance.new("UICorner",row).CornerRadius=UDim.new(0,10)
    local rowSt=Instance.new("UIStroke",row)
    rowSt.Color=cc3(settingsConfig.accentColor)
    rowSt.Thickness=1.5; rowSt.Transparency=0.5
    local lbl=Instance.new("TextLabel",row)
    lbl.Size=UDim2.new(0.6,0,0,24)
    lbl.Position=UDim2.new(0,14,0,4)
    lbl.BackgroundTransparency=1
    lbl.Text=label
    lbl.TextColor3=WHITE
    lbl.Font=Enum.Font.GothamMedium
    lbl.TextSize=11
    lbl.TextXAlignment=Enum.TextXAlignment.Left
    local ib=Instance.new("TextBox",row)
    ib.Size=UDim2.new(0,50,0,24)
    ib.Position=UDim2.new(1,-64,0,4)
    ib.BackgroundColor3=Color3.fromRGB(24,0,42)
    ib.Text=tostring(iv)
    ib.TextColor3=WHITE
    ib.Font=Enum.Font.Gotham
    ib.TextSize=11
    ib.ClearTextOnFocus=false
    Instance.new("UICorner",ib).CornerRadius=UDim.new(0,6)
    local tr=Instance.new("Frame",row)
    tr.Size=UDim2.new(1,-28,0,8)
    tr.Position=UDim2.new(0,14,1,-18)
    tr.BackgroundColor3=cc3(settingsConfig.borderColor)
    Instance.new("UICorner",tr).CornerRadius=UDim.new(1,0)
    local fl=Instance.new("Frame",tr)
    fl.Size=UDim2.new((iv-minV)/(maxV-minV),0,1,0)
    fl.BackgroundColor3=cc3(settingsConfig.accentColor)
    Instance.new("UICorner",fl).CornerRadius=UDim.new(1,0)
    local kn=Instance.new("Frame",tr)
    kn.Size=UDim2.new(0,16,0,16)
    kn.Position=UDim2.new((iv-minV)/(maxV-minV),0,0.5,-8)
    kn.BackgroundColor3=WHITE
    Instance.new("UICorner",kn).CornerRadius=UDim.new(1,0)
    local drag=false
    local function update(inp)
        local mx=inp.Position.X
        local tp=tr.AbsolutePosition.X
        local ts=tr.AbsoluteSize.X
        if ts==0 then return end
        local p=math.clamp((mx-tp)/ts,0,1)
        local v=math.floor(minV+(maxV-minV)*p+0.5)
        if sK then state[sK]=v end
        ib.Text=tostring(v)
        fl.Size=UDim2.new(p,0,1,0)
        kn.Position=UDim2.new(p,0,0.5,-8)
        if onChange then onChange(v) end
        if sK then saveSettings() end
    end
    tr.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then drag=true; update(inp) end
    end)
    UIS.InputChanged:Connect(function(inp) if drag then update(inp) end end)
    UIS.InputEnded:Connect(function() drag=false end)
    ib.FocusLost:Connect(function()
        local v=tonumber(ib.Text)
        if v then
            v=math.clamp(v,minV,maxV)
            if sK then state[sK]=v end
            ib.Text=tostring(v)
            local p=(v-minV)/(maxV-minV)
            fl.Size=UDim2.new(p,0,1,0)
            kn.Position=UDim2.new(p,0,0.5,-8)
            if onChange then onChange(v) end
            if sK then saveSettings() end
        else
            if sK then ib.Text=tostring(state[sK]) else ib.Text=tostring(iv) end
        end
    end)
end
