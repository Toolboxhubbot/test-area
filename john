local floatButtons = {}
local START_Y_OFFSET = 180
local function defaultPositionForIndex(i)
    local vpW = (Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize.X) or 1920
    local cell = state.floatButtonSize + 10
    local perRow = math.max(1, math.floor((vpW - 20) / cell))
    local col = (i - 1) % perRow
    local row = math.floor((i - 1) / perRow)
    return {xScale = 0, xOffset = 10 + col * cell, yScale = 0, yOffset = START_Y_OFFSET + row * cell}
end
local function refreshFloatVisual(def)
    local data = floatButtons[def.id]
    if not data or not data.btn or not data.btn.Parent then return end
    local isOn = false
    if def.type == "toggle" then isOn = state[def.key] and true or false end
    if data.inner then
        data.inner.Color = WHITE
        local g = data.inner:FindFirstChild("SpinGrad")
        if g then setSpinGradColors(g, isOn) end
    end
    data.btn.TextColor3 = isOn and Color3.new(0,0,0) or Color3.new(1,1,1)
    data.btn.TextStrokeColor3 = isOn and Color3.new(1,1,1) or Color3.new(0,0,0)
end
local function applyShape(btn, shape)
    for _, c in ipairs(btn:GetChildren()) do
        if c:IsA("UICorner") then c:Destroy() end
    end
    local corner = Instance.new("UICorner", btn)
    local rot = 0
    if shape == "circle" then corner.CornerRadius = UDim.new(1, 0)
    elseif shape == "square" then corner.CornerRadius = UDim.new(0, 0)
    elseif shape == "rounded" then corner.CornerRadius = UDim.new(0, 14)
    elseif shape == "diamond" then corner.CornerRadius = UDim.new(0, 4); rot = 45
    else corner.CornerRadius = UDim.new(1, 0) end
    btn.Rotation = rot
    return rot
end
local DRAG_DEAD_ZONE = 6
local function rebuildFloatButtons()
    for _, c in ipairs(floatGui:GetChildren()) do
        if c:IsA("TextButton") or c:IsA("Frame") then c:Destroy() end
    end
    floatButtons = {}
    local i = 0
    for _, def in ipairs(FLOAT_BUTTON_DEFS) do
        if state.floatEnabledButtons[def.id] then
            i = i + 1
            local saved = state.floatButtonPositions[def.id]
            if not saved then saved = defaultPositionForIndex(i) state.floatButtonPositions[def.id] = saved end
            local bx = saved.xOffset or 0
            local by = saved.yOffset or 0
            local sx = saved.xScale or 0
            local sy = saved.yScale or 0
            local outer = Instance.new("Frame", floatGui)
            outer.AnchorPoint = Vector2.new(0, 0)
            outer.BackgroundTransparency = 1
            outer.BorderSizePixel = 0
            outer.ZIndex = 1
            outer.Visible = state.floatButtonsEnabled
            outer.Position = UDim2.new(sx, bx, sy, by)
            outer.Size = UDim2.new(0, state.floatButtonSize, 0, state.floatButtonSize)
            local btn = Instance.new("TextButton")
            btn.AnchorPoint = Vector2.new(0, 0)
            btn.Size = UDim2.new(0, state.floatButtonSize, 0, state.floatButtonSize)
            btn.Position = UDim2.new(sx, bx, sy, by)
            btn.BackgroundColor3 = Color3.new(0, 0, 0)
            btn.BackgroundTransparency = 1
            btn.Text = def.label
            btn.TextColor3 = Color3.new(1, 1, 1)
            btn.TextStrokeColor3 = Color3.new(0, 0, 0)
            btn.TextStrokeTransparency = 0.4
            btn.Font = Enum.Font.GothamBold
            btn.TextSize = math.clamp(state.floatButtonSize * 0.19, 8, 15)
            btn.TextWrapped = true
            btn.AutoButtonColor = false
            btn.BorderSizePixel = 0
            btn.Visible = state.floatButtonsEnabled
            btn.ZIndex = 2
            btn.Parent = floatGui
            applyShape(btn, state.floatButtonShape)
            local inner = Instance.new("UIStroke", btn)
            inner.Color = WHITE
            inner.Thickness = 2
            local isOn = def.type == "toggle" and state[def.key] or false
            attachSpinStroke(inner, isOn)
            floatButtons[def.id] = {def = def, btn = btn, inner = inner, outer = outer}
            refreshFloatVisual(def)
            local dragState = nil
            btn.InputBegan:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                dragState = {
                    input = input,
                    start = input.Position,
                    sp = btn.Position,
                    moved = false,
                    locked = state.lockedButtons[def.id] and true or false,
                }
            end)
            UIS.InputChanged:Connect(function(input)
                if not dragState then return end
                if dragState.locked then return end
                if input ~= dragState.input then return end
                if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
                local d = input.Position - dragState.start
                if d.Magnitude > DRAG_DEAD_ZONE then dragState.moved = true end
                if dragState.moved then
                    btn.Position = UDim2.new(dragState.sp.X.Scale, dragState.sp.X.Offset + d.X, dragState.sp.Y.Scale, dragState.sp.Y.Offset + d.Y)
                    outer.Position = btn.Position
                end
            end)
            UIS.InputEnded:Connect(function(input)
                if not dragState then return end
                if input ~= dragState.input then return end
                local st = dragState
                dragState = nil
                if st.moved then
                    state.floatButtonPositions[def.id] = {xScale = btn.Position.X.Scale, xOffset = btn.Position.X.Offset, yScale = btn.Position.Y.Scale, yOffset = btn.Position.Y.Offset}
                    return
                end
                if def.type == "toggle" then
                    state[def.key] = not state[def.key]
                    refreshFloatVisual(def)
                    local dn = toggleDisplayNames[def.key] or def.label
                    _G.__AW_NOTIFY('<font color="'..(state[def.key] and "#5aff8c" or "#ff5a5a")..'">'..dn..'</font> '..(state[def.key] and "on" or "off"))
                    saveSettings()
                else
                    if def.cb then pcall(def.cb) end
                end
            end)
        end
    end
end
