        local sz = math.max(b.AbsoluteSize.X, b.AbsoluteSize.Y) * 2.5
        TweenService:Create(f, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size=UDim2.new(0,sz,0,sz), BackgroundTransparency=1}):Play()
        task.delay(0.6, function() if f and f.Parent then f:Destroy() end end)
