            if drag then update(inp) end
        end)
        UIS.InputEnded:Connect(function() drag = false end)
        ib.FocusLost:Connect(function()
            local v = tonumber(ib.Text)
            if v then
                v = math.clamp(v, minV, maxV)
                if sK then state[sK] = v end
                ib.Text = tostring(v)
                local p = (v - minV) / (maxV - minV)
                TweenService:Create(fl, TweenInfo.new(0.2), {Size = UDim2.new(p, 0, 1, 0)}):Play()
                TweenService:Create(kn, TweenInfo.new(0.2, Enum.EasingStyle.Back), {Position = UDim2.new(p, 0, 0.5, -8 * selectedScale)}):Play()
                if onChange then onChange(v) end
                if sK then saveSettings() end
            else
