    end)
end

local function fullyRestoreCharacter(ch, sd)
    if not ch or not sd then return end
    local h = ch:FindFirstChildOfClass("Humanoid")
    local rp = ch:FindFirstChild("HumanoidRootPart")
    if not h or not rp then return end
    h.PlatformStand = false
    for _, t in ipairs(h:GetPlayingAnimationTracks()) do t:Stop() end
    rp.AssemblyLinearVelocity = Vector3.zero
    rp.AssemblyAngularVelocity = Vector3.zero
    rp.CFrame = sd.cframe
    pcall(sethiddenproperty, rp, "PhysicsRepRootPart", rp)
    h:ChangeState(Enum.HumanoidStateType.GettingUp)
    for _, p in ipairs(ch:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = true end
    end
end

local function resetPlayer(tp)
    if not tp or tp == LP then return false end
    if not targetIsAlive(tp) then return false end
    if activeResets[tp.UserId] then return false end
    local ch = LP.Character; if not ch then return false end
    local h = ch:FindFirstChildOfClass("Humanoid")
    local rp = h and h.RootPart
    local tc = tp.Character
    if not (ch and h and rp and tc) then return false end
    local trp = tc:FindFirstChild("HumanoidRootPart")
    local th = tc:FindFirstChild("Head")
    if not trp then return false end
    local sd = {cframe = rp.CFrame}
    h.PlatformStand = true

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(0, -50000, 0)
    bv.Parent = rp

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 1e6
    bg.Parent = rp

    local odh = Workspace.FallenPartsDestroyHeight
    Workspace.FallenPartsDestroyHeight = -100000

    local st = tick()
    activeResets[tp.UserId] = {active = true}
    setStatus("Flinging " .. tp.Name .. "...")

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if tick() - st > RESET_DURATION or not tp.Character or not trp.Parent then
            Workspace.FallenPartsDestroyHeight = odh
            if bv.Parent then bv:Destroy() end
            if bg.Parent then bg:Destroy() end
            restoreCharacter(ch, sd)
            if conn then conn:Disconnect() end
            activeResets[tp.UserId] = nil
            setStatus(targetIsAlive(tp) and ("Fling done - " .. tp.Name .. " survived") or ("Target " .. tp.Name .. " flung!"))
            return
        end
        if trp and trp.Parent and ch and ch.Parent then
            local sp = trp.Position + Vector3.new(0, 1, 0)
            rp.CFrame = CFrame.new(sp) * CFrame.Angles(math.pi/2, 0, 0)
            rp.AssemblyLinearVelocity = Vector3.new(0, -50000, 0)
            rp.AssemblyAngularVelocity = Vector3.new(7500, 7500, 7500)
            for i = 1, 10 do
                touch(rp, trp); if th then touch(rp, th) end
            end
        end
    end)
    return true
end
local function restoreCharacter(ch, sd) fullyRestoreCharacter(ch, sd) end

local function reliableFling(tp)
    if not tp or tp == LP or not tp.Parent then return end
    if not targetIsAlive(tp) then return end
    if activeResets[tp.UserId] then return end
    resetPlayer(tp)
    local to = tick() + RESET_DURATION + 1.5
    while activeResets[tp.UserId] and tick() < to do task.wait(0.05) end
end

