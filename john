-- ============ AIMBOT ============
RunService.RenderStepped:Connect(function(dt)
    if not alive() then return end
    if not (state.aimbotMurderer or state.aimbotSheriff) then return end
    local cam=Workspace.CurrentCamera; if not cam then return end
    local vps=cam.ViewportSize
    local center=Vector2.new(vps.X*0.5,vps.Y*0.5)
    local cands={}
    if state.aimbotMurderer then
        local m=getMurd(); if m then table.insert(cands,m) end
    elseif state.aimbotSheriff then
        for _,s in ipairs(getLiveSheriffHeroes()) do table.insert(cands,s) end
    end
    if #cands==0 then return end
    local fovR=state.aimbotFOV or 250
    local best,bs=nil,-math.huge
    for _,tp in ipairs(cands) do
        local ch=tp.Character
        if ch then
            local h=ch:FindFirstChildOfClass("Humanoid")
            if h and h.Health>0 then
                local tp2=ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
                if tp2 then
                    local sp,onS=cam:WorldToViewportPoint(tp2.Position)
                    if onS and sp.Z>0 then
                        local sd=(Vector2.new(sp.X,sp.Y)-center).Magnitude
                        if sd<=fovR then
                            local score=-sd
                            if tp2.Name=="Head" then score=score+50 end
                            if score>bs then bs=score; best=tp end
                        end
                    end
                end
            end
        end
    end
    if not best or not best.Character then return end
    local ch=best.Character
    local tp=ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
    if not tp then return end
    local aim=tp.Position
    if state.aimbotPredict then
        local vel=tp.AssemblyLinearVelocity
        if vel.Magnitude>1 then
            local dist=(tp.Position-cam.CFrame.Position).Magnitude
            aim=tp.Position+vel*(dist/800)
        end
    end
    local desired=CFrame.new(cam.CFrame.Position,aim)
    local smooth=state.aimbotSmooth or 4
    if smooth<=1 then cam.CFrame=desired
    else
        local a=math.clamp(1-math.exp(-dt*(60/smooth)*0.15),0.05,1)
        cam.CFrame=cam.CFrame:Lerp(desired,a)
    end
end)

