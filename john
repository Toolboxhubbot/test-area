local function attachClickBounce(btn)
    local us = Instance.new("UIScale", btn)
    us.Scale = 1
    btn.MouseButton1Down:Connect(function() TweenService:Create(us, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 0.92}):Play() end)
    local function restore() TweenService:Create(us, TweenInfo.new(0.45, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Scale = 1}):Play() end
    btn.MouseButton1Up:Connect(restore); btn.MouseLeave:Connect(restore)
end

local function attachHoverLift(btn, amount)
    amount = amount or 1.03
    local us = Instance.new("UIScale", btn); us.Scale = 1
    btn.MouseEnter:Connect(function() TweenService:Create(us, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = amount}):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(us, TweenInfo.new(0.35, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Scale = 1}):Play() end)
end

local function attachHoverTilt(btn, degrees)
    degrees = degrees or 1.5
    local savedRotation = btn.Rotation or 0
    btn.MouseEnter:Connect(function() TweenService:Create(btn, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Rotation = savedRotation + degrees}):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(btn, TweenInfo.new(0.35, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Rotation = savedRotation}):Play() end)
end

local function staggerFadeIn(page)
    local children = {}
    for _, c in ipairs(page:GetChildren()) do if c:IsA("GuiObject") and c.Visible ~= false then table.insert(children, c) end end
    for i, c in ipairs(children) do
        local savedBg = c.BackgroundTransparency
        local savedTextTr = nil
        local savedPos = c.Position
        local offsetX = 20 * (settingsConfig.selectedScale or 1)
        if c:IsA("TextLabel") or c:IsA("TextButton") or c:IsA("TextBox") then savedTextTr = c.TextTransparency; c.TextTransparency = 1 end
        if c:IsA("Frame") or c:IsA("TextButton") or c:IsA("TextBox") then c.BackgroundTransparency = 1 end
        c.Position = UDim2.new(savedPos.X.Scale, savedPos.X.Offset + offsetX, savedPos.Y.Scale, savedPos.Y.Offset)
        task.delay(i * 0.022, function()
            if not c.Parent then return end
            if c:IsA("Frame") or c:IsA("TextButton") or c:IsA("TextBox") then
                TweenService:Create(c, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {BackgroundTransparency = savedBg}):Play()
            end
            if savedTextTr ~= nil then TweenService:Create(c, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = savedTextTr}):Play() end
            TweenService:Create(c, TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = savedPos}):Play()
        end)
    end
end

local function startPulsingGlow(glowFrame, isOn)
    task.spawn(function()
        while glowFrame.Parent do
            if isOn() then
                TweenService:Create(glowFrame, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundTransparency = 0.6}):Play()
                task.wait(1.2)
                if not glowFrame.Parent then break end
                TweenService:Create(glowFrame, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundTransparency = 0.92}):Play()
                task.wait(1.2)
            else task.wait(0.5) end
        end
    end)
end

