local function inRound()
for _,m in ipairs(W:GetChildren()) do if m:FindFirstChild("CoinContainer") or m.Name=="CoinContainer" then return true end end
return false
end
local function inLobby() return not inRound() end
local function alive()
local c=LP.Character
return c and c:FindFirstChild("Humanoid") and c.Humanoid.Health>0 and c:FindFirstChild("HumanoidRootPart")
end
local function tAlive(p)
if not p or not p.Parent then return false end
local c=p.Character; if not c then return false end
local h=c:FindFirstChildOfClass("Humanoid")
return h and h.Health>0
end
local function findTool(n)
local ch,bp=LP.Character,LP:FindFirstChild("Backpack")
if ch and ch:FindFirstChild(n) then return ch[n] end
if bp and bp:FindFirstChild(n) then return bp[n] end
end
local function equip(n)
local ch=LP.Character
local h=ch and ch:FindFirstChildOfClass("Humanoid")
if not h then return end
local e=ch:FindFirstChild(n); if e then return e end
local bp=LP:FindFirstChild("Backpack")
local t=bp and bp:FindFirstChild(n)
if t then
pcall(function() h:EquipTool(t) end)
task.wait(0.15)
return ch:FindFirstChild(n)
end
end
local function isWL(p) if not p then return false end for _,x in ipairs(cfg.wl) do if string.lower(x)==string.lower(p.Name) then return true end end end
local function nameMatch(p,n) if not p or not n or n=="" then return false end local l=string.lower(n) if string.lower(p.Name)==l then return true end if p.DisplayName and string.lower(p.DisplayName)==l then return true end end
local function stand()
local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
local r=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
if h then h.PlatformStand=false; h.AutoRotate=true; pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
if r then r.Anchored=false; r.AssemblyLinearVelocity=Vector3.zero; r.AssemblyAngularVelocity=Vector3.zero end
end
local function bagFull()
if not state.bagGate then return true end
local ls=LP:FindFirstChild("leaderstats")
local c=ls and ls:FindFirstChild("Coins")
local v=c and tonumber(c.Value) or tonumber(LP:GetAttribute("Coins"))
if v==nil then return true end
return v>=(state.bagTarget or 40)
end
local cacheRD,cacheT=nil,0
local function getRD()
local now=tick()
if cacheRD and now-cacheT<2 then return cacheRD end
local ok,d=pcall(function()
local m=RS:FindFirstChild("Modules")
if m then
local pd=m:FindFirstChild("PlayerData") or m:FindFirstChild("Roles") or m:FindFirstChild("RoleData") or m:FindFirstChild("RoundData")
if pd then return require(pd) end
end
end)
if ok and type(d)=="table" then cacheRD=d; cacheT=now; return d end
end
local function getRole(p)
if not p or not p.Parent then return "Innocent" end
local ch=p.Character
local bp=p:FindFirstChild("Backpack")
for _,a in ipairs({"Role","role","RoleName","roleName"}) do
local v=p:GetAttribute(a)
if type(v)=="string" and v~="" then
local sl=string.lower(v)
if sl=="murderer" then return "Murderer" end
if sl=="sheriff" then return "Sheriff" end
if sl=="hero" then return "Hero" end
if sl=="innocent" then return "Innocent" end
return v
end
end
if p.Team and p.Team.Name~="" and p.Team.Name~="Innocents" and p.Team.Name~="Lobby" then return p.Team.Name end
if (ch and ch:FindFirstChild("Knife")) or (bp and bp:FindFirstChild("Knife")) then return "Murderer" end
if (ch and ch:FindFirstChild("Gun")) or (bp and bp:FindFirstChild("Gun")) then return "Sheriff" end
local rd=getRD()
if rd then
local pd=rd[p.Name] or rd[tostring(p.UserId)]
if type(pd)=="string" then return pd end
if type(pd)=="table" then
local r=pd.Role or pd.role or pd.RoleName or pd[1]
if r then return tostring(r) end
end
end
return "Innocent"
end
local function byRole(r)
for _,p in ipairs(P:GetPlayers()) do
if p~=LP and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health>0 and getRole(p)==r then return p end
end
end
local function murd() return byRole("Murderer") end
local function rcol(r)
r=string.lower(tostring(r or ""))
if r=="murderer" then return Color3.fromRGB(255,40,40)
elseif r=="sheriff" or r=="hero" then return Color3.fromRGB(40,130,255)
else return Color3.fromRGB(40,220,90) end
end
local function hasGun(p)
if not p then return false end
local bp,ch=p:FindFirstChild("Backpack"),p.Character
for _,n in ipairs({"Gun","Revolver","Pistol"}) do
if ch and ch:FindFirstChild(n) then return true end
if bp and bp:FindFirstChild(n) then return true end
end
end
local function sheriffs()
local g,o={},{}
for _,p in ipairs(P:GetPlayers()) do
if p~=LP and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health>0 then
local r=getRole(p)
if r=="Sheriff" or r=="Hero" then
if hasGun(p) then table.insert(g,p) else table.insert(o,p) end
elseif hasGun(p) then table.insert(g,p) end
end
end
local res={}
for _,p in ipairs(g) do table.insert(res,p) end
for _,p in ipairs(o) do table.insert(res,p) end
return res
end
