-- ===== SPIN GRADIENT =====
spinGradients = {}
local SPIN_SPEED = 130
local PULSE_SPEED = 0.9
local PULSE_MIN, PULSE_MAX = 0.6, 1.8

local function buildAltSeq(a, b)
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0.000, a), ColorSequenceKeypoint.new(0.166, a),
        ColorSequenceKeypoint.new(0.166, b), ColorSequenceKeypoint.new(0.333, b),
        ColorSequenceKeypoint.new(0.333, a), ColorSequenceKeypoint.new(0.500, a),
        ColorSequenceKeypoint.new(0.500, b), ColorSequenceKeypoint.new(0.666, b),
        ColorSequenceKeypoint.new(0.666, a), ColorSequenceKeypoint.new(0.833, a),
        ColorSequenceKeypoint.new(0.833, b), ColorSequenceKeypoint.new(1.000, b),
    })
end

local function setSpinGradColors(g, isOn)
    if not g then return end
    if isOn then g.Color = buildAltSeq(WHITE, BLACK)
    else g.Color = buildAltSeq(BLACK, WHITE) end
end

local function attachSpinStroke(stroke, isOn, opts)
    if not stroke then return nil end
    opts = opts or {}
    stroke.Color = WHITE
    pcall(function() stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border end)
    local existing = stroke:FindFirstChild("SpinGrad")
    local grad
    if existing then grad = existing
    else
        grad = Instance.new("UIGradient", stroke)
        grad.Name = "SpinGrad"
        grad.Rotation = 0
        table.insert(spinGradients, grad)
    end
    setSpinGradColors(grad, isOn)
    if opts.pulse ~= false and not stroke:GetAttribute("Breathing") then
        stroke:SetAttribute("Breathing", true)
        local baseT = opts.baseThickness or stroke.Thickness or 2
        local minT = math.max(1, baseT * PULSE_MIN)
        local maxT = baseT * PULSE_MAX
        task.spawn(function()
            while stroke and stroke.Parent do
                if state.animationsEnabled == false then
                    stroke.Thickness = baseT
                    task.wait(0.25)
                else
                    TweenService:Create(stroke, TweenInfo.new(PULSE_SPEED, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Thickness = maxT}):Play()
                    task.wait(PULSE_SPEED)
                    if not stroke or not stroke.Parent then break end
                    TweenService:Create(stroke, TweenInfo.new(PULSE_SPEED, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Thickness = minT}):Play()
                    task.wait(PULSE_SPEED)
                end
            end
        end)
    end
    return grad
end

task.spawn(function()
    local rot, wob = 0, 0
    while true do
        local dt = RunService.Heartbeat:Wait()
        if state.animationsEnabled == false then
            task.wait(0.1)
        else
            wob = wob + dt
            local w = 1 + math.sin(wob * 1.4) * 0.15
            rot = (rot + dt * SPIN_SPEED * w) % 360
            for i = #spinGradients, 1, -1 do
                local g = spinGradients[i]
                if g and g.Parent then g.Rotation = rot
                else table.remove(spinGradients, i) end
            end
        end
    end
end)

local function attachBounce(b)
    local s = Instance.new("UIScale", b)
    b.MouseButton1Down:Connect(function()
        if state.animationsEnabled == false then return end
        TweenService:Create(s, TweenInfo.new(0.09, EASE_SMOOTH, EASE_OUT), {Scale=0.94}):Play()
    end)
    local function r()
        if state.animationsEnabled == false then s.Scale = 1; return end
        TweenService:Create(s, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, EASE_OUT), {Scale=1}):Play()
    end
    b.MouseButton1Up:Connect(r)
    b.MouseLeave:Connect(r)
end

local function attachRipple(b, c)
    c = c or WHITE
    b.ClipsDescendants = true
    b.MouseButton1Down:Connect(function()
        if state.animationsEnabled == false then return end
        local pos = b.AbsolutePosition
        local sz = b.AbsoluteSize
        local m = UIS:GetMouseLocation()
        local relX, relY = m.X - pos.X, m.Y - pos.Y
        local f = Instance.new("Frame", b)
        f.AnchorPoint = Vector2.new(0.5,0.5)
        f.Position = UDim2.new(0, relX, 0, relY)
        f.Size = UDim2.new(0,0,0,0)
        f.BackgroundColor3 = c
        f.BackgroundTransparency = 0.4
        f.BorderSizePixel = 0
        f.ZIndex = (b.ZIndex or 1)+5
        f.Active = false
        Instance.new("UICorner", f).CornerRadius = UDim.new(1,0)
        local maxR = math.max(sz.X - relX, relX, sz.Y - relY, relY) * 2.2
        TweenService:Create(f, TweenInfo.new(0.75, EASE_SMOOTH, EASE_OUT), {Size=UDim2.new(0,maxR*2,0,maxR*2), BackgroundTransparency=1}):Play()
        task.delay(0.85, function() if f and f.Parent then f:Destroy() end end)
    end)
end

local function attachShine(b)
    b.ClipsDescendants = true
    local s = Instance.new("Frame", b)
    s.Size = UDim2.new(0,40,1.6,0)
    s.Position = UDim2.new(-0.4,0,-0.3,0)
    s.BackgroundColor3 = WHITE
    s.BackgroundTransparency = 0.82
    s.Rotation = 12
    s.BorderSizePixel = 0
    s.ZIndex = (b.ZIndex or 1)+2
    s.Active = false
    local running = false
    b.MouseEnter:Connect(function()
        if state.animationsEnabled == false then return end
        if running then return end
        running = true
        s.Position = UDim2.new(-0.4,0,-0.3,0)
        TweenService:Create(s, TweenInfo.new(0.7, EASE_SMOOTH, EASE_OUT), {Position=UDim2.new(1.4,0,-0.3,0)}):Play()
        task.delay(0.75, function() running = false end)
    end)
end

local function staggerFade(p)
    if state.animationsEnabled == false then return end
    local ch = {}
    for _, c in ipairs(p:GetChildren()) do
        if c:IsA("GuiObject") and c.Visible ~= false and not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
            table.insert(ch, c)
        end
    end
    for i, c in ipairs(ch) do
        local sb = c.BackgroundTransparency
        local stt = nil
        if c:IsA("TextLabel") or c:IsA("TextButton") or c:IsA("TextBox") then
            stt = c.TextTransparency; c.TextTransparency = 1
        end
        if c:IsA("Frame") or c:IsA("TextButton") then c.BackgroundTransparency = 1 end
        local origPos = c.Position
        c.Position = origPos + UDim2.new(0, 10, 0, 0)
        task.delay(i * 0.02, function()
            if not c.Parent then return end
            if state.animationsEnabled == false then
                c.Position = origPos
                if stt then c.TextTransparency = stt end
                if c:IsA("Frame") or c:IsA("TextButton") then c.BackgroundTransparency = sb end
                return
            end
            if c:IsA("Frame") or c:IsA("TextButton") then
                TweenService:Create(c, TweenInfo.new(0.5, EASE_BOUNCE, EASE_OUT), {BackgroundTransparency=sb, Position=origPos}):Play()
            end
            if stt then TweenService:Create(c, TweenInfo.new(0.4, EASE_SOFT), {TextTransparency=stt}):Play() end
        end)
    end
end

