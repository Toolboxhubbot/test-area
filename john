            TweenService:Create(optBtn, TweenInfo.new(0.15), {BackgroundColor3 = cc3(settingsConfig.accentColor), TextColor3 = Color3.new(0,0,0)}):Play()
        end)
        optBtn.MouseLeave:Connect(function()
            if state.animationsEnabled == false then return end
            TweenService:Create(optBtn, TweenInfo.new(0.15), {BackgroundColor3 = cc3(settingsConfig.cardHoverColor), TextColor3 = cc3(settingsConfig.textColor)}):Play()
        end)
        optBtn.MouseButton1Click:Connect(function()
            current = opt
            val.Text = tostring(opt)
            setOpen(false)
            if onSelect then pcall(onSelect, opt) end
        end)
    end

    header.MouseButton1Click:Connect(function()
        setOpen(not open)
    end)

    return wrapper, function() return current end, function(newVal)
        current = newVal
        val.Text = tostring(newVal)
    end
end

