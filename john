local function isInRound()
    for _,m in ipairs(Workspace:GetChildren()) do
        if m:FindFirstChild("CoinContainer") or m.Name=="CoinContainer" then return true end
    end
    return false
end
local function isLobby() return not isInRound() end
local function alive()
    local c = LP.Character
    return c and c:FindFirstChild("Humanoid") and c.Humanoid.Health>0 and c:FindFirstChild("HumanoidRootPart")
end
local function targetIsAlive(plr)
    if not plr or not plr.Parent then return false end
    local c = plr.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    return h and h.Health>0
end
local function findTool(n)
    local ch, bp = LP.Character, LP:FindFirstChild("Backpack")
    if ch and ch:FindFirstChild(n) then return ch[n] end
    if bp and bp:FindFirstChild(n) then return bp[n] end
    return nil
end
local function equipTool(n)
    local ch = LP.Character
    local bp = LP:FindFirstChild("Backpack")
    local h = ch and ch:FindFirstChildOfClass("Humanoid")
    if not ch or not h then return nil end
    local e = ch:FindFirstChild(n); if e then return e end
    local t = bp and bp:FindFirstChild(n)
    if t then
        pcall(function() h:EquipTool(t) end)
        for _=1,10 do
            task.wait(0.03)
            local f = ch:FindFirstChild(n)
            if f then return f end
        end
    end
    return nil
end
local function isWhitelisted(p)
    if not p then return false end
    for _,x in ipairs(settingsConfig.whitelist) do
        if string.lower(x)==string.lower(p.Name) then return true end
    end
    return false
end
local function standUp()
    local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    local r = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if h then h.PlatformStand=false; h.AutoRotate=true; pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
    if r then r.Anchored=false; r.AssemblyLinearVelocity=Vector3.zero; r.AssemblyAngularVelocity=Vector3.zero end
end

local function readNum(v)
    if v == nil then return nil end
    if type(v) == "number" then return v end
    if typeof and typeof(v) == "Instance" then
        if v:IsA("IntValue") or v:IsA("NumberValue") or v:IsA("StringValue") then
            local n = tonumber(v.Value)
            if n then return n end
        end
    end
    return nil
end

local function getCoinCount()
    local candidates = {
        function() return LP:FindFirstChild("Coins") end,
        function() return LP:FindFirstChild("coins") end,
        function() local ls = LP:FindFirstChild("leaderstats"); return ls and ls:FindFirstChild("Coins") end,
        function() return LP:GetAttribute("Coins") end,
    }
    for _, fn in ipairs(candidates) do
        local ok, v = pcall(fn)
        if ok and v ~= nil then
            local n = readNum(v)
            if n then return n end
        end
    end
    return nil
end

local function isBagFull()
    if not state.fullBagGate then return true end
    local c = getCoinCount()
    if c == nil then return true end
    return c >= (state.bagTarget or 40)
end

local cachedRoleModule, cachedRoleModuleAt = nil, 0
local function getCachedRoleData()
    local now = tick()
    if cachedRoleModule and (now - cachedRoleModuleAt) < 2 then return cachedRoleModule end
    local ok, data = pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        if mods then
            local pd = mods:FindFirstChild("PlayerData") or mods:FindFirstChild("Roles") or mods:FindFirstChild("RoleData") or mods:FindFirstChild("RoundData")
            if pd then return require(pd) end
        end
        local direct = ReplicatedStorage:FindFirstChild("PlayerData") or ReplicatedStorage:FindFirstChild("Roles")
        if direct then return require(direct) end
    end)
    if ok and type(data) == "table" then
        cachedRoleModule = data; cachedRoleModuleAt = now; return data
    end
    local rf = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if rf and rf:IsA("RemoteFunction") then
        local s, res = pcall(function() return rf:InvokeServer() end)
        if s and type(res) == "table" then
            cachedRoleModule = res; cachedRoleModuleAt = now; return res
        end
    end
    return nil
end

local function getPlayerRole(plr)
    if not plr or not plr.Parent then return "Innocent" end
    local ch = plr.Character
    local bp = plr:FindFirstChild("Backpack")
    for _, attrName in ipairs({"Role","role","RoleName","roleName","Murderer","IsMurderer","Sheriff","IsSheriff"}) do
        local a = plr:GetAttribute(attrName)
        if a ~= nil then
            if type(a) == "boolean" then
                if attrName == "Murderer" or attrName == "IsMurderer" then
                    if a then return "Murderer" end
                elseif attrName == "Sheriff" or attrName == "IsSheriff" then
                    if a then return "Sheriff" end
                end
            elseif a and tostring(a) ~= "" then
                local s = tostring(a)
                local sl = string.lower(s)
                if sl == "murderer" then return "Murderer"
                elseif sl == "sheriff" then return "Sheriff"
                elseif sl == "hero" then return "Hero"
                elseif sl == "innocent" then return "Innocent"
                else return s end
            end
        end
    end
    if plr.Team and plr.Team.Name ~= "" then
        local tn = plr.Team.Name
        if tn ~= "Innocents" and tn ~= "Lobby" then return tn end
    end
    if ch then
        for _, attrName in ipairs({"Role","role","RoleName","roleName"}) do
            local a = ch:GetAttribute(attrName)
            if a and tostring(a) ~= "" then return tostring(a) end
        end
    end
    if (ch and ch:FindFirstChild("Knife")) or (bp and bp:FindFirstChild("Knife")) then return "Murderer" end
    if (ch and ch:FindFirstChild("Gun"))   or (bp and bp:FindFirstChild("Gun"))   then return "Sheriff"  end
    if ch then
        if ch:FindFirstChild("Murderer") or ch:FindFirstChild("IsMurderer") then return "Murderer" end
        if ch:FindFirstChild("Sheriff")  or ch:FindFirstChild("IsSheriff")  then return "Sheriff"  end
        if ch:FindFirstChild("Hero")     or ch:FindFirstChild("IsHero")     then return "Hero"     end
    end
    local rd = getCachedRoleData()
    if rd and type(rd) == "table" then
        local pd = rd[plr.Name] or rd[tostring(plr.UserId)] or rd[plr.UserId]
        if pd then
            if type(pd) == "string" then return pd end
            if type(pd) == "table" then
                local r = pd.Role or pd.role or pd.RoleName or pd.roleName or pd.Team or pd[1]
                if r and tostring(r) ~= "" then return tostring(r) end
            end
        end
    end
    return "Innocent"
end

