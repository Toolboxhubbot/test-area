local function getCachedRoleData()
    local now = tick()
    if cachedRoleModule and (now - cachedRoleModuleAt) < 1 then return cachedRoleModule end
    local ok, data = pcall(function()
        local paths = {
            {"Modules", "PlayerData"}, {"Modules", "Roles"},
            {"Modules", "RoleData"}, {"PlayerData"}, {"Roles"}, {"RoleData"},
        }
        for _, path in ipairs(paths) do
            local obj = ReplicatedStorage
            for _, name in ipairs(path) do
                obj = obj and obj:FindFirstChild(name)
            end
            if obj and obj:IsA("ModuleScript") then
                local ok2, m = pcall(require, obj)
                if ok2 and type(m) == "table" then return m end
            end
        end
        for _, name in ipairs({"GetPlayerData", "GetRole", "GetRoles"}) do
            local rf = ReplicatedStorage:FindFirstChild(name, true)
            if rf and rf:IsA("RemoteFunction") then
                local ok3, res = pcall(function() return rf:InvokeServer() end)
                if ok3 and type(res) == "table" then return res end
            end
        end
        return nil
    end)
    if ok and type(data) == "table" then
        cachedRoleModule = data
        cachedRoleModuleAt = now
        return data
    end
    return nil
end

local function getPlayerRole(plr)
    if not plr or not plr.Parent then return "Innocent" end
    local ch = plr.Character
    local bp = plr:FindFirstChild("Backpack")
    for _, attrName in ipairs({"Role","role","RoleName","roleName","Team","team",
                                "IsMurderer","isMurderer","IsSheriff","isSheriff","IsHero","isHero"}) do
        local a = plr:GetAttribute(attrName)
        if a ~= nil then
            if type(a) == "boolean" then
                if a then
                    local low = attrName:lower()
                    if low:find("murder") then return "Murderer" end
                    if low:find("sheriff") then return "Sheriff" end
                    if low:find("hero") then return "Hero" end
                end
            elseif type(a) == "string" and a ~= "" then
                return a
            end
        end
    end
    if plr.Team and plr.Team.Name ~= "" then
        local tn = plr.Team.Name
        if tn ~= "Innocents" and tn ~= "Lobby" then return tn end
    end
    if ch then
        for _, attrName in ipairs({"Role","role","RoleName","roleName","Team","team"}) do
            local a = ch:GetAttribute(attrName)
            if a and tostring(a) ~= "" then return tostring(a) end
        end
        for _, child in ipairs(ch:GetChildren()) do
            local n = child.Name
            if n == "Murderer" or n == "IsMurderer" then return "Murderer" end
            if n == "Sheriff"  or n == "IsSheriff"  then return "Sheriff" end
            if n == "Hero"     or n == "IsHero"     then return "Hero" end
            if n == "Tag" or n == "Role" then
                local v = child.Value
                if type(v) == "string" and (v == "Murderer" or v == "Sheriff" or v == "Hero" or v == "Innocent") then
                    return v
                end
            end
        end
    end
    if (bp and bp:FindFirstChild("Knife")) or (ch and ch:FindFirstChild("Knife")) then return "Murderer" end
    if (bp and bp:FindFirstChild("Gun"))   or (ch and ch:FindFirstChild("Gun"))   then return "Sheriff"  end
    local rd = getCachedRoleData()
    if rd and type(rd) == "table" then
        local pd = rd[plr.Name] or rd[tostring(plr.UserId)] or rd[plr.UserId]
        if not pd and type(rd.Roles) == "table" then
            pd = rd.Roles[plr.Name] or rd.Roles[tostring(plr.UserId)]
        end
        if pd then
            if type(pd) == "string" then return pd end
            if type(pd) == "table" then
                local r = pd.Role or pd.role or pd.RoleName or pd.roleName or pd.Team or pd[1]
                if r and tostring(r) ~= "" then return tostring(r) end
            end
        end
    end
    return "Innocent"
end

