local uiHidden=false
local function toggleUI()
    uiHidden=not uiHidden
    MW.Visible=not uiHidden
    if SFV then SFV(not uiHidden) end
    if BW then BW.Visible=(not uiHidden) and state.bigButtonEnabled end
    if uiHidden then
        _G.__AW_NOTIFY("UI Hidden - press "..string.upper(state.keybinds.hideUI or "H").." or type .showui to show")
    else
        _G.__AW_NOTIFY("UI Shown")
    end
end
_G.__AW_SHOWUI=function()
    if uiHidden then
        uiHidden=false
        MW.Visible=true
        if SFV then SFV(true) end
        if BW then BW.Visible=state.bigButtonEnabled end
        _G.__AW_NOTIFY("UI Shown")
    end
end
_G.__AW_HIDEUI=function()
    if not uiHidden then
        uiHidden=true
        MW.Visible=false
        if SFV then SFV(false) end
        if BW then BW.Visible=false end
        _G.__AW_NOTIFY("UI Hidden")
    end
end

UIS.InputBegan:Connect(function(inp,gp)
    if inp.UserInputType~=Enum.UserInputType.Keyboard then return end
    if LF2 then
        state.keybinds[LF2]=inp.KeyCode.Name
        local l=KKL[LF2]
        if l then l.Text=string.upper(inp.KeyCode.Name) end
        LF2=nil
        RASB()
        saveSettings()
        _G.__AW_NOTIFY("Set: "..string.upper(inp.KeyCode.Name))
        return
    end
    if gp then return end
    if UIS:GetFocusedTextBox() then return end
    for ft,kn in pairs(state.keybinds) do
        if kn and kn~="" and inp.KeyCode.Name==kn then
            if ft=="hideUI" then
                toggleUI()
                break
            end
            if state[ft]~=nil and type(state[ft])=="boolean" then
                local ns=not state[ft]
                state[ft]=ns
                local dn=TD[ft] or ft
                _G.__AW_NOTIFY('<font color="'..(ns and "#5aff8c" or "#ff5a5a")..'">'..dn..'</font> '..(ns and "on" or "off"))
                if ft=="voidPlatform" and not ns then RVP() end
                if (ft=="speedEnabled" or ft=="speedGlitch" or ft=="jumpEnabled" or ft=="flyEnabled") and not ns and LP.Character then
                    local h=LP.Character:FindFirstChildOfClass("Humanoid")
                    if h then
                        if ft=="flyEnabled" then
                            h.WalkSpeed=16
                            h.PlatformStand=false
                        end
                        if ft=="speedEnabled" or ft=="speedGlitch" then h.WalkSpeed=16 end
                        if ft=="jumpEnabled" then h.UseJumpPower=false end
                    end
                end
                saveSettings()
                break
            end
        end
    end
end)

