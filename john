function hasClearShot(targetPart)
    if not state.silentAimWallCheck then return true end
    if not targetPart then return true end
    local cam = Workspace.CurrentCamera
    if not cam then return true end
    local origin = cam.CFrame.Position
    local dir = targetPart.Position - origin
    local rp = RaycastParams.new()
    local ignore = {}
    if LP.Character then table.insert(ignore, LP.Character) end
    if targetPart.Parent then table.insert(ignore, targetPart.Parent) end
    rp.FilterDescendantsInstances = ignore
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local res = Workspace:Raycast(origin, dir, rp)
    return res == nil
end

function getAimPosAtLevel(char)
    if not char then return nil end
    local level = state.magicBulletYLevel or 0
    local root = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not root then return nil end
    if level >= 1 then return (head and head.Position) or (root.Position + Vector3.new(0, 1.5, 0))
    elseif level <= -1 then return root.Position - Vector3.new(0, 6, 0)
    else return (torso and torso.Position) or (root.Position + Vector3.new(0, 0.5, 0)) end
end

-- ============ SHOOT REMOTE LOOKUP ============
shootRemoteCache = nil
function findShootRemote()
    if shootRemoteCache and shootRemoteCache.Parent then return shootRemoteCache end
    local gun = getGun()
    if gun then
        local shoot = gun:FindFirstChild("Shoot", true)
        if shoot and (shoot:IsA("RemoteEvent") or shoot:IsA("RemoteFunction")) then
            shootRemoteCache = shoot
            return shoot
        end
        for _, c in ipairs(gun:GetDescendants()) do
            if c:IsA("RemoteEvent") or c:IsA("RemoteFunction") then
                local ln = string.lower(c.Name)
                if string.find(ln, "shoot") or string.find(ln, "fire") or string.find(ln, "hit") then
                    shootRemoteCache = c
                    return c
                end
            end
        end
    end
    local paths = {
        {ReplicatedStorage, "Remotes", "Gameplay", "GunHit"},
        {ReplicatedStorage, "Remotes", "Gameplay", "ShootGun"},
        {ReplicatedStorage, "Remotes", "Gameplay", "Shoot"},
        {ReplicatedStorage, "Remotes", "ShootGun"},
        {ReplicatedStorage, "Remotes", "Shoot"},
        {ReplicatedStorage, "ShootGun"},
    }
    for _, path in ipairs(paths) do
        local cur = path[1]
        local ok = true
        for i = 2, #path do
            cur = cur and cur:FindFirstChild(path[i])
            if not cur then ok = false break end
        end
        if ok and cur and (cur:IsA("RemoteEvent") or cur:IsA("RemoteFunction")) then
            shootRemoteCache = cur
            return cur
        end
    end
    return nil
end

function fireSilentAtMurderer()
    if not canFire() then return false end
    local murd = getMurd()
    if not murd or not murd.Character then return false end
    local char = murd.Character
    local part = char:FindFirstChild("Head") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
    if not part then return false end
    if not state.shootThroughWall and not hasClearShot(part) then return false end
    local aimPos = getAimPosAtLevel(char)
    if not aimPos then return false end
    local cam = Workspace.CurrentCamera
    if not cam then return false end
    local gun = getGun()
    if not gun then return false end
    if gun.Parent ~= LP.Character then
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum:EquipTool(gun) end)
            task.wait(0.08)
            gun = LP.Character and LP.Character:FindFirstChild(gun.Name) or gun
        end
    end
    lastShotTime = tick()
    local savedCF = cam.CFrame
    cam.CFrame = CFrame.new(cam.CFrame.Position, aimPos)
    RunService.RenderStepped:Wait()
    pcall(function() gun:Activate() end)
    task.defer(function()
        RunService.RenderStepped:Wait()
        RunService.RenderStepped:Wait()
        if cam then cam.CFrame = savedCF end
    end)
    return true
end

function fireThroughWall()
    if not canFire() then return false end
    local murd = getMurd()
    if not murd or not murd.Character then return false end
    local char = murd.Character
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local remote = findShootRemote()
    if not remote then return false end
    lastShotTime = tick()
    local aimPos = getAimPosAtLevel(char) or root.Position
    local hum = char:FindFirstChildOfClass("Humanoid")
    local yLevel = state.magicBulletYLevel or 0
    pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(aimPos)
            remote:FireServer(aimPos, hum)
            remote:FireServer(aimPos, char)
            remote:FireServer(CFrame.new(aimPos), hum)
            remote:FireServer(aimPos, hum, yLevel)
        elseif remote:IsA("RemoteFunction") then
            remote:InvokeServer(aimPos)
            remote:InvokeServer(aimPos, hum)
        end
    end)
    return true
end

function tryShootMurderer()
    if state.shootThroughWall then return fireThroughWall() else return fireSilentAtMurderer() end
end
function fullShootSequence() return tryShootMurderer() end

