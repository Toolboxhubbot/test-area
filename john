task.spawn(function()
    while true do
        task.wait(0.05)
        if not state.farm and not state.xpFarm then
            cancelFarmTween()
        else
            if not alive() then
                cancelFarmTween()
            else
                local r = LP.Character:FindFirstChild("HumanoidRootPart")
                local h = LP.Character:FindFirstChildOfClass("Humanoid")
                if r and h then
                    if state.xpFarm then
                        cancelFarmTween()
                        h.PlatformStand = true
                        r.Anchored = true
                        r.CFrame = HIDE_POS
                        r.AssemblyLinearVelocity = Vector3.zero
                        r.AssemblyAngularVelocity = Vector3.zero
                    elseif state.farm then
                        if isLobby() or bagFull or isExecutingAction or next(activeResets) then
                            cancelFarmTween()
                            if not isExecutingAction and not next(activeResets) then
                                h.PlatformStand = true
                                r.Anchored = true
                                r.CFrame = HIDE_POS
                                r.AssemblyLinearVelocity = Vector3.zero
                            end
                            lastCoinFoundTime = tick()
                        else
                            r.Anchored = false
                            h.PlatformStand = true
                            h.AutoRotate = false
                            r.AssemblyLinearVelocity = Vector3.zero
                            r.AssemblyAngularVelocity = Vector3.zero
                            local coins = {}
                            for _, m in ipairs(Workspace:GetChildren()) do
                                local cc = m:FindFirstChild("CoinContainer") or (m.Name == "CoinContainer" and m)
                                if cc then
                                    for _, d in ipairs(cc:GetDescendants()) do
                                        if d:IsA("BasePart") and d:FindFirstChild("TouchInterest") then
                                            table.insert(coins, d)
                                        end
                                    end
                                end
                            end
                            if #coins > 0 then
                                lastCoinFoundTime = tick()
                                local closest, sh = nil, math.huge
                                for _, c in ipairs(coins) do
                                    local d = (r.Position - c.Position).Magnitude
                                    if d < sh then sh = d; closest = c end
                                end
                                if closest then
                                    local d = (r.Position - closest.Position).Magnitude
                                    if d <= 7 then
                                        if not collectedCoinRefs[closest] then
                                            collectedCoinRefs[closest] = true
                                            currentCoinCount = currentCoinCount + 1
                                            if currentCoinCount >= maxCoinCount then
                                                bagFull = true
                                                totalCoinsEarned = totalCoinsEarned + maxCoinCount
                                            end
                                        end
                                        pcall(function()
                                            for _ = 1, 3 do
                                                firetouchinterest(r, closest, 0)
                                                firetouchinterest(r, closest, 1)
                                            end
                                        end)
                                    end
                                    if currentTargetCoin ~= closest then
                                        cancelFarmTween()
                                        currentTargetCoin = closest
                                        local tp = closest.Position + Vector3.new(0, -UNDER, 0)
                                        local tc = CFrame.new(tp) * CFrame.Angles(math.rad(90), 0, math.rad(180))
                                        local dur = math.clamp(d / TWEEN_SPEED, 0.05, 3.3)
                                        currentFarmTween = TweenService:Create(r, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame = tc})
                                        currentFarmTween:Play()
                                    end
                                end
                            elseif tick() - lastCoinFoundTime > NO_COIN_TIMEOUT then
                                lastCoinFoundTime = tick()
                                if not isLobby() then
                                    triggerMenuReset()
                                    task.wait(1.5)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

