            local cn
            cn = LP.CharacterAdded:Connect(function() fn = true; if cn then cn:Disconnect() end end)
            local tm = 0
            while not fn and tm < 15 do task.wait(0.1); tm = tm + 0.1 end
            if cn then cn:Disconnect() end
