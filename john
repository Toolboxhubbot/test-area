local espFolder = Instance.new("Folder")
espFolder.Name = "AW_ESP_Container"
pcall(function() espFolder.Parent = getGuiParent() end)
local espCache = {}

local function clearESP(instance)
    if espCache[instance] then
        pcall(function()
            if espCache[instance].highlight then espCache[instance].highlight:Destroy() end
            if espCache[instance].billboard then espCache[instance].billboard:Destroy() end
        end)
        espCache[instance] = nil
    end
end

local function updateCreateESP(instance, textStr, color)
    if not instance or not instance.Parent then clearESP(instance) return end
    if not espCache[instance] then
        local highlight = Instance.new("Highlight")
        highlight.Adornee = instance; highlight.FillColor = color
        highlight.FillTransparency = 0.5; highlight.OutlineColor = color
        highlight.OutlineTransparency = 0.2
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = espFolder
        local billboard = Instance.new("BillboardGui")
        billboard.Adornee = instance
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 4, 0)
        billboard.AlwaysOnTop = true; billboard.Parent = espFolder
        local text = Instance.new("TextLabel")
        text.Size = UDim2.new(1, 0, 1, 0); text.BackgroundTransparency = 1
        text.Text = textStr; text.TextColor3 = color; text.TextStrokeTransparency = 0
        text.Font = Enum.Font.GothamBold; text.TextSize = 12; text.Parent = billboard
        espCache[instance] = {highlight = highlight, billboard = billboard, text = text}
    else
        local esp = espCache[instance]
        if esp.highlight and esp.billboard and esp.text then
            esp.highlight.Adornee = instance; esp.billboard.Adornee = instance
            esp.highlight.FillColor = color; esp.highlight.OutlineColor = color
            esp.text.Text = textStr; esp.text.TextColor3 = color
        else clearESP(instance) end
    end
end

