local function fireThroughWall()
    if not canFire() then return false end
    local m=getMurd(); if not m or not m.Character then return false end
    local root=m.Character:FindFirstChild("HumanoidRootPart"); if not root then return false end
    local remote=findShootRemote(); if not remote then return false end
    lastShot=tick()
    local tCF=root.CFrame
    local oCF=CFrame.new(tCF.Position+Vector3.new(0,3,0))
    pcall(function()
        if remote:IsA("RemoteEvent") then remote:FireServer(oCF,tCF); remote:FireServer(tCF)
        elseif remote:IsA("RemoteFunction") then remote:InvokeServer(oCF,tCF) end
    end)
    return true
end
