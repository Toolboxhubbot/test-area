flyBV=nil
flyBG=nil
flyConn=nil
flyUpHold=false
local function startFly()
    local ch=LP.Character
    if not ch then return end
    local hrp=ch:FindFirstChild("HumanoidRootPart")
    local h=ch:FindFirstChildOfClass("Humanoid")
    if not hrp or not h then return end
    h.PlatformStand=true
    if not flyBV or not flyBV.Parent then
        flyBV=Instance.new("BodyVelocity")
        flyBV.MaxForce=Vector3.new(9e9,9e9,9e9)
        flyBV.P=10000
        flyBV.Velocity=Vector3.zero
        flyBV.Parent=hrp
    end
    if not flyBG or not flyBG.Parent then
        flyBG=Instance.new("BodyGyro")
        flyBG.P=9e4
        flyBG.MaxTorque=Vector3.new(9e9,9e9,9e9)
        flyBG.CFrame=hrp.CFrame
        flyBG.Parent=hrp
    end
    if flyConn then flyConn:Disconnect() end
    flyConn=RunService.RenderStepped:Connect(function()
        local c=LP.Character
        if not c then return end
        local rt=c:FindFirstChild("HumanoidRootPart")
        local hh=c:FindFirstChildOfClass("Humanoid")
        if not rt or not hh then return end
        if not flyBV or not flyBV.Parent then return end
        if not flyBG or not flyBG.Parent then return end
        local cm=Workspace.CurrentCamera
        if not cm then return end
        local ccf=cm.CFrame
        local mv=Vector3.zero
        local md=hh.MoveDirection
        if md.Magnitude>0.01 then
            local fl=Vector3.new(ccf.LookVector.X,0,ccf.LookVector.Z)
            local fr=Vector3.new(ccf.RightVector.X,0,ccf.RightVector.Z)
            if fl.Magnitude>0.01 then fl=fl.Unit end
            if fr.Magnitude>0.01 then fr=fr.Unit end
            local fm=Vector3.new(md.X,0,md.Z)
            if fm.Magnitude>0.01 then fm=fm.Unit end
            local fa=0
            local ra=0
            if fl.Magnitude>0.01 then fa=fm:Dot(fl) end
            if fr.Magnitude>0.01 then ra=fm:Dot(fr) end
            if fa~=0 then mv=mv+ccf.LookVector*fa end
            if ra~=0 then mv=mv+ccf.RightVector*ra end
        end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then mv=mv+ccf.UpVector end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then mv=mv-ccf.UpVector end
        if flyUpHold then mv=mv+ccf.UpVector end
        local sp=state.flySpeed or 50
        if mv.Magnitude>0 then flyBV.Velocity=mv.Unit*sp else flyBV.Velocity=Vector3.zero end
        flyBG.CFrame=ccf
    end)
end
local function stopFly()
    if flyConn then
        flyConn:Disconnect()
        flyConn=nil
    end
    if flyBV and flyBV.Parent then flyBV:Destroy() end
    if flyBG and flyBG.Parent then flyBG:Destroy() end
    flyBV=nil
    flyBG=nil
    local ch=LP.Character
    if ch then
        local h=ch:FindFirstChildOfClass("Humanoid")
        if h then
            h.PlatformStand=false
            h.AutoRotate=true
            h.WalkSpeed=16
        end
        local r=ch:FindFirstChild("HumanoidRootPart")
        if r then
            r.AssemblyLinearVelocity=Vector3.zero
            r.AssemblyAngularVelocity=Vector3.zero
        end
    end
end
