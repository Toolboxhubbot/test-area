syncToggleUI = function(key, ns)
    local t = mainTgls[key]
    if t then
        TweenService:Create(t.pill, TweenInfo.new(0.32, EASE_BOUNCE, EASE_OUT), {
            BackgroundColor3 = ns and THEME.accent or Color3.fromRGB(26, 26, 40)
        }):Play()
        if ns and not t.grad then
            t.grad = gradient(t.pill, THEME.accent, THEME.accent2, 0)
        elseif t.grad and not ns then
            local gr = t.grad
            t.grad = nil
            task.delay(0.32, function()
                if gr and gr.Parent then gr:Destroy() end
            end)
        end
        TweenService:Create(t.dot, TweenInfo.new(0.4, Enum.EasingStyle.Elastic, EASE_OUT), {
            Position = ns and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8)
        }):Play()
    end
    if key == "bigButtonEnabled" and bigWrap then bigWrap.Visible = ns end
    if key == "floatButtonsEnabled" then setFloatVisible(ns) end
    if FLOAT_BUTTON_MAP[key] then refreshFloatVisual(FLOAT_BUTTON_MAP[key]) end
end

