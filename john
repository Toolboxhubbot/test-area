local killLocked = {}
local activeResets = {}
local RESET_DURATION = 2.0
local isLocalFlinging = false
local flingActiveCount = 0

local function isResetActive(userId)
    local t = activeResets[userId]
    if not t then return false end
    if tick()-t > RESET_DURATION + 0.5 then activeResets[userId] = nil; return false end
    return true
