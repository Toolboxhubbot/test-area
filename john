task.spawn(function()
    while true do
        task.wait(0.1)
        if not state.showRoundTimerCountdown then
            if roundTimerFrame.Visible then roundTimerFrame.Visible = false end
        elseif isInRound() then
            local rem = getRoundTimeRemaining()
            if rem then
                local tot = math.floor(rem + 0.5)
                local mm = math.floor(tot / 60)
                local ss = tot % 60
                local nt = string.format("%d:%02d", mm, ss)
                if rtValue.Text ~= nt then rtValue.Text = nt end
                if not roundTimerFrame.Visible then roundTimerFrame.Visible = true end
                if tot <= 30 then rtValue.TextColor3 = Color3.fromRGB(255, 80, 80)
                elseif tot <= 60 then rtValue.TextColor3 = Color3.fromRGB(255, 190, 80)
                else rtValue.TextColor3 = Color3.new(1, 1, 1) end
            else
                if roundTimerFrame.Visible then roundTimerFrame.Visible = false end
            end
        else
            if roundTimerFrame.Visible then roundTimerFrame.Visible = false end
        end
    end
end)

