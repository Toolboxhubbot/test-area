                    _G.__AW_NOTIFY('<font color="'..(state[d.key] and "#5aff8c" or "#ff5a5a")..'">'..dn..'</font> '..(state[d.key] and "on" or "off"))
                    if d.key=="voidPlatform" and not state.voidPlatform then RVP() end
                    saveSettings()
                else
                    if d.cb then pcall(d.cb) end
                end
            end)
        end
    end
