    local function setAnimIdOnChar(char, slot, id)
        if not char or not id then return end
        local animate = char:FindFirstChild("Animate")
        if not animate then return end
        local path = ANIM_SLOT_PATHS[slot]
        if not path then return end
        local folder = animate:FindFirstChild(path[1])
        if not folder then return end
        local anim = folder:FindFirstChild(path[2])
        if anim and anim:IsA("Animation") then
            anim.AnimationId = id
        end
    end

    local function getAnimIdFromChar(char, slot)
        local animate = char and char:FindFirstChild("Animate")
        if not animate then return nil end
        local path = ANIM_SLOT_PATHS[slot]
        if not path then return nil end
        local folder = animate:FindFirstChild(path[1])
        if not folder then return nil end
        local anim = folder:FindFirstChild(path[2])
        if anim and anim:IsA("Animation") then return anim.AnimationId end
        return nil
    end

