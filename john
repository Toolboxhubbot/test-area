function isBarrierName(n)
    if n=="THICC" or n=="Glitchproof" or n=="Glitch" then return true end
    if n=="KillBrick" or n=="Kill Brick" or n=="KillBricks" then return true end
    local ln=string.lower(n)
    if string.find(ln,"glitchproof",1,true) then return true end
    if string.find(ln,"glitch",1,true) then return true end
    if string.find(ln,"killbrick",1,true) then return true end
    if string.find(ln,"kill_brick",1,true) then return true end
    if string.find(ln,"thicc",1,true) then return true end
    return false
end
function collectBarrierParts()
    local parts={}
    local seen={}
    local cs={Workspace}
    local map=Workspace:FindFirstChild("map")
    if map then table.insert(cs,map) end
    local lobby=Workspace:FindFirstChild("lobby")
    if lobby then table.insert(cs,lobby) end
    for _,c in ipairs(cs) do
        if c then
            for _,d in ipairs(c:GetDescendants()) do
                if d:IsA("BasePart") and not seen[d] and isBarrierName(d.Name) then
                    seen[d]=true
                    table.insert(parts,d)
                end
            end
        end
    end
    return parts
end
function removeBarriersNow()
    local parts=collectBarrierParts()
