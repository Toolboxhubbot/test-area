local function invisStart()
    if invisActive then return end
    local ch = LP.Character
    if not ch then return end
    local r = ch:FindFirstChild("HumanoidRootPart")
    local h = ch:FindFirstChildOfClass("Humanoid")
    if not r or not h or h.Health <= 0 then return end
    invisRealRoot = r
    invisStaticPos = CFrame.new(0, Workspace.FallenPartsDestroyHeight + 100, 0)
    invisLastSafeCFrame = r.CFrame
    ch.Archivable = true
    invisGhost = ch:Clone()
    invisGhost.Parent = Workspace
    ch.Archivable = false
    for _,v in invisGhost:GetDescendants() do
        if v:IsA("BasePart") then v.Transparency = 0.5
        elseif v:IsA("Accessory") then local ha = v:FindFirstChild("Handle"); if ha and ha:IsA("BasePart") then ha.Transparency = 0.5 end
        elseif v:IsA("LocalScript") or v:IsA("Script") then v:Destroy() end
    end
    local gh = invisGhost:FindFirstChild("Humanoid")
    invisGhostRoot = invisGhost:FindFirstChild("HumanoidRootPart")
    local cam = Workspace.CurrentCamera
    if gh and cam then cam.CameraSubject = gh end
    if gh then gh:SetStateEnabled(Enum.HumanoidStateType.Climbing, true) end
    h.PlatformStand = true
    r.CFrame = invisStaticPos
    for _,v in ch:GetDescendants() do if v:IsA("BasePart") then v.CanCollide = false end end
    invisActive = true
    setStatus("Invisible ON")
    invisLoop = RunService.Heartbeat:Connect(function(dt)
        local lim = Workspace.FallenPartsDestroyHeight + 35
        if invisGhost and invisGhost.Parent == Workspace and gh and gh.Health > 0 and invisGhostRoot and invisGhostRoot.Position.Y > lim and h and h.Health > 0 then
            if cam and cam.CameraSubject ~= gh then cam.CameraSubject = gh end
            local cs = gh:GetState()
            if cs ~= Enum.HumanoidStateType.Climbing then
                invisLastSafeCFrame = invisGhostRoot.CFrame
                if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then
                    local look = cam.CFrame.LookVector
                    local tr = CFrame.lookAt(invisGhostRoot.Position, invisGhostRoot.Position + Vector3.new(look.X, 0, look.Z))
                    invisGhostRoot.CFrame = invisGhostRoot.CFrame:Lerp(tr, math.clamp(dt * 25, 0, 1))
                end
            end
            gh:Move(h.MoveDirection, false)
            gh.Jump = h.Jump
            r.CFrame = invisStaticPos
            local gv = invisGhostRoot.AssemblyLinearVelocity
            if gv.Magnitude > 120 then gv = gv.Unit * 120 end
            r.AssemblyLinearVelocity = gv
            r.AssemblyAngularVelocity = invisGhostRoot.AssemblyAngularVelocity
        else
            invisStop()
            state.invisibleEnabled = false
            updateAllToggleVisuals("invisibleEnabled")
        end
    end)
end

