addSect(pages[SECRET_NAME], "Radio Abuse", 100)
do
    local function findPlaySong()
        local paths = {
            {"Remotes", "Inventory", "PlaySong"},
            {"Remotes", "PlaySong"},
            {"Remotes", "Gameplay", "PlaySong"},
            {"Remotes", "Radio", "PlaySong"},
            {"Remotes", "Inventory", "PlaySound"},
            {"Remotes", "PlaySound"},
            {"PlaySong"},
        }
        for _, path in ipairs(paths) do
            local cur = ReplicatedStorage
            local ok = true
            for _, name in ipairs(path) do
                cur = cur and cur:FindFirstChild(name)
                if not cur then ok = false; break end
            end
            if ok and cur and (cur:IsA("RemoteEvent") or cur:IsA("RemoteFunction")) then return cur end
        end
        return ReplicatedStorage:FindFirstChild("PlaySong", true)
    end
    local PlaySong = findPlaySong()
    task.spawn(function()
        while true do
            task.wait(2)
            if not PlaySong or not PlaySong.Parent then PlaySong = findPlaySong() end
        end
    end)

    local songFile = "AW_RadioSongs.json"
    local savedSongs = {}
    if isfile and isfile(songFile) and readfile then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(songFile)) end)
        if ok and type(data) == "table" then savedSongs = data end
    end
    local function saveSongs()
        if writefile then pcall(function() writefile(songFile, HttpService:JSONEncode(savedSongs)) end) end
    end
    local function firePlaySong(rawId, tryAllFormats)
        if not PlaySong or not PlaySong.Parent then PlaySong = findPlaySong() end
        if not PlaySong then _G.__AW_NOTIFY("PlaySong remote not found") return false end
        local idNum = tonumber(tostring(rawId or ""):match("%d+"))
        if not idNum then _G.__AW_NOTIFY("Invalid audio ID") return false end
        local formats = { idNum }
        if tryAllFormats then
            table.insert(formats, "rbxassetid://" .. idNum)
            table.insert(formats, "https://www.roblox.com/asset/?id=" .. idNum)
        end
        for i, arg in ipairs(formats) do
            pcall(function()
                if PlaySong:IsA("RemoteEvent") then PlaySong:FireServer(arg)
                elseif PlaySong:IsA("RemoteFunction") then PlaySong:InvokeServer(arg) end
            end)
            if i < #formats then task.wait(0.08) end
        end
        return true
    end
    local songInput = makeInput(pages[SECRET_NAME], 101, "Audio ID...", "", function() end)
    addBtn(pages[SECRET_NAME], "Add Audio ID", 102, function()
        local id = tostring(songInput.Text or ""):match("%d+")
        if not id then _G.__AW_NOTIFY("Invalid audio ID") return end
        local name = id
        pcall(function()
            local info = game:GetService("MarketplaceService"):GetProductInfo(tonumber(id))
            if info and info.Name then name = info.Name end
        end)
        for _, s in ipairs(savedSongs) do if tostring(s.id) == id then _G.__AW_NOTIFY("Already added") return end end
        table.insert(savedSongs, {name = name, id = id})
        saveSongs()
        state.radioSelectedSongId = id
        saveSettings()
        _G.__AW_NOTIFY("Added: " .. name)
    end)
    addBtn(pages[SECRET_NAME], "Play Last Added Audio", 103, function()
