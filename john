local shotCD=0.4
local lastShot=-shotCD
local function canFire() return tick()-lastShot>=shotCD end
local function getGun()
local ch=LP.Character
local bp=LP:FindFirstChild("Backpack")
for _,n in ipairs({"Gun","Revolver","Pistol"}) do
if ch and ch:FindFirstChild(n) then return ch[n] end
if bp and bp:FindFirstChild(n) then return bp[n] end
end
end
local function shootRemote()
local g=getGun()
if g then
local s=g:FindFirstChild("Shoot",true)
if s and (s:IsA("RemoteEvent") or s:IsA("RemoteFunction")) then return s end
end
for _,path in ipairs({{RS,"Remotes","Gameplay","GunHit"},{RS,"Remotes","Gameplay","ShootGun"},{RS,"Remotes","ShootGun"},{RS,"ShootGun"}}) do
local c=path[1]; local ok=true
for i=2,#path do c=c and c:FindFirstChild(path[i]); if not c then ok=false break end end
if ok and c and (c:IsA("RemoteEvent") or c:IsA("RemoteFunction")) then return c end
end
end
local function clearShot(tp)
if not state.silentAimWall or not tp then return true end
local cam=W.CurrentCamera
if not cam then return true end
local rp=RaycastParams.new()
local ig={}
if LP.Character then table.insert(ig,LP.Character) end
if tp.Parent then table.insert(ig,tp.Parent) end
rp.FilterDescendantsInstances=ig
rp.FilterType=Enum.RaycastFilterType.Exclude
return W:Raycast(cam.CFrame.Position,tp.Position-cam.CFrame.Position,rp)==nil
end
local function silentShoot()
if not canFire() then return end
local m=murd(); if not m or not m.Character then return end
local part=m.Character:FindFirstChild("Head") or m.Character:FindFirstChild("HumanoidRootPart")
if not part then return end
if not state.shootWalls and not clearShot(part) then return end
lastShot=tick()
local r=shootRemote(); if not r then return end
local tcf=part.CFrame
local ocf=W.CurrentCamera and W.CurrentCamera.CFrame or tcf
pcall(function()
if r:IsA("RemoteEvent") then r:FireServer(ocf,tcf); r:FireServer(tcf)
else r:InvokeServer(ocf,tcf) end
end)
end
local function wallShoot()
if not canFire() then return end
local m=murd(); if not m or not m.Character then return end
local root=m.Character:FindFirstChild("HumanoidRootPart")
if not root then return end
local r=shootRemote(); if not r then return end
lastShot=tick()
local tcf=root.CFrame
pcall(function()
if r:IsA("RemoteEvent") then r:FireServer(CFrame.new(tcf.Position+Vector3.new(0,3,0)),tcf); r:FireServer(tcf)
else r:InvokeServer(CFrame.new(tcf.Position+Vector3.new(0,3,0)),tcf) end
end)
end
local function shootMur() if state.shootWalls then wallShoot() else silentShoot() end end

