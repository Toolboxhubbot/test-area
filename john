                elseif dragState.inputType == Enum.UserInputType.Touch then
                    if input.UserInputType ~= Enum.UserInputType.Touch then return end
                end
                local st = dragState
                dragState = nil
                if st.moved then
                    state.floatButtonPositions[def.id] = {
                        xScale = btn.Position.X.Scale, xOffset = btn.Position.X.Offset,
                        yScale = btn.Position.Y.Scale, yOffset = btn.Position.Y.Offset,
                    }
                    saveSettings()
                    return
                end
                if def.type == "toggle" then
                    local ns = not state[def.key]
                    state[def.key] = ns
                    if syncToggleUI then syncToggleUI(def.key, ns) end
                    local dn = toggleDisplayNames[def.key] or def.label
                    _G.__AW_NOTIFY('<font color="' .. (ns and "#7c5cff" or "#ff5577") .. '">' .. dn .. '</font> ' .. (ns and "on" or "off"))
