    elseif cmd == "untp" then
        state.loopTpMap=false; state.loopTpLobby=false; state.loopTpMurderer=false
        state.loopTpSheriff=false; state.loopTpCustom=false
        saveSettings()
        _G.__AW_NOTIFY("Loop teleports off")
    elseif cmd == "unsheriff" then turnOff("sheriffFlickToggle","Sheriff Flick")

    -- normal commands
    elseif cmd == "help" or cmd == "h" or cmd == "?" then
        if not privateChatFrame.Visible then privateChatFrame.Visible = true end
        setPcTab("cmds")
    elseif cmd == "showui" then
        if _G.__AW_SHOWUI then _G.__AW_SHOWUI() end
    elseif cmd == "hideui" then
        if _G.__AW_HIDEUI then _G.__AW_HIDEUI() end
    elseif cmd == "private" or cmd == "pc" then
        privateChatFrame.Visible = not privateChatFrame.Visible
    elseif cmd == "unload" then
        _G.__AW_NOTIFY("Unloading...")
        task.wait(0.3)
        if _G.ApplewareUnload then pcall(function() _G.ApplewareUnload() end) end
    elseif cmd == "fly" then toggle("flyEnabled","Fly")
