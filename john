        else
            RunService:Set3dRenderingEnabled(true)
            if blackScreen then blackScreen.Visible = false end
            UserGameSettings.SavedQualityLevel = Enum.SavedQualityLevel.Level10
            Lighting.GlobalShadows = true
        end
