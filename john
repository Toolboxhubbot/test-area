    invisActive = false
    local ch = LP.Character
    local r = ch and ch:FindFirstChild("HumanoidRootPart")
    local h = ch and ch:FindFirstChildOfClass("Humanoid")
    if r and invisLastSafeCF then
        r.CFrame = invisLastSafeCF
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
    if h then
        local cam = Workspace.CurrentCamera
        if cam then cam.CameraSubject = h end
        h.PlatformStand = false
        h.AutoRotate = true
        pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
    if invisGhost then invisGhost:Destroy(); invisGhost = nil end
    if invisLoop then invisLoop:Disconnect(); invisLoop = nil end
end
local function invisStart()
    if invisActive then return end
    local ch = LP.Character
    if not ch then return end
    local r = ch:FindFirstChild("HumanoidRootPart")
    local h = ch:FindFirstChildOfClass("Humanoid")
    if not r or not h or h.Health <= 0 then return end
    invisStaticPos = CFrame.new(0, Workspace.FallenPartsDestroyHeight + 100, 0)
    invisLastSafeCF = r.CFrame
    ch.Archivable = true
    invisGhost = ch:Clone()
    invisGhost.Parent = Workspace
    ch.Archivable = false
    for _, v in invisGhost:GetDescendants() do
        if v:IsA("BasePart") then
            v.Transparency = 0.5
        elseif v:IsA("LocalScript") or v:IsA("Script") then
            v:Destroy()
        end
    end
    local gh = invisGhost:FindFirstChild("Humanoid")
    local ghostRoot = invisGhost:FindFirstChild("HumanoidRootPart")
    local cam = Workspace.CurrentCamera
    if gh and cam then cam.CameraSubject = gh end
    h.PlatformStand = true
    r.CFrame = invisStaticPos
    for _, v in ch:GetDescendants() do
        if v:IsA("BasePart") then v.CanCollide = false end
    end
    invisActive = true
    invisLoop = RunService.Heartbeat:Connect(function()
        local lim = Workspace.FallenPartsDestroyHeight + 35
        if invisGhost and invisGhost.Parent == Workspace and gh and gh.Health > 0
           and ghostRoot and ghostRoot.Position.Y > lim and h and h.Health > 0 then
            invisLastSafeCF = ghostRoot.CFrame
            gh:Move(h.MoveDirection, false)
            gh.Jump = h.Jump
            r.CFrame = invisStaticPos
            local gv = ghostRoot.AssemblyLinearVelocity
            if gv.Magnitude > 120 then gv = gv.Unit * 120 end
            r.AssemblyLinearVelocity = gv
        else
            invisStop()
            state.invisibleEnabled = false
            updateViz("invisibleEnabled")
        end
    end)
end
