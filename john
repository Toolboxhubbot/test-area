local touchFlingCooldown = 0
local TOUCH_FLING_RANGE = 12
local TOUCH_FLING_COOLDOWN = 0.25

local function getTouchParts(char)
    local list = {}
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            table.insert(list, p)
        end
    end
    return list
end

local function doWalkFling(myChar, tChar)
    local myParts = getTouchParts(myChar)
    local tParts = getTouchParts(tChar)
    if #myParts == 0 or #tParts == 0 then return end

    for _, mp in ipairs(myParts) do
        for _, tp in ipairs(tParts) do
            pcall(firetouchinterest, mp, tp, 0)
        end
    end
    task.wait()

    for _, mp in ipairs(myParts) do
        for _, tp in ipairs(tParts) do
            pcall(firetouchinterest, mp, tp, 1)
        end
    end
    task.wait()

    for _, tp in ipairs(tParts) do
        for _, mp in ipairs(myParts) do
            pcall(firetouchinterest, tp, mp, 0)
        end
    end
    task.wait()

    for _, tp in ipairs(tParts) do
        for _, mp in ipairs(myParts) do
            pcall(firetouchinterest, tp, mp, 1)
        end
    end
end

