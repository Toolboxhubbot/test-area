local function getPartJointWorldPos(part, motorMap)
    if not part or not part:IsA("BasePart") then return nil end
    local motorName = motorMap[part.Name]
    if motorName then
        local m = part:FindFirstChild(motorName)
        if m and m:IsA("Motor6D") then
            local ok, pos = pcall(function() return (part.CFrame * m.C1).Position end)
            if ok and pos then return pos end
        end
    end
    return part.Position
end

local function getSkeletonPairs(ch)
    if ch:FindFirstChild("UpperTorso") then return SKELETON_PAIRS_R15, MOTOR_MAP_R15 end
    if ch:FindFirstChild("Torso") then return SKELETON_PAIRS_R6, MOTOR_MAP_R6 end
    return nil, nil
end

