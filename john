local RELAY_URL = state.privateChatRelayUrl or "https://api.npoint.io/795defab3ba6f023d5bc"

local function httpGetJson(url)
    local ok, res = pcall(function()
        if syn and syn.request then
            return syn.request({Url=url, Method="GET"})
        elseif request then
            return request({Url=url, Method="GET"})
        elseif http_request then
            return http_request({Url=url, Method="GET"})
        else
            return {Body = game:HttpGet(url)}
        end
    end)
    if not ok or not res then return nil end
    local body = type(res) == "table" and (res.Body or res.body) or res
    if type(body) ~= "string" or body == "" then return nil end
    local parseOk, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not parseOk or type(data) ~= "table" then return nil end
    return data
end

local function httpPostJson(url, tbl)
    local body = HttpService:JSONEncode(tbl)
    local ok, res = pcall(function()
        if syn and syn.request then
            return syn.request({Url=url, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        elseif request then
            return request({Url=url, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        elseif http_request then
            return http_request({Url=url, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        else
            return {Body = game:HttpGet(url, true, body)}
        end
    end)
    return ok, res
end

local function sendToRelay(name, message)
    task.spawn(function()
        task.wait(math.random() * 0.5)
        local data = httpGetJson(RELAY_URL) or {}
        local msgs = data.messages
        if type(msgs) ~= "table" then msgs = {} end
        local entry = {
            id = tostring(tick()) .. "_" .. tostring(math.random(100000, 999999)),
            name = tostring(name),
            message = tostring(message),
            ts = os.time()
        }
        table.insert(msgs, entry)
        while #msgs > 200 do table.remove(msgs, 1) end
        local ok = httpPostJson(RELAY_URL, {messages = msgs})
        if ok then
            pcStatus.Text = "Sent " .. os.date("%H:%M:%S")
        else
            pcStatus.Text = "Send failed"
        end
    end)
end

task.spawn(function()
    while true do
        task.wait(3)
        local data = httpGetJson(RELAY_URL)
        if data and type(data.messages) == "table" then
            for _, entry in ipairs(data.messages) do
                if type(entry) == "table" and entry.id and entry.name and entry.message then
                    local id = tostring(entry.id)
                    if not seenMsgIds[id] and entry.name ~= LP.Name then
                        addPrivateMessage(entry.name, entry.message, false, id)
                    elseif not seenMsgIds[id] and entry.name == LP.Name then
                        seenMsgIds[id] = true
                    end
                end
            end
            pcStatus.Text = "Synced " .. os.date("%H:%M:%S")
        end
    end
end)

