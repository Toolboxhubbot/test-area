local function reliableFling(tp, forceManual)
    if not tp or tp == LP or not tp.Parent then return false end
    if not targetIsAlive(tp) then return false end
    if activeResets[tp.UserId] then return false end
    if isWhitelisted(tp) then return false end
    if not forceManual then
        local autoAllowed = state.loopFlingAll or state.loopFlingMur
            or state.loopFlingSheriff or state.loopFlingCustom
            or state.autoFlingMur or state.autoFlingSheriff or state.flingAura
        if not autoAllowed then return false end
    end
    local Character = LP.Character
    if not Character then return false end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart
    local TCharacter = tp.Character
    if not (Character and Humanoid and RootPart and TCharacter) then return false end
    local TRootPart = TCharacter:FindFirstChild("HumanoidRootPart")
    local THead = TCharacter:FindFirstChild("Head")
    if not TRootPart then return false end
    local savedData = { cframe = RootPart.CFrame }
    Humanoid.PlatformStand = true
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(0, -50000, 0)
    bv.Parent = RootPart
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 1000000
    bg.CFrame = RootPart.CFrame
    bg.Parent = RootPart
    local originalDestroyHeight = Workspace.FallenPartsDestroyHeight
    Workspace.FallenPartsDestroyHeight = -100000
    local startTime = tick()
    activeResets[tp.UserId] = {active = true}
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if tick() - startTime > RESET_DURATION
           or not tp.Character
           or not TRootPart.Parent
           or not Character.Parent then
            Workspace.FallenPartsDestroyHeight = originalDestroyHeight
            if bv.Parent then bv:Destroy() end
            if bg.Parent then bg:Destroy() end
            Humanoid.PlatformStand = false
            for _, t in ipairs(Humanoid:GetPlayingAnimationTracks()) do t:Stop() end
            RootPart.AssemblyLinearVelocity = Vector3.zero
            RootPart.AssemblyAngularVelocity = Vector3.zero
            RootPart.CFrame = savedData.cframe
            pcall(function() Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            for _, part in ipairs(Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
            if conn then conn:Disconnect() end
            activeResets[tp.UserId] = nil
            return
        end
        if TRootPart and TRootPart.Parent and RootPart and RootPart.Parent then
            local topPos = THead
                and (THead.Position + Vector3.new(0, RESET_START_STUDS, 0))
                or  (TRootPart.Position + Vector3.new(0, RESET_START_STUDS + 0.5, 0))
            local lowestY = TRootPart.Position.Y - 3
            for _, part in ipairs(TCharacter:GetDescendants()) do
                if part:IsA("BasePart") then
                    local pY = part.Position.Y - (part.Size.Y / 2)
                    if pY < lowestY and pY > (TRootPart.Position.Y - 6) then
                        lowestY = pY
                    end
                end
            end
            local bottomPos = Vector3.new(TRootPart.Position.X, lowestY - 0.5, TRootPart.Position.Z)
            local alpha = math.clamp((tick() - startTime) / RESET_DURATION, 0, 1)
            local sweepPos = topPos:Lerp(bottomPos, alpha)
            RootPart.CFrame = CFrame.new(sweepPos) * CFrame.Angles(math.pi / 2, 0, 0)
            RootPart.AssemblyLinearVelocity = Vector3.new(0, -50000, 0)
            RootPart.AssemblyAngularVelocity = Vector3.new(7500, 7500, 7500)
            local dir = (TRootPart.Position - RootPart.Position)
            if dir.Magnitude > 0.01 then
                bv.Velocity = dir.Unit * 50000
            end
            bg.CFrame = RootPart.CFrame
        end
    end)
    local to = tick() + RESET_DURATION + 1.5
    while activeResets[tp.UserId] and tick() < to do task.wait(0.05) end
    return true
end

local function safePointAt(p)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    if LP.Character then rp.FilterDescendantsInstances = {LP.Character} end
    local hit = Workspace:Raycast(p + Vector3.new(0, 200, 0), Vector3.new(0, -400, 0), rp)
    if hit then return hit.Position + Vector3.new(0, 4, 0) end
    return p + Vector3.new(0, 4, 0)
end

local function findMapCoord()
    for _, m in ipairs(Workspace:GetChildren()) do
        local cc = m:FindFirstChild("CoinContainer") or (m.Name == "CoinContainer" and m)
        if cc then
            local mn = string.lower(m.Name):gsub("%s+", "")
            for _, entry in ipairs(MAP_COORDS) do
