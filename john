UIS.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if listeningFor then
        state.keybinds[listeningFor] = input.KeyCode.Name
        local lbl = kbKeyLabels[listeningFor]
        if lbl then lbl.Text = string.upper(input.KeyCode.Name) end
        listeningFor = nil
        resetAllSetButtons()
        saveSettings()
        _G.__AW_NOTIFY("Keybind set to " .. string.upper(input.KeyCode.Name))
        return
    end
    if gameProcessed then return end
    if UIS:GetFocusedTextBox() then return end
    for feature, keyName in pairs(state.keybinds) do
        if keyName and keyName ~= "" and input.KeyCode.Name == keyName then
            if state[feature] ~= nil and type(state[feature]) == "boolean" then
                local ns = not state[feature]
                state[feature] = ns
                local dn = toggleDisplayNames[feature] or feature
                _G.__AW_NOTIFY(dn .. " " .. (ns and "on" or "off"))
                saveSettings()
                break
            end
        end
    end
end)

