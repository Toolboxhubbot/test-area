_G.__AW_RUN_COMMAND = function(raw)
    if not raw or raw == "" then return end
    local args = {}
    for w in string.gmatch(raw, "%S+") do table.insert(args, w) end
    local cmd = string.lower(args[1] or ""):gsub("^%.", "")
    local function arg(i) return args[i] end
    local function num(i, def) local n = tonumber(args[i]); return n or def end
    local function toggle(key, label)
        state[key] = not state[key]
        _G.__AW_NOTIFY('<font color="'..(state[key] and "#5aff8c" or "#ff5a5a")..'">'..(label or key)..'</font> '..(state[key] and "on" or "off"))
        saveSettings()
    end
    local function turnOff(key, label)
        if state[key] == true then
            state[key] = false
            if FBM[key] then RFV(FBM[key]) end
            if key == "flyEnabled" then stopFly() end
            if key == "voidPlatform" then RVP() end
            _G.__AW_NOTIFY('<font color="#ff5a5a">'..(label or key)..' off</font>')
            saveSettings()
        else
