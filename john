local function attachBounce(b)
    if state.animationsEnabled == false then return end
    local s = Instance.new("UIScale", b)
    b.MouseButton1Down:Connect(function()
        TweenService:Create(s, TweenInfo.new(0.08, EASE_SMOOTH, EASE_OUT), {Scale=0.95}):Play()
    end)
    local function r()
        TweenService:Create(s, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, EASE_OUT), {Scale=1}):Play()
    end
    b.MouseButton1Up:Connect(r)
    b.MouseLeave:Connect(r)
end

local function attachRipple(b, c)
    if state.animationsEnabled == false then return end
    c = c or Color3.new(1,1,1)
    b.ClipsDescendants = true
    b.MouseButton1Down:Connect(function()
        local pos = b.AbsolutePosition
        local sz = b.AbsoluteSize
        local m = UIS:GetMouseLocation()
        local relX = m.X - pos.X
        local relY = m.Y - pos.Y
        local f = Instance.new("Frame", b)
        f.AnchorPoint = Vector2.new(0.5,0.5)
        f.Position = UDim2.new(0, relX, 0, relY)
        f.Size = UDim2.new(0,0,0,0)
        f.BackgroundColor3 = c
        f.BackgroundTransparency = 0.45
        f.BorderSizePixel = 0
        f.ZIndex = (b.ZIndex or 1)+5
        f.Active = false
        corner(f, 9999)
        local maxR = math.max(sz.X - relX, relX, sz.Y - relY, relY) * 2.4
        TweenService:Create(f, TweenInfo.new(0.8, EASE_SMOOTH, EASE_OUT),
            {Size=UDim2.new(0,maxR*2,0,maxR*2), BackgroundTransparency=1}):Play()
        task.delay(0.9, function() if f and f.Parent then f:Destroy() end end)
    end)
end

local function attachShine(b)
    if state.animationsEnabled == false then return end
    b.ClipsDescendants = true
    local s = Instance.new("Frame", b)
    s.Size = UDim2.new(0,40,1.6,0)
    s.Position = UDim2.new(-0.4,0,-0.3,0)
    s.BackgroundColor3 = Color3.new(1,1,1)
    s.BackgroundTransparency = 0.85
    s.Rotation = 14
    s.BorderSizePixel = 0
    s.ZIndex = (b.ZIndex or 1)+2
    s.Active = false
    local running = false
    b.MouseEnter:Connect(function()
        if running then return end
        running = true
        s.Position = UDim2.new(-0.4,0,-0.3,0)
        TweenService:Create(s, TweenInfo.new(0.75, EASE_SMOOTH, EASE_OUT),
            {Position=UDim2.new(1.4,0,-0.3,0)}):Play()
        task.delay(0.8, function() running = false end)
    end)
end

local function staggerFade(p)
    if state.animationsEnabled == false then return end
    local ch = {}
    for _, c in ipairs(p:GetChildren()) do
        if c:IsA("GuiObject") and c.Visible ~= false and not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
            table.insert(ch, c)
        end
    end
    for i, c in ipairs(ch) do
        local sb = c.BackgroundTransparency
        local stt = nil
        if c:IsA("TextLabel") or c:IsA("TextButton") or c:IsA("TextBox") then
            stt = c.TextTransparency; c.TextTransparency = 1
        end
        if c:IsA("Frame") or c:IsA("TextButton") then
            c.BackgroundTransparency = 1
        end
        local origPos = c.Position
        c.Position = origPos + UDim2.new(0, 14, 0, 0)
        task.delay(i * 0.018, function()
            if not c.Parent then return end
            if c:IsA("Frame") or c:IsA("TextButton") then
                TweenService:Create(c, TweenInfo.new(0.5, EASE_BOUNCE, EASE_OUT),
                    {BackgroundTransparency=sb, Position=origPos}):Play()
            end
            if stt then
                TweenService:Create(c, TweenInfo.new(0.4, EASE_SOFT), {TextTransparency=stt}):Play()
            end
        end)
    end
end

