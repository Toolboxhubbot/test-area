function refreshPlayerList()
    for _, c in ipairs(playerListScroll:GetChildren()) do
        if c:IsA("GuiObject") and c ~= plsLayout then c:Destroy() end
    end
    local sorted = {}
    for _, p in ipairs(Players:GetPlayers()) do if p ~= LP then table.insert(sorted, p) end end
    table.sort(sorted, function(a, b) return string.lower(a.Name) < string.lower(b.Name) end)
    if #sorted == 0 then
        local lbl = Instance.new("TextLabel", playerListScroll)
        lbl.Size = UDim2.new(1, -12, 0, 26); lbl.LayoutOrder = 1
        lbl.BackgroundTransparency = 1; lbl.Text = "(no other players)"
        lbl.TextColor3 = cc3(settingsConfig.tabTextColor)
        lbl.Font = Enum.Font.Gotham; lbl.TextSize = 11
        return
    end
    for i, p in ipairs(sorted) do buildPlayerRow(playerListScroll, p, i) end
end
