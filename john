stopFarm = function()
    cancelFarmTween()
    local ch = LP.Character
    if not ch then return end
    local h = ch:FindFirstChildOfClass("Humanoid")
    local r = ch:FindFirstChild("HumanoidRootPart")
    if r then
        r.Anchored = false
        for _, v in ipairs(ch:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = true end
        end
        r.CFrame = LOBBY_CFRAME
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end
    if h and h.Health > 0 then
        for _, t in ipairs(h:GetPlayingAnimationTracks()) do
            pcall(function() t:Stop() end)
        end
        h.PlatformStand = false
        h.Sit = false
        h.AutoRotate = true
        h.WalkSpeed = state.speedEnabled and (state.speedValue or 16) or 16
        h.UseJumpPower = state.jumpEnabled and true or false
        h.JumpPower = state.jumpEnabled and (state.jumpValue or 50) or 50
        pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        task.wait(0.1)
        if h.Parent and h.Health > 0 then
            pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end)
        end
        local cam = Workspace.CurrentCamera
        if cam and cam.CameraSubject ~= h then
            cam.CameraSubject = h
        end
    end
    setStatus("Farm stopped - returned to lobby")
end

