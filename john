killSheriffNow = function()
    task.spawn(function()
        if not alive() then return end
        killedSheriffIds = {}
        killedSheriffChars = {}
        standUp()
        task.wait(0.15)
        refreshRoleCache()
        if not (findTool("Knife") or equipTool("Knife")) then
            for _ = 1, 10 do task.wait(0.1); if equipTool("Knife") then break end end
        end
        if not findTool("Knife") then
            notify('<font color="#ff5a5a">No Knife — must be Murderer</font>')
            return
        end
        task.wait(0.2)
        local killed = 0
        for _ = 1, 8 do
            refreshRoleCache()
            local live = getLiveSheriffHeroes()
            if #live == 0 then break end
            local target = live[1]
            local targetChar = target.Character
            executeKillBehind(target)
            killedSheriffIds[target.UserId] = true
            if targetChar then killedSheriffChars[targetChar] = true end
            killed = killed + 1
            task.wait(0.4)
        end
        if killed == 0 then
            notify('<font color="#ff5a5a">No Sheriff found this round</font>')
        end
    end)
end

