-- ============ INVISIBILITY ============
local INVIS_POS=Vector3.new(-25.95,84,3537.55)
local invisSeat,invisWeld=nil,nil
local dodgeActive=false
local function setTrans(char,t)
    if not char then return end
    for _,d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Decal") then pcall(function() d.Transparency=t end) end
    end
end
local function cleanupInvis()
    if invisWeld and invisWeld.Parent then pcall(function() invisWeld:Destroy() end) end
    if invisSeat and invisSeat.Parent then pcall(function() invisSeat:Destroy() end) end
    invisWeld=nil; invisSeat=nil
    local ex=Workspace:FindFirstChild("invischair")
    if ex then pcall(function() ex:Destroy() end) end
end
local function enableInvis()
    local char=LP.Character; if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health<=0 then return end
    local sc=hrp.CFrame
    hrp.CFrame=CFrame.new(INVIS_POS)
    task.wait(0.15)
    cleanupInvis()
    local seat=Instance.new("Seat")
    seat.Name="invischair"
    seat.Anchored=false
    seat.CanCollide=false
    seat.Transparency=1
    seat.Size=Vector3.new(2,1,1)
    seat.CFrame=CFrame.new(INVIS_POS)
    seat.Parent=Workspace
    local w=Instance.new("Weld")
    w.Part0=seat; w.Part1=hrp; w.Parent=seat
    invisSeat=seat; invisWeld=w
    task.wait(0.1)
    seat.CFrame=sc
    task.wait(0.1)
    setTrans(char,0.5)
end
local function disableInvis()
    cleanupInvis()
    if LP.Character then setTrans(LP.Character,0) end
end
local invisApplied=false
task.spawn(function()
    while true do
        task.wait(0.1)
        local want=false
        if alive() and (state.invisibleEnabled or dodgeActive) and not isLocalFlinging then want=true end
        if want and not invisApplied then invisApplied=true; pcall(enableInvis)
        elseif not want and invisApplied then invisApplied=false; pcall(disableInvis) end
        if invisApplied and LP.Character then
            local ch=LP.Character
            local h=ch:FindFirstChildOfClass("Humanoid")
            if h and h.Health>0 then
                for _,d in ipairs(ch:GetDescendants()) do
                    if (d:IsA("BasePart") or d:IsA("Decal")) and math.abs((d.Transparency or 0)-0.5)>0.01 then
                        pcall(function() d.Transparency=0.5 end)
                    end
                end
            end
        end
    end
end)
