            task.delay(0.24,function() if not open then list.Visible=false end end)
        end
    end
    for i,opt in ipairs(options) do
        local ob=Instance.new("TextButton",list)
        ob.Size=UDim2.new(1,0,0,OPT_H)
        ob.LayoutOrder=i
        ob.BackgroundColor3=cc3(settingsConfig.cardHoverColor)
