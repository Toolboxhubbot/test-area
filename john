local fpsBoostMaid = nil
applyFpsBoost = function(enabled)
    pcall(function()
        if enabled then
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") or v:IsA("Sky") or v:IsA("Atmosphere") then v.Enabled = false end
            end
            pcall(function()
                Workspace.Terrain.WaterWaveSize = 0
                Workspace.Terrain.WaterTransparency = 0
                Workspace.Terrain.WaterReflectance = 0
                Workspace.Terrain.Decoration = false
            end)
            local function potatoPart(v)
                if v:IsA("BasePart") then v.CastShadow = false; v.Material = Enum.Material.SmoothPlastic; v.Reflectance = 0
                elseif v:IsA("Decal") or v:IsA("Texture") then v.Transparency = 1
                elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then v.Enabled = false
                elseif v:IsA("SpecialMesh") then v.TextureId = ""
                elseif v:IsA("MeshPart") then v.TextureID = ""; v.Material = Enum.Material.SmoothPlastic; v.CastShadow = false end
            end
            for _, v in ipairs(Workspace:GetDescendants()) do potatoPart(v) end
            if not fpsBoostMaid then
                fpsBoostMaid = Workspace.DescendantAdded:Connect(function(v) if state.fpsBoost then potatoPart(v) end end)
            end
            collectgarbage("collect")
        else
            Lighting.GlobalShadows = true
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") or v:IsA("Sky") or v:IsA("Atmosphere") then v.Enabled = true end
            end
            if fpsBoostMaid then fpsBoostMaid:Disconnect() fpsBoostMaid = nil end
            pcall(function() Workspace.Terrain.Decoration = true end)
            for _, v in ipairs(Workspace:GetDescendants()) do
                if v:IsA("BasePart") then v.CastShadow = true
                elseif v:IsA("Decal") or v:IsA("Texture") then v.Transparency = 0 end
            end
        end
    end)
end

