        crossSpinAccum = crossSpinAccum + dt * (state.crosshairSpinSpeed or 90) * (state.crosshairSpinDirection or 1)
        if crossSpinAccum >= 360 then crossSpinAccum = crossSpinAccum - 360 end
        if crossSpinAccum < 0 then crossSpinAccum = crossSpinAccum + 360 end
        crossSpinHolder.Rotation = crossSpinAccum
    elseif not state.crosshairSpin and crossSpinHolder.Rotation ~= 0 then
        crossSpinHolder.Rotation = 0
        crossSpinAccum = 0
    end
end)

