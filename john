local flyBV,flyBG,flyConn,flyUpHold=nil,nil,nil,false
local function startFly()
    local char=LP.Character; if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    hum.PlatformStand=true
    if not flyBV or not flyBV.Parent then
        flyBV=Instance.new("BodyVelocity")
        flyBV.MaxForce=Vector3.new(9e9,9e9,9e9)
        flyBV.P=10000
        flyBV.Velocity=Vector3.zero
        flyBV.Parent=hrp
    end
    if not flyBG or not flyBG.Parent then
        flyBG=Instance.new("BodyGyro")
        flyBG.P=9e4
        flyBG.MaxTorque=Vector3.new(9e9,9e9,9e9)
        flyBG.CFrame=hrp.CFrame
        flyBG.Parent=hrp
    end
    if flyConn then flyConn:Disconnect() end
    flyConn=RunService.RenderStepped:Connect(function()
        local ch=LP.Character; if not ch then return end
        local root=ch:FindFirstChild("HumanoidRootPart")
        local h=ch:FindFirstChildOfClass("Humanoid")
        if not root or not h then return end
        if not flyBV or not flyBV.Parent or not flyBG or not flyBG.Parent then return end
        local cam=Workspace.CurrentCamera; if not cam then return end
        local camCF=cam.CFrame
        local moveVec=Vector3.zero
        local md=h.MoveDirection
        if md.Magnitude>0.01 then
            local fl=Vector3.new(camCF.LookVector.X,0,camCF.LookVector.Z)
            local fr=Vector3.new(camCF.RightVector.X,0,camCF.RightVector.Z)
            if fl.Magnitude>0.01 then fl=fl.Unit end
            if fr.Magnitude>0.01 then fr=fr.Unit end
            local fm=Vector3.new(md.X,0,md.Z)
            if fm.Magnitude>0.01 then fm=fm.Unit end
            local f=0; local r=0
            if fl.Magnitude>0.01 then f=fm:Dot(fl) end
            if fr.Magnitude>0.01 then r=fm:Dot(fr) end
            if f~=0 then moveVec=moveVec+camCF.LookVector*f end
            if r~=0 then moveVec=moveVec+camCF.RightVector*r end
        end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then moveVec=moveVec+camCF.UpVector end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveVec=moveVec-camCF.UpVector end
        if flyUpHold then moveVec=moveVec+camCF.UpVector end
        local speed=state.flySpeed or 50
        if moveVec.Magnitude>0 then flyBV.Velocity=moveVec.Unit*speed else flyBV.Velocity=Vector3.zero end
        flyBG.CFrame=camCF
    end)
end
local function stopFly()
    if flyConn then flyConn:Disconnect(); flyConn=nil end
    if flyBV and flyBV.Parent then flyBV:Destroy() end
    if flyBG and flyBG.Parent then flyBG:Destroy() end
    flyBV=nil; flyBG=nil
    local char=LP.Character
    if char then
        local hum=char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand=false; hum.AutoRotate=true; hum.WalkSpeed=(state.speedEnabled and (state.speedValue or 16)) or 16 end
        local root=char:FindFirstChild("HumanoidRootPart")
        if root then root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero end
    end
end
local flyWas=false
task.spawn(function()
    while true do
        task.wait(0.1)
        if state.flyEnabled~=flyWas then
            flyWas=state.flyEnabled
            if state.flyEnabled then startFly() else stopFly() end
        end
        if state.flyEnabled and (not flyBV or not flyBV.Parent or not flyBG or not flyBG.Parent) then startFly() end
    end
end)
UIS.JumpRequest:Connect(function()
    if state.flyEnabled then flyUpHold=true; task.delay(0.15,function() flyUpHold=false end) end
end)
