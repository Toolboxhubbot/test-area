local function predictImpact(targetPos, targetVel, camPos, projectileSpeed)
    if not projectileSpeed or projectileSpeed <= 0 then return targetPos end
    local t = 0
    for _ = 1, 5 do
        local futurePos = targetPos + targetVel * t
        local dist = (futurePos - camPos).Magnitude
        t = dist / projectileSpeed
    end
    return targetPos + targetVel * t
end

local stickyAimTarget = nil
local stickyAimUntil  = 0

local function pickBestAimTarget()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local vps = cam.ViewportSize
    local center = Vector2.new(vps.X * 0.5, vps.Y * 0.5)

    local candidates = {}
    if state.aimbotMurderer then
        local m = getMurd()
        if m then table.insert(candidates, m) end
    elseif state.aimbotSheriff then
        for _, s in ipairs(getLiveSheriffHeroes()) do table.insert(candidates, s) end
    end
    if #candidates == 0 then return nil end

    if state.aimbotSticky and stickyAimTarget and tick() < stickyAimUntil then
        for _, tp in ipairs(candidates) do
            if tp == stickyAimTarget and tp.Character then
                local hh = tp.Character:FindFirstChildOfClass("Humanoid")
                if hh and hh.Health > 0 then return stickyAimTarget end
            end
        end
    end

    local fovRadius = state.aimbotFOV or 250
    local best, bestScore = nil, -math.huge
    for _, tp in ipairs(candidates) do
        local ch = tp.Character
        if ch then
            local hh = ch:FindFirstChildOfClass("Humanoid")
            if hh and hh.Health > 0 then
                local tpartName = state.aimbotPart or "Head"
                local tpart = ch:FindFirstChild(tpartName)
                    or ch:FindFirstChild("Head")
                    or ch:FindFirstChild("HumanoidRootPart")
                if tpart then
                    local sp, onScreen = cam:WorldToViewportPoint(tpart.Position)
                    if onScreen and sp.Z > 0 then
                        local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if sd <= fovRadius then
                            local score = -sd
                            if score > bestScore then bestScore = score; best = tp end
                        end
                    end
                end
            end
        end
    end
    if best then
        stickyAimTarget = best
        stickyAimUntil = tick() + 0.5
    end
    return best
end

pcall(function() RunService:UnbindFromRenderStep("AW_AimbotLock") end)
RunService:BindToRenderStep("AW_AimbotLock", Enum.RenderPriority.Camera.Value + 1, function()
    if not alive() then stickyAimTarget = nil; return end
    if not (state.aimbotMurderer or state.aimbotSheriff) then stickyAimTarget = nil; return end

    local cam = Workspace.CurrentCamera
    if not cam then return end

    local tp = pickBestAimTarget()
    if not tp or not tp.Character then return end

    local h = tp.Character:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return end

    local tpartName = state.aimbotPart or "Head"
    local tpart = tp.Character:FindFirstChild(tpartName)
        or tp.Character:FindFirstChild("Head")
        or tp.Character:FindFirstChild("HumanoidRootPart")
    if not tpart then return end

    if state.aimbotVisCheck then
        local rp = RaycastParams.new()
        local ignores = {}
        if LP.Character then table.insert(ignores, LP.Character) end
        if tp.Character then table.insert(ignores, tp.Character) end
        rp.FilterDescendantsInstances = ignores
        rp.FilterType = Enum.RaycastFilterType.Exclude
        if Workspace:Raycast(cam.CFrame.Position, tpart.Position - cam.CFrame.Position, rp) then return end
    end

    local camPos = cam.CFrame.Position
    local targetPos = tpart.Position

    if state.aimbotPredict then
        local root = tp.Character:FindFirstChild("HumanoidRootPart")
        local vel = (root and root.AssemblyLinearVelocity) or tpart.AssemblyLinearVelocity
        if math.abs(vel.Y) < 5 then vel = Vector3.new(vel.X, 0, vel.Z) end
        targetPos = predictImpact(targetPos, vel, camPos, state.aimbotProjSpeed or 800)
    end

    if state.aimbotUseFOV ~= false then
        local sp, onScreen = cam:WorldToViewportPoint(targetPos)
        if not onScreen or sp.Z <= 0 then return end
        local vps = cam.ViewportSize
        local center = Vector2.new(vps.X * 0.5, vps.Y * 0.5)
        if (Vector2.new(sp.X, sp.Y) - center).Magnitude > (state.aimbotFOV or 250) then return end
    end

    local desired = CFrame.new(cam.CFrame.Position, targetPos)
    local smooth = state.aimbotSmooth or 1
    if smooth <= 1 then
        cam.CFrame = desired
    else
        local alpha = 1 - math.exp(-10 / math.max(1, smooth))
        cam.CFrame = cam.CFrame:Lerp(desired, alpha)
    end

    if state.aimbotAutoFire and lpHasGun() then
        local sp, onScreen = cam:WorldToViewportPoint(tpart.Position)
        if onScreen and sp.Z > 0 then
            local vps = cam.ViewportSize
            local delta = (Vector2.new(sp.X, sp.Y) - Vector2.new(vps.X * 0.5, vps.Y * 0.5)).Magnitude
            if delta < (state.aimbotAutoFireRange or 50) then
                local gun = findTool("Gun")
                if gun and gun.Parent == LP.Character then
                    pcall(function() gun:Activate() end)
                    pcall(function()
                        for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
                            if v:IsA("RemoteEvent") then
                                local n = string.lower(v.Name)
                                if n:find("gun") or n:find("shoot") or n:find("fire") then
                                    pcall(function() v:FireServer(tpart.Position, tp) end)
                                end
                            end
                        end
                    end)
                end
            end
        end
    end
end)

