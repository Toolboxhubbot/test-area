    local parts={}
    for _,p in ipairs(targets) do
        if p and p~=LP and targetIsAlive(p) and not isWhitelisted(p) then
            local pc=p.Character
            if pc then
                local tor=pc:FindFirstChild("UpperTorso") or pc:FindFirstChild("Torso") or pc:FindFirstChild("HumanoidRootPart")
                if tor then table.insert(parts,tor) end
            end
        end
    end
    if #parts==0 then _G.__AW_NOTIFY("No valid targets") return end
    task.spawn(function()
        for _=1,8 do
            for _,tor in ipairs(parts) do pcall(function() ht:FireServer(tor) end) end
            task.wait(0.08)
        end
    end)
end
