-- ============ AIMBOT ============
local currentAimTarget = nil

local function predictImpact(targetPos, targetVel, camPos, projSpeed)
    if not projSpeed or projSpeed <= 0 then return targetPos end
    local t = 0
    for _ = 1, 6 do
        local futurePos = targetPos + targetVel * t
        local dist = (futurePos - camPos).Magnitude
        t = dist / projSpeed
    end
    return targetPos + targetVel * t
end

RunService.RenderStepped:Connect(function(dt)
    if not alive() then return end
    if not (state.aimbotMurderer or state.aimbotSheriff) then
        currentAimTarget = nil
        return
    end

    local cam = Workspace.CurrentCamera
    if not cam then return end
    local vps = cam.ViewportSize
    local center = Vector2.new(vps.X * 0.5, vps.Y * 0.5)

    local candidates = {}
    if state.aimbotMurderer then
        local m = getMurd()
        if m then table.insert(candidates, m) end
    elseif state.aimbotSheriff then
        for _, s in ipairs(getLiveSheriffHeroes()) do table.insert(candidates, s) end
    end
    if #candidates == 0 then
        currentAimTarget = nil
        return
    end

    local fovR = state.aimbotFOV or 250
    local best, bestScore = nil, -math.huge

    if state.aimbotSticky and currentAimTarget then
        for _, tp in ipairs(candidates) do
            if tp == currentAimTarget and targetIsAlive(tp) then
                local tn = state.aimbotPart or "Head"
                local tpart = tp.Character:FindFirstChild(tn) or tp.Character:FindFirstChild("Head")
                if tpart then
                    local sp, onScreen = cam:WorldToViewportPoint(tpart.Position)
                    if onScreen and sp.Z > 0 then
                        local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if sd <= fovR * 1.3 then
                            best = tp
                            bestScore = -sd + 1000
                        end
                    end
                end
            end
        end
    end

    if not best then
        for _, tp in ipairs(candidates) do
            local ch = tp.Character
            if ch then
                local hh = ch:FindFirstChildOfClass("Humanoid")
                if hh and hh.Health > 0 then
                    local tn = state.aimbotPart or "Head"
                    local tpart = ch:FindFirstChild(tn) or ch:FindFirstChild("Head")
                    if tpart then
                        local sp, onScreen = cam:WorldToViewportPoint(tpart.Position)
                        if onScreen and sp.Z > 0 then
                            local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if sd <= fovR then
                                local score = -sd
                                if tpart.Name == "Head" then score = score + 50 end
                                if score > bestScore then bestScore = score; best = tp end
                            end
                        end
                    end
                end
            end
        end
    end

    local target = best
    if not target or not target.Character then
        currentAimTarget = nil
        return
    end
    currentAimTarget = target

    local hh = target.Character:FindFirstChildOfClass("Humanoid")
    if not hh or hh.Health <= 0 then return end
    local tn = state.aimbotPart or "Head"
    local tpart = target.Character:FindFirstChild(tn) or target.Character:FindFirstChild("Head")
        or target.Character:FindFirstChild("HumanoidRootPart")
    if not tpart then return end

    if state.aimbotVisCheck then
        local rp = RaycastParams.new()
        local ignores = {}
        if LP.Character then table.insert(ignores, LP.Character) end
        if target.Character then table.insert(ignores, target.Character) end
        rp.FilterDescendantsInstances = ignores
        rp.FilterType = Enum.RaycastFilterType.Exclude
        if Workspace:Raycast(cam.CFrame.Position, tpart.Position - cam.CFrame.Position, rp) then return end
    end

    local camPos = cam.CFrame.Position
    local targetPos = tpart.Position
    if state.aimbotPredict then
        local root = target.Character:FindFirstChild("HumanoidRootPart")
        local vel = (root and root.AssemblyLinearVelocity) or tpart.AssemblyLinearVelocity
        if math.abs(vel.Y) < 5 then vel = Vector3.new(vel.X, 0, vel.Z) end
        targetPos = predictImpact(targetPos, vel, camPos, state.aimbotProjSpeed or 800)
    end

    if state.aimbotUseFOV ~= false then
        local sp, onScreen = cam:WorldToViewportPoint(targetPos)
        if not onScreen or sp.Z <= 0 then return end
        if (Vector2.new(sp.X, sp.Y) - center).Magnitude > (state.aimbotFOV or 250) then return end
    end

    local desired = CFrame.new(cam.CFrame.Position, targetPos)

    if state.aimbotSnap then
        cam.CFrame = desired
    else
        local smooth = state.aimbotSmooth or 1
        if smooth <= 1 then
            cam.CFrame = desired
        else
            local alpha = math.clamp(1 - math.exp(-30 / math.max(1, smooth)) * dt, 0.15, 1)
            cam.CFrame = cam.CFrame:Lerp(desired, alpha)
        end
    end
end)

