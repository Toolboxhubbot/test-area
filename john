                end
            end)
            UIS.InputEnded:Connect(function(ii)
                if not ds then return end
                if ii~=ds.input then return end
                local st=ds
                ds=nil
                if st.moved and not isIdLocked(d.id) then
                    state.floatButtonPositions[d.id]={
                        xScale=bt.Position.X.Scale,xOffset=bt.Position.X.Offset,
                        yScale=bt.Position.Y.Scale,yOffset=bt.Position.Y.Offset
                    }
