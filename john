-- ============ GAME HELPERS ============
local function targetIsAlive(plr)
    if not plr or not plr.Parent then return false end
    local c = plr.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function isInRound()
    for _, m in ipairs(Workspace:GetChildren()) do
        if m:FindFirstChild("CoinContainer") or m.Name == "CoinContainer" then return true end
    end
    return false
end
local function isLobby() return not isInRound() end
local function getMapName()
    for _, m in ipairs(Workspace:GetChildren()) do
        if m:FindFirstChild("CoinContainer") or m.Name == "CoinContainer" then return m.Name end
    end
    return nil
end

local function alive()
    local c = LP.Character
    return c and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0 and c:FindFirstChild("HumanoidRootPart")
end

local function isWhitelisted(p)
    if not p then return false end
    for _, x in ipairs(settingsConfig.whitelist or {}) do
        if string.lower(x) == string.lower(p.Name) then return true end
    end
    return false
end

local function roleColor(role)
    if role == "Murderer" then return Color3.fromRGB(255, 90, 90)
    elseif role == "Sheriff" then return Color3.fromRGB(90, 170, 255)
    elseif role == "Hero" then return Color3.fromRGB(255, 220, 90)
    else return Color3.fromRGB(120, 255, 140) end
end

local function looksLikeRole(s)
    if type(s) ~= "string" or s == "" then return false end
    local l = string.lower(s)
    return l=="innocent" or l=="innocents" or l=="murderer" or l=="murderers"
        or l=="sheriff" or l=="sheriffs" or l=="hero" or l=="heroes"
end

local cachedRoleModule, cachedRoleModuleAt = nil, 0
local function refreshRoleCache() cachedRoleModule = nil; cachedRoleModuleAt = 0 end

local function getCachedRoleData()
    local now = tick()
    if cachedRoleModule and (now - cachedRoleModuleAt) < 2 then return cachedRoleModule end
    local ok, data = pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        if mods then
            local pd = mods:FindFirstChild("PlayerData") or mods:FindFirstChild("Roles")
                or mods:FindFirstChild("RoleData") or mods:FindFirstChild("RoundData")
            if pd then return require(pd) end
        end
        local direct = ReplicatedStorage:FindFirstChild("PlayerData")
            or ReplicatedStorage:FindFirstChild("Roles")
            or ReplicatedStorage:FindFirstChild("RoleData")
        if direct then return require(direct) end
    end)
    if ok and type(data) == "table" then
        cachedRoleModule = data; cachedRoleModuleAt = now
        return data
    end
    return nil
end

