    elseif cmd == "ungesp" or cmd == "unespgun" then turnOff("espGunDrop","Gun ESP")
    elseif cmd == "unhitbox" then turnOff("hitboxExpander","Hitbox Expander")
    elseif cmd == "unspinbot" then turnOff("spinBot","Spin Bot")
    elseif cmd == "unwallhop" then turnOff("wallHop","Wall Hop")
