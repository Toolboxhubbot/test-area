local function getVoteMapNames()
    local mapNames = {"N/A", "N/A", "N/A"}
    local boards = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("SurfaceGui") then
            local part = obj.Adornee or obj.Parent
            if part and part:IsA("BasePart") then
                local isVotingBoard = false
                local potentialName = nil
                for _, label in ipairs(obj:GetDescendants()) do
                    if label:IsA("TextLabel") and label.Visible then
                        local text = label.Text
                        local lowerText = string.lower(text)
                        if string.match(lowerText, "votes:") then isVotingBoard = true
                        elseif text ~= "" and lowerText ~= "map name" and lowerText ~= "label" and lowerText ~= "0" and lowerText ~= "???" then potentialName = text end
                    end
                end
                if isVotingBoard and potentialName then table.insert(boards, {Name = potentialName, Pos = part.Position}) end
            end
        end
    end
    for i, spotPos in ipairs(VOTE_SPOTS) do
        local closestDist = 45
        local closestName = "N/A"
        for _, board in ipairs(boards) do
            local dist = (board.Pos - spotPos).Magnitude
            if dist < closestDist then closestDist = dist; closestName = board.Name end
        end
        mapNames[i] = closestName
    end
    return mapNames
end

