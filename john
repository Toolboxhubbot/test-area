local function getPlayerRole(plr)
    if not plr or not plr.Parent then return "Innocent" end
    local ch = plr.Character
    local bp = plr:FindFirstChild("Backpack")
    for _, attrName in ipairs({"Role","role","RoleName","roleName","Team","team"}) do
        local a = plr:GetAttribute(attrName)
        if a and tostring(a) ~= "" then return tostring(a) end
    end
    if plr.Team and plr.Team.Name ~= "" then
        local tn = plr.Team.Name
        if tn ~= "Innocents" and tn ~= "Lobby" then return tn end
    end
    if ch then
        for _, attrName in ipairs({"Role","role","RoleName","roleName"}) do
            local a = ch:GetAttribute(attrName)
            if a and tostring(a) ~= "" then return tostring(a) end
        end
        if ch:FindFirstChild("Murderer") or ch:FindFirstChild("IsMurderer") then return "Murderer" end
        if ch:FindFirstChild("Sheriff") or ch:FindFirstChild("IsSheriff") then return "Sheriff" end
        if ch:FindFirstChild("Hero") or ch:FindFirstChild("IsHero") then return "Hero" end
    end
    local rd = getCachedRoleData()
    if rd and type(rd) == "table" then
        local pd = rd[plr.Name] or rd[tostring(plr.UserId)] or rd[plr.UserId]
        if pd then
            if type(pd) == "string" then return pd end
            if type(pd) == "table" then
                local r = pd.Role or pd.role or pd.RoleName or pd.roleName or pd.Team or pd[1]
                if r and tostring(r) ~= "" then return tostring(r) end
            end
        end
    end
    if (ch and ch:FindFirstChild("Knife")) or (bp and bp:FindFirstChild("Knife")) then return "Murderer" end
    if (ch and ch:FindFirstChild("Gun")) or (bp and bp:FindFirstChild("Gun")) then return "Sheriff" end
    return "Innocent"
end

